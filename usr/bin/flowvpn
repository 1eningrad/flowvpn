#!/bin/ash
# FlowVPN v3 — xray (SOCKS/XHTTP) + sing-box (tproxy/routing)
# Modes: all_vpn (everything VPN, RU direct) | blocklist (only blocked through VPN)

FLOWVPN_LIB="/usr/lib/flowvpn"
FLOWVPN_CONFIG="/etc/flowvpn/config.json"
FLOWVPN_TMP="/tmp/flowvpn"

. "$FLOWVPN_LIB/parse.sh"
. "$FLOWVPN_LIB/xray.sh"
. "$FLOWVPN_LIB/singbox.sh"
. "$FLOWVPN_LIB/network.sh"

get_config_val() { jq -r --arg k "$1" --arg d "$2" '.[$k] // $d' "$FLOWVPN_CONFIG"; }
flog() { logger -t flowvpn "$*"; }

# Returns the per-install Clash API secret. Generates one on first call.
# Stored in /etc/flowvpn/clash_secret (chmod 600).
_get_clash_secret() {
    local f=/etc/flowvpn/clash_secret
    if [ ! -s "$f" ]; then
        mkdir -p /etc/flowvpn
        local s=""
        s=$(head -c 16 /dev/urandom 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null)
        [ -z "$s" ] && s=$(awk 'BEGIN{srand();for(i=0;i<32;i++)printf "%x",int(rand()*16)}')
        printf '%s' "$s" > "$f"
        chmod 600 "$f" 2>/dev/null
    fi
    cat "$f"
}
# Atomic config write — validates JSON before overwriting.
# chmod 600 because config.json holds the subscription URL (panel credential).
save_config() {
    local data="$1"
    printf '%s\n' "$data" > "${FLOWVPN_CONFIG}.tmp"
    if jq '.' "${FLOWVPN_CONFIG}.tmp" >/dev/null 2>&1; then
        chmod 600 "${FLOWVPN_CONFIG}.tmp" 2>/dev/null
        mv "${FLOWVPN_CONFIG}.tmp" "$FLOWVPN_CONFIG"
    else
        rm -f "${FLOWVPN_CONFIG}.tmp"
        flog "ERROR: invalid JSON, config not saved"
        return 1
    fi
}

# ============================================================
# Core commands
# ============================================================

# Operation sentinel — set while a user-initiated lifecycle command (start,
# stop, restart, set-server, set-mode) is in flight. Watchdog defers its
# revival check while this is held; otherwise watchdog races with cmd_restart's
# brief stop_xray window and spawns a parallel xray, leading to zombies and
# port-1080 conflicts.
_op_begin() {
    mkdir -p "$FLOWVPN_TMP"
    echo $$ > "$FLOWVPN_TMP/op.in_progress"
}
_op_end() {
    rm -f "$FLOWVPN_TMP/op.in_progress"
}

_ensure_watchdog() {
    # Watchdog handles log rotation, auto-recovery, and auto-failover. It is
    # the only place log rotation runs, so losing it silently lets logs grow
    # unbounded (40k-line floods seen on SevenSky 2026-04-29).
    #
    # Idempotency check is by process scan, not by lock file. The lock-file
    # path turned out to be unreliable: init.d used to spawn its own watchdog
    # in parallel with cmd_start's, racing on the lock and leaving a state
    # where the lock was empty/missing while a watchdog was alive — every
    # subsequent _ensure_watchdog call then spawned a duplicate.
    # `pgrep -f 'flowvpn watchdog'` would match itself — the pgrep process'
    # own cmdline contains the substring it's searching for, so it always
    # returned 0 and we never spawned. Using ps+grep with the classic
    # `[/]` character-class self-exclusion trick: the grep cmdline contains
    # `[/]usr/bin/flowvpn watchdog`, which includes the substring
    # `]usr/bin/...` (no leading `/`), so the regex `/usr/bin/flowvpn watchdog`
    # does not match grep itself. Real watchdog cmdline
    # `/bin/ash /usr/bin/flowvpn watchdog` does match.
    if ps w 2>/dev/null | grep -q '[/]usr/bin/flowvpn watchdog$'; then
        return 0
    fi
    /usr/bin/flowvpn watchdog >/dev/null 2>&1 &
    echo $! > "$FLOWVPN_TMP/watchdog.pid"
}

_rotate_log() {
    # Size-based rotation with copytruncate semantics.
    # Earlier version did `tail > tmp && mv tmp file`. Rename swaps inode —
    # sing-box and xray hold an open fd on the original inode, so the new
    # file is invisible to them; subsequent log lines get written into the
    # now-orphaned, unlinked file (`/proc/PID/fd/1 → file (deleted)`) and
    # never appear in the journal. Effect: UI's log went silent ~1h after
    # the first rotation.
    #
    # Fix: tail-into-temp, then `cat tmp > file` writes through the same
    # file descriptor that the daemons hold — truncate-then-overwrite
    # preserves the inode.
    local max_lines=2000 keep_lines=500
    for logfile in "$FLOWVPN_TMP/singbox.log" "$FLOWVPN_TMP/xray.log"; do
        [ -f "$logfile" ] || continue
        local lines=$(wc -l < "$logfile" 2>/dev/null)
        [ -z "$lines" ] && continue
        if [ "$lines" -gt "$max_lines" ]; then
            local tmp="${logfile}.rot"
            if tail -n "$keep_lines" "$logfile" > "$tmp" 2>/dev/null; then
                cat "$tmp" > "$logfile"  # truncate+write — keeps inode, daemons keep writing
                rm -f "$tmp"
                # Rotation is housekeeping, not an event — silenced because it
                # was 80% of syslog flowvpn output, drowning real switches/errors
                # in the EclipVPN tab of the log viewer.
            fi
        fi
    done
}

cmd_start() {
    if is_xray_running && is_singbox_running; then
        echo '{"error":"already running"}'
        return 1
    fi
    mkdir -p "$FLOWVPN_TMP"
    _op_begin
    trap '_op_end' EXIT INT TERM
    _rotate_log
    _ensure_watchdog

    local sub_url iface mode
    sub_url=$(get_config_val subscription_url "")
    iface=$(get_config_val interface "br-lan")
    mode=$(get_config_val mode "all_vpn")

    # Fail fast and clearly on bad subscription URL — don't burn time on
    # update_subscription's curl timeout to discover an obvious config error.
    if [ -z "$sub_url" ] || [ "$sub_url" = "null" ]; then
        flog "ERROR: subscription_url not configured"
        echo '{"error":"subscription_url not configured — set it in Settings"}'
        return 1
    fi
    case "$sub_url" in
        https://*|http://*) ;;
        *)
            flog "ERROR: subscription_url must start with http:// or https:// (got: ${sub_url%%:*}://...)"
            echo '{"error":"subscription_url must start with http:// or https://"}'
            return 1
            ;;
    esac
    flog "Starting FlowVPN (mode=$mode)"

    # Step 1: Fetch servers
    if [ ! -f "$FLOWVPN_TMP/servers.json" ]; then
        local count
        count=$(update_subscription "$FLOWVPN_CONFIG")
        [ "$count" -gt 0 ] 2>/dev/null || { echo '{"error":"subscription failed"}'; return 1; }
    fi

    # Step 2: Fetch routing rules
    if [ ! -f "$FLOWVPN_TMP/rules/ru_domains.list" ] && [ ! -f "$FLOWVPN_TMP/rules/domains.list" ]; then
        fetch_rules "$mode"
    fi

    local selected
    selected=$(get_config_val selected_server 0)
    local total=$(jq 'length' "$FLOWVPN_TMP/servers.json")
    [ "$selected" -ge "$total" ] && selected=0

    # Step 3: Start xray
    flog "Starting xray (server index=$selected)"
    generate_xray_config "$FLOWVPN_TMP/servers.json" "$selected" "$FLOWVPN_TMP/xray.json"
    start_xray "$FLOWVPN_TMP/xray.json" || { flog "ERROR: xray failed to start"; echo '{"error":"xray failed"}'; return 1; }

    # Step 4: Verify xray
    local vpn_ip
    vpn_ip=$(test_xray)
    if [ -z "$vpn_ip" ]; then
        flog "ERROR: VPN connection test failed"
        local _fail_name=$(jq -r ".[$selected].name // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
        local _fail_host=$(jq -r ".[$selected].host // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
        _log_incident "switch_failed" "$_fail_host" "$_fail_name" "test_xray не прошёл при запуске"
        stop_xray
        echo '{"error":"VPN connection failed"}'
        return 1
    fi
    flog "xray connected, VPN IP: $vpn_ip"

    # Step 5: Start sing-box
    flog "Starting sing-box (mode=$mode)"
    generate_singbox_config "$FLOWVPN_TMP/singbox.json" 1080 "$mode"
    start_singbox "$FLOWVPN_TMP/singbox.json"
    if [ $? -ne 0 ]; then
        flog "ERROR: sing-box failed to start"
        stop_xray
        echo '{"error":"sing-box failed"}'
        return 1
    fi
    flog "sing-box started"

    # Step 6: nftables + DNS (LAST)
    flog "Setting up nftables and DNS redirect"
    setup_network 2154 32768 "$iface"

    date +%s > "$FLOWVPN_TMP/start_time"
    echo "$vpn_ip" > "$FLOWVPN_TMP/vpn_ip"

    # Mark intent: VPN should be running. Watchdog uses this to revive
    # the tunnel if processes get killed externally (OOM, manual pkill,
    # crash). Distinct from auto_start (which is only consulted at boot).
    local cfg_tmp
    cfg_tmp=$(jq '.running_intent = true' "$FLOWVPN_CONFIG")
    save_config "$cfg_tmp"

    local server_name=$(jq -r ".[$selected].name" "$FLOWVPN_TMP/servers.json")
    flog "FlowVPN started: server=$server_name, vpn_ip=$vpn_ip, mode=$mode"
    echo "{\"status\":\"started\",\"server\":\"$server_name\",\"vpn_ip\":\"$vpn_ip\",\"mode\":\"$mode\"}"
}

cmd_stop() {
    _op_begin
    trap '_op_end' EXIT INT TERM
    flog "Stopping FlowVPN"
    # Clear intent first — watchdog runs every 20s and would otherwise
    # see processes-down + intent=true and revive the VPN we just stopped.
    local cfg_tmp
    cfg_tmp=$(jq '.running_intent = false' "$FLOWVPN_CONFIG")
    save_config "$cfg_tmp"
    teardown_network
    stop_singbox
    stop_xray
    rm -f "$FLOWVPN_TMP/start_time" "$FLOWVPN_TMP/vpn_ip"
    flog "FlowVPN stopped"
    echo '{"status":"stopped"}'
}

cmd_restart() {
    _op_begin
    trap '_op_end' EXIT INT TERM
    _ensure_watchdog
    # Soft restart: keeps nftables rules + dnsmasq redirect in place so
    # that during the process-swap gap, traffic fails closed (no internet
    # for clients) instead of leaking direct (~5s of plaintext DNS + traffic).
    # Used by mode change, server switch, watchdog failover, and the UI's
    # "Restart" button. cmd_stop still does the full teardown when the user
    # genuinely wants VPN off.
    if ! is_xray_running && ! is_singbox_running; then
        # cmd_start has its own _op_begin — clear ours first to avoid
        # the trap clearing the sentinel mid-operation.
        _op_end
        trap - EXIT INT TERM
        cmd_start
        return $?
    fi

    local selected mode
    selected=$(get_config_val selected_server 0)
    mode=$(get_config_val mode "all_vpn")
    local total
    total=$(jq 'length' "$FLOWVPN_TMP/servers.json" 2>/dev/null)
    [ -n "$total" ] && [ "$selected" -ge "$total" ] && selected=0

    # No-op fast path: if the freshly-generated configs are identical to what's
    # already running, don't tear processes down. Saves the 5s gap when the UI
    # fires restart for a setting that doesn't actually affect xray/sing-box.
    local new_xray="$FLOWVPN_TMP/xray.new.json"
    local new_singbox="$FLOWVPN_TMP/singbox.new.json"
    generate_xray_config "$FLOWVPN_TMP/servers.json" "$selected" "$new_xray" 2>/dev/null
    generate_singbox_config "$new_singbox" 1080 "$mode" 2>/dev/null
    if [ -s "$new_xray" ] && [ -s "$new_singbox" ] && \
       cmp -s "$new_xray" "$FLOWVPN_TMP/xray.json" && \
       cmp -s "$new_singbox" "$FLOWVPN_TMP/singbox.json"; then
        rm -f "$new_xray" "$new_singbox"
        # Configs are identical, but is the tunnel actually carrying traffic?
        # If xray hung (process alive, socket dead), watchdog would fix it
        # in 40s, but the user clicking Restart expects an immediate kick.
        # Quick health probe — 4s timeout — falls through to real restart on miss.
        if [ -z "$(test_xray)" ]; then
            flog "Restart: configs unchanged but tunnel is dead — forcing restart"
            # fallthrough to the real restart below
        else
            local sn vi
            sn=$(jq -r --argjson i "$selected" '.[$i].name // ""' "$FLOWVPN_TMP/servers.json")
            vi=$(cat "$FLOWVPN_TMP/vpn_ip" 2>/dev/null)
            # Explicit cleanup before fast-path return. The EXIT trap will
            # eventually fire on script exit, but in ash the timing of
            # function-set traps relative to early returns is fuzzy enough
            # that the watchdog's stale-marker reaper has occasionally
            # raced this. Cheap to be explicit.
            _op_end
            trap - EXIT INT TERM
            echo "{\"status\":\"unchanged\",\"server\":\"$sn\",\"vpn_ip\":\"$vi\",\"mode\":\"$mode\"}"
            return 0
        fi
    fi
    rm -f "$new_xray" "$new_singbox"

    flog "Restarting FlowVPN (soft — network rules preserved)"
    stop_singbox
    stop_xray
    sleep 1

    flog "Starting xray (server index=$selected)"
    generate_xray_config "$FLOWVPN_TMP/servers.json" "$selected" "$FLOWVPN_TMP/xray.json"
    start_xray "$FLOWVPN_TMP/xray.json" || { flog "ERROR: xray failed to start"; echo '{"error":"xray failed"}'; return 1; }

    local vpn_ip
    vpn_ip=$(test_xray)
    if [ -z "$vpn_ip" ]; then
        flog "ERROR: VPN connection test failed after restart"
        local _fail_name=$(jq -r ".[$selected].name // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
        local _fail_host=$(jq -r ".[$selected].host // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
        _log_incident "switch_failed" "$_fail_host" "$_fail_name" "test_xray не прошёл при переключении"
        stop_xray
        echo '{"error":"VPN connection failed"}'
        return 1
    fi
    flog "xray reconnected, VPN IP: $vpn_ip"

    generate_singbox_config "$FLOWVPN_TMP/singbox.json" 1080 "$mode"
    start_singbox "$FLOWVPN_TMP/singbox.json" || { flog "ERROR: sing-box failed"; stop_xray; echo '{"error":"sing-box failed"}'; return 1; }
    flog "sing-box restarted"

    date +%s > "$FLOWVPN_TMP/start_time"
    echo "$vpn_ip" > "$FLOWVPN_TMP/vpn_ip"

    # Restart implies user wants VPN running — keep intent flag in sync.
    # Without this a soft restart (UI button, set-server, set-mode, watchdog
    # failover) wouldn't carry the intent, and an external kill afterwards
    # wouldn't trigger auto-recovery.
    local cfg_tmp
    cfg_tmp=$(jq '.running_intent = true' "$FLOWVPN_CONFIG")
    save_config "$cfg_tmp"

    local server_name=$(jq -r --argjson i "$selected" '.[$i].name // ""' "$FLOWVPN_TMP/servers.json")
    flog "FlowVPN restarted: server=$server_name, vpn_ip=$vpn_ip, mode=$mode"
    echo "{\"status\":\"restarted\",\"server\":\"$server_name\",\"vpn_ip\":\"$vpn_ip\",\"mode\":\"$mode\"}"
}

cmd_status() {
    # Polled from UI every 5s — kept cheap.
    # Single jq pass: --slurpfile reads config + servers.json once each,
    # everything else (running, vpn_ip, uptime, etc.) comes via --argjson/--arg.
    local running="false" uptime=0 vpn_ip=""
    if is_xray_running && is_singbox_running; then
        running="true"
        [ -f "$FLOWVPN_TMP/start_time" ] && {
            local st=$(cat "$FLOWVPN_TMP/start_time")
            uptime=$(($(date +%s) - st))
        }
        [ -f "$FLOWVPN_TMP/vpn_ip" ] && vpn_ip=$(cat "$FLOWVPN_TMP/vpn_ip")
    fi

    local servers_raw='[]'
    [ -f "$FLOWVPN_TMP/servers.json" ] && servers_raw=$(cat "$FLOWVPN_TMP/servers.json")

    local device_count=0
    [ -f /tmp/dhcp.leases ] && device_count=$(wc -l < /tmp/dhcp.leases)

    # Read meta-files via jq so a corrupt/half-written file (truncated by
    # power loss on /tmp) doesn't make --argjson choke and break the whole
    # status response.
    local last_switch='null'
    [ -f "$FLOWVPN_TMP/last_switch.json" ] && \
        last_switch=$(jq '.' "$FLOWVPN_TMP/last_switch.json" 2>/dev/null || echo null)
    local last_update='null'
    [ -f "$FLOWVPN_TMP/last_update.json" ] && \
        last_update=$(jq '.' "$FLOWVPN_TMP/last_update.json" 2>/dev/null || echo null)
    local sub_meta='null'
    [ -f "$FLOWVPN_TMP/subscription_meta.json" ] && \
        sub_meta=$(jq '.' "$FLOWVPN_TMP/subscription_meta.json" 2>/dev/null || echo null)

    jq -n \
        --slurpfile cfg "$FLOWVPN_CONFIG" \
        --argjson running "$running" \
        --argjson uptime "$uptime" \
        --argjson srv "$servers_raw" \
        --arg vpn_ip "$vpn_ip" \
        --argjson devices "$device_count" \
        --argjson last_switch "$last_switch" \
        --argjson last_update "$last_update" \
        --argjson sub_meta "$sub_meta" \
        --arg clash_secret "$(_get_clash_secret)" \
        '$cfg[0] as $c |
         ($c.selected_server // 0) as $sel |
         {running:$running,
          server: (if $running then ($srv[$sel].name // "") else "" end),
          uptime:$uptime,
          selected: $sel,
          servers: ($srv | map({name, host, port})),
          subscription_url: ($c.subscription_url // ""),
          vpn_ip:$vpn_ip,
          mode: ($c.mode // "all_vpn"),
          devices:$devices,
          auto_start: ($c.auto_start // true),
          auto_mode: ($c.auto_mode // false),
          running_intent: ($c.running_intent // false),
          device_rules: ($c.device_rules // {}),
          last_switch:$last_switch,
          last_update:$last_update,
          subscription_meta:$sub_meta,
          clash_secret:$clash_secret}'
}

# ============================================================
# Server management
# ============================================================

cmd_set_server() {
    local idx="$1"
    [ -z "$idx" ] && { echo '{"error":"missing index"}'; return 1; }
    flog "Setting server to index $idx"
    [ -f "$FLOWVPN_TMP/servers.json" ] || { echo '{"error":"no servers"}'; return 1; }
    local total=$(jq 'length' "$FLOWVPN_TMP/servers.json")
    [ "$idx" -ge "$total" ] 2>/dev/null && { echo '{"error":"invalid index"}'; return 1; }
    local tmp=$(jq --argjson idx "$idx" '.selected_server = $idx' "$FLOWVPN_CONFIG")
    save_config "$tmp"
    is_xray_running && cmd_restart || {
        local name=$(jq -r ".[$idx].name" "$FLOWVPN_TMP/servers.json")
        echo "{\"status\":\"server set\",\"server\":\"$name\"}"
    }
}

# Pre-flight: spin up a temp xray bound to an unused port and verify the
# target server actually answers, before we tear down the running VPN.
# Returns: {"status":"ok","ip":"...","latency_ms":N} on success
#          {"error":"..."} on failure (production xray/sing-box untouched)
cmd_probe_server() {
    local idx="$1"
    [ -z "$idx" ] && { echo '{"error":"missing index"}'; return 1; }
    [ -f "$FLOWVPN_TMP/servers.json" ] || { echo '{"error":"no servers"}'; return 1; }
    local total
    total=$(jq 'length' "$FLOWVPN_TMP/servers.json")
    [ "$idx" -ge "$total" ] 2>/dev/null && { echo '{"error":"invalid index"}'; return 1; }
    [ -x /usr/bin/xray ] || { echo '{"error":"xray binary missing"}'; return 1; }
    mkdir -p "$FLOWVPN_TMP"

    # Run the actual probe in a subshell. In ash `trap EXIT` is process-wide,
    # not function-scoped — running this body as a function inside e.g. the
    # watchdog process would clobber the watchdog's own EXIT trap (which
    # cleans up watchdog.lock). Subshell isolates the trap to the probe.
    (
        # Unique filenames so a probe and a concurrent watchdog failover
        # don't overwrite each other's xray configs. Need a .json suffix
        # because xray sniffs format from filename (refuses files without).
        # busybox mktemp doesn't accept a suffix in the template, so:
        # mktemp → rename.
        local _t _p test_cfg probe_cfg
        _t=$(mktemp "$FLOWVPN_TMP/xray_test.XXXXXX") || exit 1
        _p=$(mktemp "$FLOWVPN_TMP/xray_probe.XXXXXX") || { rm -f "$_t"; exit 1; }
        test_cfg="${_t}.json"; probe_cfg="${_p}.json"
        mv "$_t" "$test_cfg"; mv "$_p" "$probe_cfg"
        local probe_pid=""
        trap 'kill $probe_pid 2>/dev/null; wait $probe_pid 2>/dev/null; rm -f "$test_cfg" "$probe_cfg"' EXIT INT TERM

        local probe_port=$((1082 + $$ % 100))
        generate_xray_config "$FLOWVPN_TMP/servers.json" "$idx" "$test_cfg"
        [ -s "$test_cfg" ] || { echo '{"error":"failed to generate xray config"}'; exit 1; }
        jq --argjson p "$probe_port" \
            '.inbounds=[{tag:"t",port:$p,listen:"127.0.0.1",protocol:"socks",settings:{auth:"noauth"}}]' \
            "$test_cfg" > "$probe_cfg"

        # Up to 3 spawn-and-test attempts. A freshly-spawned xray's very
        # first request through VLESS+XHTTP+Reality occasionally hangs to
        # full timeout (measured ~50% on DE/NL endpoints when probing while
        # prod xray is connected to a different server — likely cold xmux
        # state on the remote). Once a probe xray hits this, retrying *its*
        # curl doesn't recover; only respawning xray does. The user-visible
        # symptom was "не получается переключиться с первого раза" — the
        # picker click triggered a flaky probe, toast said "Не удалось
        # переключить", and the immediate second click succeeded.
        # 3 attempts at ~7s worst-case each = ≤21s budget; an outright dead
        # server is detected on attempt 1 because curl returns immediately
        # (port unreachable) — this loop only burns time on flakes.
        local t0 t1 elapsed test_ip="" attempt
        t0=$(date +%s%3N 2>/dev/null)
        for attempt in 1 2 3; do
            # Spawn a fresh xray for each attempt — reusing a hung instance
            # doesn't help (its outbound state is broken).
            [ -n "$probe_pid" ] && {
                kill "$probe_pid" 2>/dev/null
                wait "$probe_pid" 2>/dev/null
                probe_pid=""
            }
            /usr/bin/xray run -config "$probe_cfg" >/dev/null 2>&1 &
            probe_pid=$!

            # Wait for the SOCKS inbound to actually listen before curl-ing.
            # busybox sleep doesn't accept fractional seconds, so this is
            # 1s granularity, capped at 6s.
            local ready=0 wait_i=0
            while [ "$wait_i" -lt 6 ]; do
                kill -0 "$probe_pid" 2>/dev/null || break
                if netstat -tlnp 2>/dev/null | grep -q ":$probe_port "; then
                    ready=1
                    break
                fi
                sleep 1
                wait_i=$((wait_i + 1))
            done
            [ "$ready" -eq 0 ] && continue

            test_ip=$(curl -s --socks5-hostname "127.0.0.1:$probe_port" --max-time 6 https://api.ipify.org 2>/dev/null)
            [ -n "$test_ip" ] && break
        done
        t1=$(date +%s%3N 2>/dev/null)
        # Fallback: if busybox date doesn't support %3N, both are non-numeric.
        case "$t0$t1" in *[!0-9]*) elapsed=0;; *) elapsed=$((t1 - t0));; esac
        [ "$elapsed" -lt 0 ] 2>/dev/null && elapsed=0

        if [ -n "$test_ip" ]; then
            local name
            name=$(jq -r --argjson i "$idx" '.[$i].name // ""' "$FLOWVPN_TMP/servers.json")
            jq -n --arg ip "$test_ip" --arg name "$name" --argjson ms "$elapsed" \
                '{status:"ok", ip:$ip, server:$name, latency_ms:$ms}'
            exit 0
        else
            echo '{"error":"server unreachable"}'
            exit 1
        fi
    )
}

cmd_update() {
    # Capture previous server count so the UI can detect whether this run
    # actually changed anything (cron auto-update fires every N hours and
    # most of the time returns the same list — we don't want to spam toasts).
    local prev=0
    [ -f "$FLOWVPN_TMP/servers.json" ] && prev=$(jq 'length' "$FLOWVPN_TMP/servers.json" 2>/dev/null)
    [ -z "$prev" ] && prev=0

    local count
    count=$(update_subscription "$FLOWVPN_CONFIG")
    local mode=$(get_config_val mode "all_vpn")
    rm -rf "$FLOWVPN_TMP/rules"
    fetch_rules "$mode"
    if [ "$count" -gt 0 ] 2>/dev/null; then
        # Record the run for the UI's status polling — last_update lets the
        # frontend show a toast only when prev != count (avoids "updated:
        # same 7 servers" noise on cron-driven refresh).
        jq -n --argjson t "$(date +%s)" --argjson c "$count" --argjson p "$prev" \
            '{time:$t, count:$c, prev_count:$p}' > "$FLOWVPN_TMP/last_update.json"
        echo "{\"status\":\"updated\",\"servers\":$count,\"prev\":$prev}"
        is_xray_running && cmd_restart >/dev/null
    else
        echo '{"error":"update failed"}'
        return 1
    fi
}

cmd_ping() {
    [ -f "$FLOWVPN_TMP/servers.json" ] || { echo '{"error":"no servers"}'; return 1; }
    local total=$(jq 'length' "$FLOWVPN_TMP/servers.json")
    local tmpdir=$(mktemp -d "$FLOWVPN_TMP/ping.XXXXXX")

    # Per-server probe runs in parallel. Strategy lifted from v2rayN/v2rayNG
    # tcping: 3 attempts × 3s TCP-connect, take the minimum. Empirically
    # observed ~20% TCP-RST flap on one upstream (Finland) — 2×2s gave 4%
    # false-negatives, 3×3s drops that below 1%.
    #
    # ICMP fallback when all 3 TCP attempts fail: many providers RST :443
    # bursts but ICMP keeps flowing, so we still surface a usable number
    # instead of "нет" for a server that's actually reachable.
    local i=0
    while [ "$i" -lt "$total" ]; do
        local host=$(jq -r ".[$i].host" "$FLOWVPN_TMP/servers.json")
        local out="$tmpdir/$i"
        (
            best=-1
            for attempt in 1 2 3; do
                t=$(curl -s -o /dev/null --max-time 3 --connect-timeout 3 -w '%{time_connect}' "https://$host:443" 2>/dev/null)
                if [ -n "$t" ] && [ "$t" != "0.000000" ]; then
                    ms=$(echo "$t" | awk '{printf "%d", $1 * 1000}')
                    if [ "$best" -lt 0 ] || [ "$ms" -lt "$best" ]; then best=$ms; fi
                fi
            done
            if [ "$best" -lt 0 ]; then
                # ICMP fallback — single packet, 2s deadline.
                icmp=$(ping -c 1 -W 2 "$host" 2>/dev/null | awk -F'time=' '/time=/{split($2,a," "); print int(a[1]+0.5); exit}')
                [ -n "$icmp" ] && [ "$icmp" -gt 0 ] 2>/dev/null && best=$icmp
            fi
            echo "$best" > "$out"
        ) &
        i=$((i + 1))
    done
    wait

    local results="[]"
    i=0
    while [ "$i" -lt "$total" ]; do
        local name=$(jq -r ".[$i].name" "$FLOWVPN_TMP/servers.json")
        local ms=$(cat "$tmpdir/$i" 2>/dev/null)
        [ -z "$ms" ] && ms=-1
        results=$(echo "$results" | jq --arg n "$name" --argjson ms "$ms" --argjson i "$i" '. + [{name:$n, ping:$ms, index:$i}]')
        i=$((i + 1))
    done
    rm -rf "$tmpdir"
    echo "$results" | jq '.'
}

# Find the lowest-RTT non-metered server and switch to it. Used by the
# "Auto" button — picks a sensible default for the user without making
# them squint at numbers. Skips metered (МТС/Т2/etc) since they hand back
# Russian IPs and would defeat the VPN.
#
# Two-stage selection: TCP RTT to filter candidates fast, then real VLESS
# probe on the winner. Without the probe, we'd happily pick a server whose
# port answers TCP but whose Reality keys have rotated — UI would say
# "switched" while VPN is broken. With it, we either confirm the switch
# really worked or report failure honestly.
# Helper to append an attempt entry to the running list. Used purely to
# keep the auto_select function readable.
_attempt_add() {
    # $1 = jq array string, $2 = name, $3 = idx, $4 = rtt (or -1), $5 = status
    echo "$1" | jq --arg n "$2" --argjson i "$3" --argjson ms "$4" --arg s "$5" \
        '. + [{name:$n, index:$i, rtt_ms:(if $ms < 0 then null else $ms end), status:$s}]'
}

cmd_auto_select() {
    [ -f "$FLOWVPN_TMP/servers.json" ] || { echo '{"error":"no servers"}'; return 1; }
    local total i=0 name host ms
    total=$(jq 'length' "$FLOWVPN_TMP/servers.json")

    # attempts collects an ordered audit trail of every server we considered:
    # what status (skipped_metered / unreachable / probe_failed / selected /
    # already_active) and its RTT. This is what powers the "why X and not Y"
    # explanation in the UI toast.
    local attempts="[]"
    local candidates=""
    while [ "$i" -lt "$total" ]; do
        name=$(jq -r ".[$i].name" "$FLOWVPN_TMP/servers.json")
        host=$(jq -r ".[$i].host" "$FLOWVPN_TMP/servers.json")
        if _is_metered_server "$name"; then
            attempts=$(_attempt_add "$attempts" "$name" "$i" -1 "skipped_metered")
        else
            ms=$(curl -s -o /dev/null --max-time 3 --connect-timeout 3 -w '%{time_connect}' "https://$host:443" 2>/dev/null)
            [ -n "$ms" ] && [ "$ms" != "0.000000" ] && ms=$(echo "$ms" | awk '{printf "%d", $1 * 1000}') || ms=-1
            if [ "$ms" -gt 0 ] 2>/dev/null; then
                candidates="$candidates$ms $i\n"
            else
                attempts=$(_attempt_add "$attempts" "$name" "$i" -1 "unreachable")
            fi
        fi
        i=$((i + 1))
    done

    if [ -z "$candidates" ]; then
        jq -n --argjson att "$attempts" '{error:"no reachable servers", attempts:$att}'
        return 1
    fi
    local sorted
    sorted=$(printf '%b' "$candidates" | sort -n)

    local cur best_idx best_ms best_name
    cur=$(get_config_val selected_server 0)

    while IFS=' ' read -r ms idx; do
        [ -z "$idx" ] && continue
        name=$(jq -r --argjson i "$idx" '.[$i].name' "$FLOWVPN_TMP/servers.json")
        if [ "$idx" = "$cur" ] && is_xray_running && [ -n "$(test_xray)" ]; then
            attempts=$(_attempt_add "$attempts" "$name" "$idx" "$ms" "already_active")
            jq -n --arg n "$name" --argjson i "$idx" --argjson ms "$ms" --argjson att "$attempts" \
                '{status:"ok", server:$n, index:$i, rtt_ms:$ms, switched:false, attempts:$att}'
            return 0
        fi
        flog "Auto-select: probing $name (idx=$idx rtt=${ms}ms)"
        local probe
        probe=$(cmd_probe_server "$idx" 2>/dev/null)
        if echo "$probe" | jq -e '.status == "ok"' >/dev/null 2>&1; then
            attempts=$(_attempt_add "$attempts" "$name" "$idx" "$ms" "selected")
            best_idx="$idx"; best_ms="$ms"; best_name="$name"
            break
        fi
        attempts=$(_attempt_add "$attempts" "$name" "$idx" "$ms" "probe_failed")
        flog "Auto-select: $name failed VLESS probe — trying next"
    done <<EOF
$sorted
EOF

    if [ -z "$best_idx" ]; then
        jq -n --argjson att "$attempts" '{error:"no working servers (all failed VLESS probe)", attempts:$att}'
        return 1
    fi

    flog "Auto-select: chose $best_name idx=$best_idx rtt=${best_ms}ms"
    if [ "$cur" = "$best_idx" ]; then
        jq -n --arg n "$best_name" --argjson i "$best_idx" --argjson ms "$best_ms" --argjson att "$attempts" \
            '{status:"ok", server:$n, index:$i, rtt_ms:$ms, switched:false, attempts:$att}'
        return 0
    fi

    # Whole switch + state stamp under one op-lock — prevents watchdog
    # auto_eval racing on config and auto_state. Subshell exit code:
    # 0 = ok, 1 = lock contention, 2 = cmd_restart failure (rolled back).
    mkdir -p "$FLOWVPN_TMP"
    local sf="$FLOWVPN_TMP/auto_state.json"
    local oplock="$FLOWVPN_TMP/auto.lock"
    (
        flock -w 5 -x 200 || exit 1
        local tmp
        tmp=$(jq --argjson idx "$best_idx" '.selected_server = $idx' "$FLOWVPN_CONFIG")
        save_config "$tmp"
        if is_xray_running; then
            if ! cmd_restart >/dev/null 2>&1; then
                tmp=$(jq --argjson idx "$cur" '.selected_server = $idx' "$FLOWVPN_CONFIG")
                save_config "$tmp"
                cmd_restart >/dev/null 2>&1
                exit 2
            fi
        fi
        [ -f "$sf" ] || printf '%s\n' '{"last_eval":0,"last_switch":0}' > "$sf"
        local now=$(date +%s)
        jq --argjson t "$now" '.last_eval = $t | .last_switch = $t' "$sf" > "${sf}.tmp" && mv "${sf}.tmp" "$sf"
    ) 200>"$oplock"
    local rc=$?
    case "$rc" in
        0) ;;
        1)
            jq -n --arg n "$best_name" --argjson att "$attempts" '{error:"another auto operation in progress", server:$n, attempts:$att}'
            return 1
            ;;
        2)
            flog "Auto-select: restart failed — rolled back to idx=$cur"
            jq -n --arg n "$best_name" --argjson att "$attempts" '{error:"restart failed", server:$n, attempts:$att}'
            return 1
            ;;
        *)
            jq -n --arg n "$best_name" --argjson att "$attempts" '{error:"unexpected", server:$n, attempts:$att}'
            return 1
            ;;
    esac

    jq -n --arg n "$best_name" --argjson i "$best_idx" --argjson ms "$best_ms" --argjson att "$attempts" \
        '{status:"ok", server:$n, index:$i, rtt_ms:$ms, switched:true, attempts:$att}'
}

# Periodic re-evaluation invoked by the watchdog. Honours hysteresis so we
# don't bounce between similar-RTT servers, and a cooldown so even when
# improvements appear we don't switch more than once per hour (unless the
# current tunnel is actually broken — then any working candidate is fine).
cmd_auto_eval() {
    [ -f "$FLOWVPN_TMP/servers.json" ] || return 1
    is_xray_running || return 0   # not running → not our job, watchdog handles

    mkdir -p "$FLOWVPN_TMP"
    local sf="$FLOWVPN_TMP/auto_state.json"
    local oplock="$FLOWVPN_TMP/auto.lock"

    # Whole eval runs under an op-level flock. -n (non-blocking) — if a
    # user-triggered cmd_auto_select is running, we silently skip this tick
    # rather than queue up a redundant eval behind it.
    (
        flock -n -x 200 || { flog "Auto-eval: another auto op in progress, skipping"; exit 0; }

        [ -f "$sf" ] || printf '%s\n' '{"last_eval":0,"last_switch":0}' > "$sf"

        local now last_eval last_switch
        now=$(date +%s)
        last_eval=$(jq -r '.last_eval // 0' "$sf")
        last_switch=$(jq -r '.last_switch // 0' "$sf")

        # Self-rate-limit: at most once per 20 min, even if watchdog calls more often.
        [ $((now - last_eval)) -lt 1200 ] && exit 0

        # Update last_eval up-front so a hung eval doesn't hold off the next one
        # forever; we'll write it again at the very end too.
        jq --argjson t "$now" '.last_eval = $t' "$sf" > "${sf}.tmp" && mv "${sf}.tmp" "$sf"

        # Is the current tunnel actually carrying traffic? (test_xray returns the
        # exit IP via the running socks; empty = dead tunnel.)
        local current_broken=0
        [ -z "$(test_xray)" ] && current_broken=1

        # Cooldown: if current is fine and we switched < 1h ago, do nothing.
        if [ "$current_broken" -eq 0 ] && [ $((now - last_switch)) -lt 3600 ]; then
            exit 0
        fi

        # Measure RTT for all non-metered servers; remember current's RTT for hysteresis.
        local total i=0 name host ms current_idx current_rtt=-1 candidates=""
        total=$(jq 'length' "$FLOWVPN_TMP/servers.json")
        current_idx=$(get_config_val selected_server 0)
        # Bounds-check: subscription may have shrunk while we were on a higher
        # index. Treat that as broken so we move to a real server.
        if [ "$current_idx" -ge "$total" ] 2>/dev/null; then
            flog "Auto-mode: current_idx=$current_idx out of range (total=$total) — treating as broken"
            current_broken=1
            current_idx=0
        fi
        while [ "$i" -lt "$total" ]; do
            name=$(jq -r ".[$i].name" "$FLOWVPN_TMP/servers.json")
            host=$(jq -r ".[$i].host" "$FLOWVPN_TMP/servers.json")
            if ! _is_metered_server "$name"; then
                ms=$(curl -s -o /dev/null --max-time 3 --connect-timeout 3 -w '%{time_connect}' "https://$host:443" 2>/dev/null)
                [ -n "$ms" ] && [ "$ms" != "0.000000" ] && ms=$(echo "$ms" | awk '{printf "%d", $1 * 1000}') || ms=-1
                if [ "$ms" -gt 0 ] 2>/dev/null; then
                    candidates="$candidates$ms $i\n"
                    [ "$i" = "$current_idx" ] && current_rtt="$ms"
                fi
            fi
            i=$((i + 1))
        done
        [ -z "$candidates" ] && exit 0

        local best_line best_rtt best_idx
        best_line=$(printf '%b' "$candidates" | sort -n | head -1)
        best_rtt=$(echo "$best_line" | awk '{print $1}')
        best_idx=$(echo "$best_line" | awk '{print $2}')

        [ "$best_idx" = "$current_idx" ] && exit 0   # already on best by RTT

        # Hysteresis. Three branches:
        #   - tunnel dead (test_xray empty)        → switch to anything working
        #   - current TCP unreachable but VPN ok   → switch to anything reachable
        #     (don't strand on a host we can't even reach by TCP)
        #   - both RTTs known                      → 30% OR 50ms improvement
        local should_switch=0
        if [ "$current_broken" -eq 1 ]; then
            should_switch=1
            flog "Auto-mode: current tunnel dead, looking for any working server"
        elif [ "$current_rtt" -le 0 ] && [ "$best_rtt" -gt 0 ]; then
            should_switch=1
            flog "Auto-mode: current TCP unreachable, switching to best reachable ($best_rtt ms)"
        elif [ "$current_rtt" -gt 0 ] && [ "$best_rtt" -gt 0 ]; then
            local rel=$((current_rtt * 7 / 10))     # 30% lower
            local abs=$((current_rtt - 50))         # 50ms lower
            if [ "$best_rtt" -lt "$rel" ] || [ "$best_rtt" -lt "$abs" ]; then
                should_switch=1
                flog "Auto-mode: $current_rtt ms → $best_rtt ms — switching"
            fi
        fi

        [ "$should_switch" -eq 0 ] && exit 0

        # Real VLESS probe before committing
        local probe
        probe=$(cmd_probe_server "$best_idx" 2>/dev/null)
        if ! echo "$probe" | jq -e '.status == "ok"' >/dev/null 2>&1; then
            flog "Auto-mode: best candidate failed VLESS probe — staying"
            exit 0
        fi

        # Commit + restart, with rollback on failure
        local tmp
        tmp=$(jq --argjson idx "$best_idx" '.selected_server = $idx' "$FLOWVPN_CONFIG")
        save_config "$tmp"
        if cmd_restart >/dev/null 2>&1; then
            _record_switch "$current_idx" "$best_idx" "auto"
            jq --argjson t "$now" '.last_switch = $t' "$sf" > "${sf}.tmp" && mv "${sf}.tmp" "$sf"
            local bn
            bn=$(jq -r --argjson i "$best_idx" '.[$i].name' "$FLOWVPN_TMP/servers.json")
            flog "Auto-mode: switched to $bn"
        else
            tmp=$(jq --argjson idx "$current_idx" '.selected_server = $idx' "$FLOWVPN_CONFIG")
            save_config "$tmp"
            cmd_restart >/dev/null 2>&1
            flog "Auto-mode: restart failed, rolled back"
        fi
    ) 200>"$oplock"
}

# ============================================================
# Mode & domain management
# ============================================================

cmd_set_mode() {
    local new_mode="$1"
    case "$new_mode" in
        all_vpn|blocklist) ;;
        *) echo '{"error":"invalid mode, use all_vpn or blocklist"}'; return 1 ;;
    esac
    flog "Switching mode to $new_mode"
    local tmp=$(jq --arg m "$new_mode" '.mode = $m' "$FLOWVPN_CONFIG")
    save_config "$tmp"
    rm -rf "$FLOWVPN_TMP/rules" "$FLOWVPN_TMP/singbox.json"
    is_xray_running && cmd_restart || echo "{\"status\":\"mode set\",\"mode\":\"$new_mode\"}"
}

cmd_add_domain() {
    local domain="$1" list="$2"
    [ -z "$domain" ] && { echo '{"error":"missing domain"}'; return 1; }
    local file
    case "$list" in
        direct) file="$CUSTOM_DIRECT" ;;
        vpn)    file="$CUSTOM_VPN" ;;
        *)      echo '{"error":"invalid list, use direct or vpn"}'; return 1 ;;
    esac
    mkdir -p /etc/flowvpn
    grep -qxF "$domain" "$file" 2>/dev/null || echo "$domain" >> "$file"
    # For 'direct' adds in all_vpn mode, the actual routing comes from
    # ru_domains.list which _fetch_ru_domains rebuilds locally (no network).
    # Same dance for 'vpn' adds — vpn_domains.list is the merged source.
    # Without these, the new domain sits in {direct,vpn}_domains.txt but
    # sing-box never sees it until next full update.
    [ "$list" = "direct" ] && _fetch_ru_domains 2>/dev/null
    [ "$list" = "vpn" ] && _fetch_vpn_domains 2>/dev/null
    echo "{\"status\":\"added\",\"domain\":\"$domain\",\"list\":\"$list\"}"
}

cmd_remove_domain() {
    local domain="$1" list="$2"
    [ -z "$domain" ] && { echo '{"error":"missing domain"}'; return 1; }
    local file
    case "$list" in
        direct) file="$CUSTOM_DIRECT" ;;
        vpn)    file="$CUSTOM_VPN" ;;
        *)      echo '{"error":"invalid list"}'; return 1 ;;
    esac
    [ -f "$file" ] && { grep -vxF "$domain" "$file" > "${file}.tmp"; mv "${file}.tmp" "$file"; }
    [ "$list" = "direct" ] && _fetch_ru_domains 2>/dev/null
    [ "$list" = "vpn" ] && _fetch_vpn_domains 2>/dev/null
    echo "{\"status\":\"removed\",\"domain\":\"$domain\",\"list\":\"$list\"}"
}

cmd_get_domains() {
    local direct_domains="[]" vpn_domains="[]" ru_builtin="[]" vpn_builtin="[]"
    [ -f "$CUSTOM_DIRECT" ] && direct_domains=$(jq -R -s 'split("\n") | map(select(length > 0 and (startswith("#") | not)))' "$CUSTOM_DIRECT")
    [ -f "$CUSTOM_VPN" ] && vpn_domains=$(jq -R -s 'split("\n") | map(select(length > 0 and (startswith("#") | not)))' "$CUSTOM_VPN")

    # Built-in lists = entries in {ru,vpn}_domains.list minus the user's
    # custom additions (those are appended last by _fetch_*_domains).
    local ru_count=0 blocked_count=0
    if [ -f "$SR_RULES_DIR/ru_domains.list" ]; then
        ru_count=$(grep -c "^DOMAIN" "$SR_RULES_DIR/ru_domains.list" 2>/dev/null)
        ru_builtin=$(awk -F, '/^DOMAIN-SUFFIX,/ {print $2}' "$SR_RULES_DIR/ru_domains.list" \
            | jq -R -s --argjson custom "$direct_domains" \
                'split("\n") | map(select(length > 0)) | . - $custom')
    fi
    if [ -f "$SR_RULES_DIR/vpn_domains.list" ]; then
        vpn_builtin=$(grep -vE '^(#|$)' "$SR_RULES_DIR/vpn_domains.list" \
            | jq -R -s --argjson custom "$vpn_domains" \
                'split("\n") | map(select(length > 0)) | . - $custom')
    fi
    [ -f "$SR_RULES_DIR/domains.list" ] && blocked_count=$(grep -c "^DOMAIN" "$SR_RULES_DIR/domains.list" 2>/dev/null)

    jq -n --argjson direct "$direct_domains" --argjson vpn "$vpn_domains" \
        --argjson ru_builtin "$ru_builtin" --argjson vpn_builtin "$vpn_builtin" \
        --argjson ru_count "$ru_count" --argjson blocked_count "$blocked_count" \
        '{custom_direct:$direct, custom_vpn:$vpn,
          ru_domains_builtin:$ru_builtin, vpn_domains_builtin:$vpn_builtin,
          ru_domains_count:$ru_count, blocked_domains_count:$blocked_count}'
}

# ============================================================
# Info commands
# ============================================================

cmd_get_devices() {
    local devices="[]"
    if [ -f /tmp/dhcp.leases ]; then
        while read -r ts mac ip name id; do
            devices=$(echo "$devices" | jq --arg ip "$ip" --arg mac "$mac" --arg name "$name" \
                '. + [{ip:$ip, mac:$mac, name:$name}]')
        done < /tmp/dhcp.leases
    fi
    echo "$devices" | jq '.'
}

cmd_get_log() {
    local lines="${1:-100}" filter="${2:-all}"
    if [ ! -f "$FLOWVPN_TMP/singbox.log" ]; then
        echo "[]"
        return
    fi

    local grep_filter=""
    case "$filter" in
        vpn)    grep_filter="outbound/socks" ;;
        direct) grep_filter="outbound/direct" ;;
        error)  grep_filter="ERROR" ;;
        dns)    grep_filter="dns:.*exchanged" ;;
        *)      grep_filter="outbound/\|ERROR\|dns:.*exchanged" ;;
    esac

    # Background-noise pattern shared with healthcheck — keeps the "Errors"
    # filter focused on real problems instead of ISP-level direct timeouts
    # to RU services and Apple push-DNS hiccups (apps retry these silently).
    local noise_excludes=""
    [ "$filter" = "error" ] && noise_excludes='\|outbound/direct.*i/o timeout\|dns: exchange failed'

    # Get timezone offset
    local tz_str=$(cat /etc/TZ 2>/dev/null)
    local TZ_OFFSET=$(echo "$tz_str" | sed 's/[A-Za-z]*//g; s/^-//' | awk '{print int($1)}')
    [ -z "$TZ_OFFSET" ] && TZ_OFFSET=3

    # Collect from multiple sources. mktemp + EXIT trap (in subshell so the
    # trap doesn't leak to the calling shell, e.g. watchdog).
    mkdir -p "$FLOWVPN_TMP"
    (
    local tmplog
    tmplog=$(mktemp "$FLOWVPN_TMP/combined.XXXXXX") || { echo "[]"; exit 1; }
    trap 'rm -f "$tmplog"' EXIT INT TERM

    # Source 1: sing-box log (skip for flow-only filter)
    if [ "$filter" != "flow" ]; then
        grep "$grep_filter" "$FLOWVPN_TMP/singbox.log" 2>/dev/null | \
            grep -v "packet connection$\|WARN\|cached\|inbound/\|1\.1\.1\.1:853\|1\.0\.0\.1:853\|8\.8\.8\.8:853\|8\.8\.4\.4:853\|127\.0\.0\.1:53\|127\.0\.0\.1:5354${noise_excludes}" | \
            sed 's/\x1b\[[0-9;]*m//g; s/\x1b\[0m//g' | \
            awk '{print "SING|"$0}' >> "$tmplog"
    fi

    # Source 2: xray log — only errors
    if [ "$filter" = "all" ] || [ "$filter" = "error" ]; then
        grep -iE "error|fail|warning" "$FLOWVPN_TMP/xray.log" 2>/dev/null | \
            grep -v "accepted\|started\|Reading config" | \
            tail -50 | awk '{print "XRAY|"$0}' >> "$tmplog"
    fi

    # Source 3: syslog flowvpn entries
    if [ "$filter" = "all" ] || [ "$filter" = "flow" ]; then
        logread -e flowvpn 2>/dev/null | tail -100 | awk '{print "FLOW|"$0}' >> "$tmplog"
    fi

    # Sort and parse
    sort "$tmplog" 2>/dev/null | tail -"$lines" | \
        sed 's/\x1b\[[0-9;]*m//g; s/\x1b\[0m//g' | \
        awk -v tz="${TZ_OFFSET:-3}" '{
            # Extract source prefix (SING|, XRAY|, FLOW|)
            src="sing"
            if(substr($0,1,5)=="SING|"){src="sing";$0=substr($0,6)}
            else if(substr($0,1,5)=="XRAY|"){src="xray";$0=substr($0,6)}
            else if(substr($0,1,5)=="FLOW|"){src="flow";$0=substr($0,6)}

            # Extract time
            time=""
            for(i=1;i<=NF;i++){
                if($i ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/){
                    split($(i+1),t,":")
                    h=t[1]+0+tz; if(h>=24)h-=24; if(h<0)h+=24
                    time=$i" "sprintf("%02d:%02d:%02d",h,t[2]+0,t[3]+0)
                    break
                }
            }

            # FLOW entries (syslog: "Fri Apr 24 14:35:52 2026 user.notice flowvpn: message")
            if(src=="flow"){
                msg=""
                for(i=1;i<=NF;i++){
                    if($i ~ /^flowvpn/){
                        for(j=i+1;j<=NF;j++) msg=msg" "$j
                        break
                    }
                }
                # Extract time: field 4 = HH:MM:SS
                time=$1" "$2" "$3" "$4
                gsub(/^ +/,"",msg)
                if(msg != "") print time"|"msg"|flow"
                next
            }

            # XRAY entries
            if(src=="xray"){
                route="xray"
                dst=""
                if(/accepted/){
                    for(i=1;i<=NF;i++){
                        if($i=="accepted"){dst=$(i+1); break}
                    }
                } else if(/error|fail|timeout/){
                    route="error"
                    idx=0
                    for(i=1;i<=length($0);i++){if(substr($0,i,2)=="] ")idx=i+2}
                    if(idx>0)dst=substr($0,idx)
                    if(length(dst)>100)dst=substr(dst,1,100)"..."
                }
                if(dst != "") print time"|"dst"|"route
                next
            }

            # SING entries
            route=""
            if(/outbound\/socks/) route="vpn"
            else if(/outbound\/direct/) route="direct"
            else if(/ERROR/) route="error"
            else if(/dns:.*exchanged/) route="dns"

            dst=""
            if(route=="error"){
                idx=0
                for(i=1;i<=length($0);i++){if(substr($0,i,2)=="] ")idx=i+2}
                if(idx>0)dst=substr($0,idx)
                if(length(dst)>100)dst=substr(dst,1,100)"..."
            } else if(route=="dns"){
                for(i=1;i<=NF;i++){
                    if($i=="exchanged"){
                        if($(i+1)=="A"||$(i+1)=="AAAA") dst=$(i+2)" → "$(i+6)
                        else if($(i+1)=="CNAME") dst=$(i+2)" → "$(i+6)
                        else dst=$(i+1)" "$(i+2)
                        break
                    }
                }
            } else {
                for(i=1;i<=NF;i++){
                    if($i=="to"&&$(i+1)!~/^127\.|^:$|^0\.0/){dst=$(i+1);break}
                }
            }
            gsub(/\.$/,"",dst)

            if(route!=""&&(dst!=""||route=="error")) print time"|"dst"|"route
        }' | \
        jq -R -s 'split("\n") | map(select(length > 0)) | map(split("|") | {time: .[0], dst: .[1], route: .[2]})'

    rm -f "$tmplog"
    )
}

cmd_get_dns() {
    local mode=$(get_config_val mode "all_vpn")
    local dnsmasq_server=""
    dnsmasq_server=$(uci get dhcp.@dnsmasq[0].server 2>/dev/null)
    jq -n --arg mode "$mode" --arg dnsmasq "$dnsmasq_server" \
        '{mode:$mode, dnsmasq_server:$dnsmasq, proxy_dns:"tls://1.1.1.1", direct_dns:"udp://1.1.1.1",
          dot_blocked:true, quic_blocked:($mode != "all_vpn")}'
}

cmd_set_config() {
    local key="$1" value="$2"
    [ -z "$key" ] || [ -z "$value" ] && { echo '{"error":"missing key or value"}'; return 1; }
    # Whitelist allowed keys
    case "$key" in
        subscription_url|interface|mode|auto_start|selected_server|blocklist_source|auto_mode) ;;
        *) echo '{"error":"invalid key"}'; return 1 ;;
    esac
    # Boolean keys: store as JSON true/false instead of "true"/"false" string,
    # so cmd_status's `// true` defaults work and the UI gets a real bool.
    local tmp
    case "$key" in
        auto_start|auto_mode)
            local bv
            case "$value" in
                true|1|on|yes) bv=true ;;
                *) bv=false ;;
            esac
            tmp=$(jq --arg k "$key" --argjson v "$bv" '.[$k] = $v' "$FLOWVPN_CONFIG")
            ;;
        *)
            tmp=$(jq --arg k "$key" --arg v "$value" '.[$k] = $v' "$FLOWVPN_CONFIG")
            ;;
    esac
    save_config "$tmp"
    echo "{\"status\":\"saved\",\"key\":\"$key\"}"
}

cmd_diagnose() {
    # Tab-separated rows (name<TAB>status<TAB>detail) → single jq at end.
    # Three network probes run in parallel (saves ~10-15s on aarch64).
    local diag_dir="$FLOWVPN_TMP/diag.$$"
    mkdir -p "$diag_dir"
    local rows="$diag_dir/rows"
    : > "$rows"
    trap "rm -rf '$diag_dir'" EXIT INT TERM

    _add() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$rows"; }

    # Kick off network probes in parallel — they dominate total runtime.
    if is_xray_running; then
        ( curl -s --socks5-hostname 127.0.0.1:1080 --max-time 5 https://ifconfig.me 2>/dev/null > "$diag_dir/vpn_ip" ) &
        ( curl -s --socks5-hostname 127.0.0.1:1080 --max-time 8 -o /dev/null -w "%{http_code}" https://youtube.com 2>/dev/null > "$diag_dir/yt_code" ) &
    fi
    ( curl -s --max-time 5 -o /dev/null -w "%{http_code}" https://yandex.ru 2>/dev/null > "$diag_dir/ya_code" ) &

    # Local checks while probes are in flight.

    # 1. xray
    if is_xray_running; then
        _add "xray-core" "ok" "PID $(cat /tmp/flowvpn/xray.pid 2>/dev/null), порт 1080"
    else
        _add "xray-core" "error" "Не запущен"
    fi

    # 2. sing-box
    if is_singbox_running; then
        _add "sing-box" "ok" "PID $(cat /tmp/flowvpn/singbox.pid 2>/dev/null), порт 2154"
    else
        _add "sing-box" "error" "Не запущен"
    fi

    # 3. nftables
    if nft list table ip flowvpn >/dev/null 2>&1; then
        local rule_count=$(nft list table ip flowvpn 2>/dev/null | grep -c "tproxy\|return\|reject")
        _add "nftables" "ok" "Таблица flowvpn: $rule_count правил"
    else
        _add "nftables" "error" "Таблица flowvpn не найдена"
    fi

    # 4. ip rule for tproxy
    if ip rule list | grep -q "fwmark 0x1"; then
        _add "ip-rule" "ok" "fwmark 0x1 → table 100"
    else
        _add "ip-rule" "error" "Правило fwmark не найдено"
    fi

    # 5. dnsmasq → sing-box
    local dns_srv=$(uci get dhcp.@dnsmasq[0].server 2>/dev/null)
    if echo "$dns_srv" | grep -q "5354"; then
        _add "dns-redirect" "ok" "dnsmasq → sing-box ($dns_srv)"
    else
        _add "dns-redirect" "warn" "dnsmasq не перенаправлен: $dns_srv"
    fi

    # 6. DNS resolution
    local dns_test=$(nslookup youtube.com 127.0.0.1 2>&1 | grep -c "Address.*[0-9]")
    if [ "$dns_test" -gt 1 ]; then
        _add "dns-resolve" "ok" "youtube.com резолвится"
    else
        _add "dns-resolve" "error" "youtube.com не резолвится"
    fi

    # Wait for the parallel probes before consuming their results.
    wait
    local vpn_ip="" yt_code="" ya_code=""
    [ -f "$diag_dir/vpn_ip" ]  && vpn_ip=$(cat "$diag_dir/vpn_ip" 2>/dev/null)
    [ -f "$diag_dir/yt_code" ] && yt_code=$(cat "$diag_dir/yt_code" 2>/dev/null)
    [ -f "$diag_dir/ya_code" ] && ya_code=$(cat "$diag_dir/ya_code" 2>/dev/null)

    # 7. VPN connection
    if ! is_xray_running; then
        _add "vpn-connection" "error" "xray не запущен"
    elif [ -n "$vpn_ip" ]; then
        _add "vpn-connection" "ok" "VPN IP: $vpn_ip"
    else
        _add "vpn-connection" "error" "Нет ответа через VPN"
    fi

    # 8. Blocked site through VPN
    if ! is_xray_running; then
        _add "test-blocked" "error" "xray не запущен"
    elif [ "$yt_code" = "301" ] || [ "$yt_code" = "200" ]; then
        _add "test-blocked" "ok" "youtube.com: HTTP $yt_code через VPN"
    else
        _add "test-blocked" "error" "youtube.com: HTTP $yt_code"
    fi

    # 9. RU site direct
    if [ "$ya_code" = "302" ] || [ "$ya_code" = "200" ]; then
        _add "test-direct" "ok" "yandex.ru: HTTP $ya_code напрямую"
    else
        _add "test-direct" "warn" "yandex.ru: HTTP $ya_code"
    fi

    # 10. sing-box log errors — read tail by BYTES, not lines.
    # `tail -n N` walks the file from the start on busybox, so a 45MB log
    # blocks for ~100s and overruns uhttpd's 30s network_timeout.
    # `tail -c N` seeks from the end and is O(1).
    local err_count=0 last_err=""
    if [ -f "$FLOWVPN_TMP/singbox.log" ]; then
        local err_lines=$(tail -c 262144 "$FLOWVPN_TMP/singbox.log" 2>/dev/null | tr -d '\0' | grep "ERROR")
        if [ -n "$err_lines" ]; then
            err_count=$(printf '%s\n' "$err_lines" | wc -l)
            last_err=$(printf '%s\n' "$err_lines" | tail -1 | sed 's/.*\] //')
        fi
    fi
    if [ "$err_count" -eq 0 ]; then
        _add "log-errors" "ok" "Ошибок нет (последние 256KB)"
    else
        _add "log-errors" "warn" "$err_count ошибок. Последняя: $last_err"
    fi

    # 11. Log size — bytes, not line count.
    local log_bytes=0 log_mb=0
    if [ -f "$FLOWVPN_TMP/singbox.log" ]; then
        log_bytes=$(wc -c < "$FLOWVPN_TMP/singbox.log" 2>/dev/null)
        log_mb=$((log_bytes / 1048576))
    fi
    if [ "$log_mb" -ge 10 ]; then
        _add "log-size" "warn" "${log_mb}MB — лог большой, рекомендуется очистить"
    else
        _add "log-size" "ok" "${log_mb}MB"
    fi

    # 12. Disk space
    local free_mb=$(df /overlay 2>/dev/null | tail -1 | awk '{print int($4/1024)}')
    if [ "$free_mb" -lt 5 ]; then
        _add "disk" "error" "Мало места: ${free_mb}MB свободно"
    else
        _add "disk" "ok" "${free_mb}MB свободно на /overlay"
    fi

    # Convert TSV → JSON in a single jq invocation.
    jq -R -s '
        split("\n") | map(select(length > 0)) | map(split("\t")) |
        map({name:.[0], status:.[1], detail:.[2]})
    ' < "$rows"
}

# ============================================================
# Watchdog — auto-failover
# ============================================================

# A server is "metered" (RU-safe, mobile-carrier) when its name contains
# carrier markers. Such servers give a Russian IP, so watchdog must NEVER
# auto-switch to them — doing so defeats the purpose of a VPN.
_is_metered_server() {
    local name="$1"
    case "$name" in
        *МТС*|*мтс*|*MTS*|*mts*) return 0 ;;
        *Т2*|*т2*|*Tele2*|*tele2*|*Би*) return 0 ;;
        *Билайн*|*билайн*|*Beeline*|*beeline*) return 0 ;;
        *Мегафон*|*мегафон*|*Megafon*|*megafon*) return 0 ;;
    esac
    return 1
}

_record_switch() {
    local from_idx="$1" to_idx="$2" reason="$3"
    local from_name=$(jq -r ".[$from_idx].name // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
    local to_name=$(jq -r ".[$to_idx].name // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
    jq -n --arg from "$from_name" --arg to "$to_name" --arg reason "$reason" \
        --argjson ts "$(date +%s)" \
        '{time:$ts, from:$from, to:$to, reason:$reason}' \
        > "$FLOWVPN_TMP/last_switch.json" 2>/dev/null
}

# Record a server-stability incident. Stored as a JSON array (last 200) keyed
# by host so renumbering after an `update` doesn't lose history. Read by
# cmd_get_incidents and rendered in the UI as per-server fail badges + history.
_log_incident() {
    local type="$1" host="$2" name="$3" detail="$4"
    local f="$FLOWVPN_TMP/incidents.json"
    mkdir -p "$FLOWVPN_TMP"
    [ -f "$f" ] || echo '[]' > "$f"
    local tmp="$f.tmp.$$"
    jq --arg type "$type" --arg host "$host" --arg name "$name" --arg detail "$detail" \
       --argjson ts "$(date +%s)" \
       '. + [{ts:$ts, type:$type, host:$host, server:$name, detail:$detail}] | .[-200:]' \
       "$f" > "$tmp" 2>/dev/null && mv "$tmp" "$f" || rm -f "$tmp"
}

cmd_get_incidents() {
    local f="$FLOWVPN_TMP/incidents.json"
    if [ ! -f "$f" ]; then echo '{"incidents":[],"stats":[]}'; return; fi
    local now=$(date +%s)
    local h24=$((now - 86400))
    local h7d=$((now - 604800))
    jq --argjson h24 "$h24" --argjson h7d "$h7d" '
      . as $all |
      ($all | sort_by(-.ts) | .[0:200]) as $incidents |
      ($all
        | map(select(.host != null and .host != ""))
        | group_by(.host)
        | map({
            host:      .[0].host,
            server:    (max_by(.ts).server),
            count_24h: (map(select(.ts >= $h24)) | length),
            count_7d:  (map(select(.ts >= $h7d)) | length),
            last_ts:   (max_by(.ts).ts),
            last_type: (max_by(.ts).type)
          })
        | map(select(.count_7d > 0))
        | sort_by(-.count_24h, -.count_7d)
      ) as $stats |
      {incidents: $incidents, stats: $stats}
    ' "$f" 2>/dev/null || echo '{"incidents":[],"stats":[]}'
}

cmd_clear_incidents() {
    echo '[]' > "$FLOWVPN_TMP/incidents.json"
    echo '{"status":"cleared"}'
}

cmd_watchdog() {
    local interval="${1:-20}" max_fails=3 fail_count=0 tick=0 silent_fails=0

    # Single-instance via atomic mkdir. The earlier file-based lock was
    # unreliable: under the init.d/cmd_start spawn race the lock would end
    # up empty/missing while a watchdog was alive, so every subsequent
    # _ensure_watchdog spawned a duplicate. Killing peers from cmd_watchdog
    # also raced with traps not yet installed, sometimes wiping all of them.
    # mkdir is the only POSIX-portable atomic-create primitive available
    # on busybox without flock — it gives "first wins, others exit cleanly".
    local me=$$
    local lockdir="$FLOWVPN_TMP/watchdog.lockdir"
    mkdir -p "$FLOWVPN_TMP"
    while ! mkdir "$lockdir" 2>/dev/null; do
        local owner
        owner=$(cat "$lockdir/owner" 2>/dev/null)
        if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then
            rm -rf "$lockdir"  # stale — owner died without cleanup, retry
            continue
        fi
        return 0  # peer alive, we're a duplicate
    done
    echo "$me" > "$lockdir/owner"
    trap 'rm -rf "$lockdir"; flog "Watchdog stopped"; exit 0' TERM INT EXIT
    # Mirror the owner PID into the legacy lock path for stop()/status code
    # that still reads watchdog.lock.
    echo "$me" > "$FLOWVPN_TMP/watchdog.lock"

    # Unique probe port per-process — survives concurrent set-server probes
    # and other ad-hoc xray runs that might collide on a fixed port.
    local probe_port=$((1082 + $$ % 100))

    while true; do
        sleep "$interval"
        tick=$((tick + 1))

        # Rotate logs every ~3 minutes (10 ticks × 20s). Sing-box at warn
        # level is quiet, but we still want quick recovery if log noise
        # ever spikes (e.g. xray reconnect storm).
        [ $((tick % 10)) -eq 0 ] && _rotate_log

        # Auto-mode periodic re-evaluation every ~20 minutes (60 ticks).
        # cmd_auto_eval has its own internal rate-limit and hysteresis,
        # so it's safe to call this frequently — actual switches happen
        # at most once per hour and only on meaningful improvement.
        if [ $((tick % 60)) -eq 0 ]; then
            local _am
            _am=$(get_config_val auto_mode false)
            [ "$_am" = "true" ] && cmd_auto_eval >/dev/null 2>&1
        fi

        # Auto-recovery: if user wanted VPN on (running_intent=true) but
        # processes died externally — kernel OOM-killer, manual pkill, an
        # xray crash — bring them back. With cooldown to prevent runaway
        # restart loops if cmd_start itself keeps failing (e.g. provider
        # blocked, server keys rotated): if we already tried recently and
        # still no xray, wait — don't pile up zombie children.
        if ! is_xray_running || ! is_singbox_running; then
            # Defer revival if a user-initiated lifecycle command is in
            # flight. cmd_restart's brief stop_xray window otherwise tricks
            # us into revival, which then races the rest of cmd_restart and
            # spawns a parallel xray.
            local op_marker="$FLOWVPN_TMP/op.in_progress"
            if [ -f "$op_marker" ]; then
                local op_pid=$(cat "$op_marker" 2>/dev/null)
                if [ -n "$op_pid" ] && kill -0 "$op_pid" 2>/dev/null; then
                    continue
                fi
                # Stale marker — owning process is dead, fall through and
                # remove on the way out so we don't get stuck deferring forever.
                rm -f "$op_marker"
            fi

            local _intent
            _intent=$(get_config_val running_intent false)
            if [ "$_intent" = "true" ]; then
                local revive_marker="$FLOWVPN_TMP/last_revive"
                local now=$(date +%s)
                local last=0
                [ -f "$revive_marker" ] && last=$(cat "$revive_marker" 2>/dev/null)
                [ -z "$last" ] && last=0
                # Min 60s between revival attempts. cmd_start needs ~7s to
                # complete; this gives it room to finish + brief settle time.
                if [ $((now - last)) -lt 60 ]; then
                    : # in cooldown — skip this tick silently
                else
                    flog "Watchdog: VPN was killed externally, reviving"
                    echo $now > "$revive_marker"
                    cmd_start >/dev/null 2>&1
                fi
            fi
            continue
        fi

        # Skip if not running (intent=false — user wanted VPN off)
        is_xray_running || continue

        # Test VPN connectivity via current SOCKS. 8s timeout — 4s was too
        # tight for SOCKS+VLESS+Reality+TLS+HTTP under load and produced
        # spurious failovers when transient jitter happened to line up two
        # ticks in a row (real-world: 22 isolated failures across 5h, then
        # one back-to-back pair → false-positive switch from a healthy server).
        # Capture both http_code and curl's exit code so failures can be
        # explained ("timeout" vs "DNS" vs "connect refused"), not just counted.
        local probe_out probe_rc probe_code probe_time
        probe_out=$(curl -s --socks5-hostname 127.0.0.1:1080 --max-time 8 -o /dev/null -w "%{http_code} %{time_total}" https://cp.cloudflare.com/generate_204 2>/dev/null)
        probe_rc=$?
        probe_code="${probe_out%% *}"
        probe_time="${probe_out##* }"
        if [ "$probe_code" = "204" ] || [ "$probe_code" = "200" ]; then
            # If we just recovered from a long outage, log it once.
            [ "$silent_fails" -gt 0 ] && logger -t flowvpn "Watchdog: connectivity restored (was failing $silent_fails ticks)"
            fail_count=0
            silent_fails=0
            continue
        fi

        # Map curl exit code to a human reason. Codes per curl(1):
        # 6=DNS, 7=connect, 28=timeout, 35=TLS handshake, 52=empty reply,
        # 56=recv reset, 92=HTTP/2 stream error.
        local why
        case "$probe_rc" in
            0)  why="HTTP $probe_code за ${probe_time}с" ;;
            6)  why="DNS не разрешился" ;;
            7)  why="прокси не отвечает (xray:1080)" ;;
            28) why="таймаут >8с (HTTP $probe_code)" ;;
            35) why="ошибка TLS handshake" ;;
            52) why="пустой ответ от сервера" ;;
            56) why="разрыв соединения" ;;
            *)  why="curl rc=$probe_rc, HTTP $probe_code" ;;
        esac

        fail_count=$((fail_count + 1))
        # Throttle "check failed" logs after the failover loop already ran —
        # otherwise a permanent outage spams syslog every 20s forever.
        if [ "$fail_count" -le "$max_fails" ]; then
            logger -t flowvpn "Watchdog: server check failed ($fail_count/$max_fails): $why"
            local _cur_idx=$(get_config_val selected_server 0)
            local _cur_name=$(jq -r ".[$_cur_idx].name // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
            local _cur_host=$(jq -r ".[$_cur_idx].host // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
            _log_incident "check_fail" "$_cur_host" "$_cur_name" "$why ($fail_count/$max_fails)"
        else
            silent_fails=$((silent_fails + 1))
            # One reminder every ~5 min while still down
            [ $((silent_fails % 15)) -eq 0 ] && logger -t flowvpn "Watchdog: still no connectivity ($silent_fails ticks since last switch): $why"
        fi

        if [ "$fail_count" -eq "$max_fails" ]; then
            logger -t flowvpn "Watchdog: switching server (cause: $why)"

            local current=$(get_config_val selected_server 0)
            local selected="$current"
            local total=$(jq 'length' "$FLOWVPN_TMP/servers.json" 2>/dev/null)
            [ -z "$total" ] && continue

            # Try next servers (skip metered/RU-safe ones)
            local tried=0 found=0
            while [ "$tried" -lt "$total" ]; do
                selected=$(( (selected + 1) % total ))
                tried=$((tried + 1))

                local cand_name=$(jq -r ".[$selected].name" "$FLOWVPN_TMP/servers.json")
                if _is_metered_server "$cand_name"; then
                    logger -t flowvpn "Watchdog: skip metered server $cand_name"
                    continue
                fi

                # Quick test this server via a temporary probe xray on a unique
                # port and unique config files so cmd_probe_server (UI) running
                # at the same time can't clobber our config or vice versa.
                # xray requires .json suffix; mktemp+rename to get it.
                local wd_test wd_probe _wt _wp
                _wt=$(mktemp "$FLOWVPN_TMP/xray_test.XXXXXX")
                _wp=$(mktemp "$FLOWVPN_TMP/xray_probe.XXXXXX")
                wd_test="${_wt}.json"; wd_probe="${_wp}.json"
                mv "$_wt" "$wd_test"; mv "$_wp" "$wd_probe"
                generate_xray_config "$FLOWVPN_TMP/servers.json" "$selected" "$wd_test"
                jq --argjson p "$probe_port" \
                    '.inbounds=[{tag:"t",port:$p,listen:"127.0.0.1",protocol:"socks",settings:{auth:"noauth"}}]' \
                    "$wd_test" > "$wd_probe"
                /usr/bin/xray run -config "$wd_probe" >/dev/null 2>&1 &
                local probe_pid=$!
                sleep 3

                local test_ip=$(curl -s --socks5-hostname "127.0.0.1:$probe_port" --max-time 5 https://api.ipify.org 2>/dev/null)
                kill $probe_pid 2>/dev/null; wait $probe_pid 2>/dev/null
                rm -f "$wd_test" "$wd_probe"

                if [ -n "$test_ip" ]; then
                    logger -t flowvpn "Watchdog: switched to $cand_name ($test_ip)"
                    local _from_name=$(jq -r ".[$current].name // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
                    local _cand_host=$(jq -r ".[$selected].host // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
                    _log_incident "auto_switch" "$_cand_host" "$cand_name" "после $max_fails сбоев на $_from_name ($why)"
                    _record_switch "$current" "$selected" "failover"
                    local tmp=$(jq --argjson idx "$selected" '.selected_server = $idx' "$FLOWVPN_CONFIG")
                    save_config "$tmp"
                    cmd_restart >/dev/null 2>&1
                    fail_count=0
                    silent_fails=0
                    found=1
                    # Give the new server time to stabilize before next probe.
                    # Without this, a flaky network triggers cascading failovers.
                    sleep $((interval * 3))
                    break
                fi
            done
            # Failover loop exhausted without finding a working candidate.
            # Stay on current server and back off — log once, not every tick.
            if [ "$found" -eq 0 ]; then
                logger -t flowvpn "Watchdog: all $tried candidates failed, staying on current server"
                local _cur_name=$(jq -r ".[$current].name // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
                local _cur_host=$(jq -r ".[$current].host // \"\"" "$FLOWVPN_TMP/servers.json" 2>/dev/null)
                _log_incident "switch_failed" "$_cur_host" "$_cur_name" "все $tried серверов недоступны"
            fi
        fi
    done
}

# ============================================================
# Traffic stats
# ============================================================

cmd_get_traffic() {
    # Honest per-outbound accounting via Clash API /connections.
    #
    # The API returns a snapshot of currently-active connections, each with
    # cumulative upload/download since that connection started, plus a
    # "chains" array showing which outbound it routed through ("default" =
    # VPN, "direct" = bypass). Closed connections drop off the list and
    # their final bytes would be lost.
    #
    # We maintain a state file with per-connection-id last-seen counters.
    # On each poll we compute deltas and add them to per-chain totals;
    # connections that have closed are simply not in the new snapshot, so
    # their last-known bytes stay accumulated. Result: cumulative VPN_dl,
    # VPN_ul, DIR_dl, DIR_ul since tracking started (cleared on sing-box
    # restart by start_singbox).
    #
    # The whole RMW is wrapped in flock — UI polls every 5s and two open
    # tabs would otherwise both read the same `seen` snapshot, compute
    # the same deltas, and double-count traffic.
    mkdir -p "$FLOWVPN_TMP"
    local state_file="$FLOWVPN_TMP/traffic_state.json"
    (
        flock -x 200
        [ -f "$state_file" ] || \
            printf '%s\n' '{"vpn_dl":0,"vpn_ul":0,"dir_dl":0,"dir_ul":0,"started":0,"seen":{}}' > "$state_file"

        local conns secret
        secret=$(_get_clash_secret)
        conns=$(curl -s --max-time 3 -H "Authorization: Bearer $secret" \
            http://127.0.0.1:9090/connections 2>/dev/null)

        if [ -z "$conns" ] || ! echo "$conns" | jq -e . >/dev/null 2>&1; then
            jq '. + {total_dl:0, total_ul:0, vpn_active:0, direct_active:0,
                     vpn_conns:0, direct_conns:0, api_ok:false} | del(.seen)' "$state_file"
            return 0
        fi

        local new_state
        new_state=$(jq -n \
        --slurpfile state "$state_file" \
        --argjson conns "$conns" '
        ($state[0]) as $s |
        ($s.seen // {}) as $seen |
        ($conns.connections // []) as $active |
        # Classify each active connection: dir if "direct" appears in chains,
        # otherwise vpn (covers "default" and any other proxy chain).
        ($active | map({
            id: .id,
            dl: (.download // 0),
            ul: (.upload // 0),
            chain: (if (.chains // [] | index("direct")) then "dir" else "vpn" end)
        })) as $cur |
        # Compute per-connection deltas. If current < previously-seen (rare:
        # the connection ID was reused after close), fall back to the full
        # current value rather than going negative.
        ($cur | map(
            . + {
                dl_delta: (if .dl >= (($seen[.id].dl) // 0) then .dl - (($seen[.id].dl) // 0) else .dl end),
                ul_delta: (if .ul >= (($seen[.id].ul) // 0) then .ul - (($seen[.id].ul) // 0) else .ul end)
            }
        )) as $deltas |
        ($deltas | map(select(.chain == "vpn"))) as $vpn |
        ($deltas | map(select(.chain == "dir"))) as $dir |
        # New seen{}: only currently-active IDs. Closed ones drop out, but
        # their bytes were already added to vpn_*/dir_* on prior polls.
        ($cur | map({key: .id, value: {dl: .dl, ul: .ul, chain: .chain}}) | from_entries) as $new_seen |
        {
            vpn_dl: ($s.vpn_dl + (($vpn | map(.dl_delta) | add) // 0)),
            vpn_ul: ($s.vpn_ul + (($vpn | map(.ul_delta) | add) // 0)),
            dir_dl: ($s.dir_dl + (($dir | map(.dl_delta) | add) // 0)),
            dir_ul: ($s.dir_ul + (($dir | map(.ul_delta) | add) // 0)),
            started: (if $s.started > 0 then $s.started else now | floor end),
            seen: $new_seen
        }
    ')

        if [ -n "$new_state" ] && echo "$new_state" | jq -e . >/dev/null 2>&1; then
            printf '%s\n' "$new_state" > "${state_file}.tmp" && mv "${state_file}.tmp" "$state_file"
        fi

        # Public response — strip the internal seen{} and add live fields.
        cat "$state_file" | jq \
            --argjson conns "$conns" \
            '{
                vpn_dl, vpn_ul, dir_dl, dir_ul, started,
                total_dl: ($conns.downloadTotal // 0),
                total_ul: ($conns.uploadTotal // 0),
                vpn_active: ([$conns.connections[]? | select(.chains | index("direct") | not)
                                                    | (.upload // 0) + (.download // 0)] | add // 0),
                direct_active: ([$conns.connections[]? | select(.chains | index("direct"))
                                                    | (.upload // 0) + (.download // 0)] | add // 0),
                vpn_conns: ([$conns.connections[]? | select(.chains | index("direct") | not)] | length),
                direct_conns: ([$conns.connections[]? | select(.chains | index("direct"))] | length),
                api_ok: true
            }'
    ) 200>"$state_file.lock"
}

cmd_real_ping() {
    # Real end-to-end latency through VLESS+Reality+XHTTP, not just TCP RTT
    # to :443. Uses sing-box's Clash-API delay endpoint, which dials the
    # actual outbound and times an HTTP HEAD to gstatic.com/generate_204.
    # Cheap (≤5s) and exact — what users actually feel.
    if ! is_singbox_running; then
        echo '{"ok":false, "error":"sing-box not running"}'
        return
    fi
    local secret=$(_get_clash_secret)
    local resp
    resp=$(curl -s --max-time 7 -H "Authorization: Bearer $secret" \
        "http://127.0.0.1:9090/proxies/default/delay?url=https://www.gstatic.com/generate_204&timeout=5000" 2>/dev/null)
    if [ -z "$resp" ]; then
        echo '{"ok":false, "error":"clash api unavailable"}'
        return
    fi
    # Either {"delay":NN} on success or {"message":"..."} on failure.
    local delay
    delay=$(echo "$resp" | jq -r '.delay // empty' 2>/dev/null)
    if [ -n "$delay" ] && [ "$delay" -gt 0 ] 2>/dev/null; then
        echo "{\"ok\":true, \"delay_ms\":$delay}"
    else
        local msg
        msg=$(echo "$resp" | jq -r '.message // "timeout"' 2>/dev/null)
        echo "{\"ok\":false, \"error\":\"$msg\"}"
    fi
}

cmd_reset_traffic() {
    # Reset cumulative per-chain counters (vpn_dl/ul, dir_dl/ul) and start a
    # fresh accounting window. Keeps `seen{}` populated with current
    # connection IDs so the next poll computes deltas from now, not from
    # whatever bytes those open connections had accumulated before.
    local state_file="$FLOWVPN_TMP/traffic_state.json"
    mkdir -p "$FLOWVPN_TMP"
    (
        flock -x 200
        local now=$(date +%s)
        local seen='{}'
        if [ -f "$state_file" ]; then
            seen=$(jq '.seen // {}' "$state_file" 2>/dev/null || echo '{}')
        fi
        jq -n --argjson seen "$seen" --argjson ts "$now" \
            '{vpn_dl:0, vpn_ul:0, dir_dl:0, dir_ul:0, started:$ts, seen:$seen}' \
            > "$state_file.tmp" && mv "$state_file.tmp" "$state_file"
    ) 200>"$state_file.lock"
    echo "{\"status\":\"reset\",\"started\":$(date +%s)}"
}

# ============================================================
# Schedule
# ============================================================

cmd_schedule() {
    local action="$1" on_time="$2" off_time="$3"
    case "$action" in
        set)
            [ -z "$on_time" ] || [ -z "$off_time" ] && { echo '{"error":"need on_time and off_time"}'; return 1; }
            local tmp=$(jq --arg on "$on_time" --arg off "$off_time" \
                '.schedule = {enabled:true, on:$on, off:$off}' "$FLOWVPN_CONFIG")
            save_config "$tmp"
            _setup_cron
            echo "{\"status\":\"schedule set\",\"on\":\"$on_time\",\"off\":\"$off_time\"}"
            ;;
        disable)
            local tmp=$(jq '.schedule.enabled = false' "$FLOWVPN_CONFIG")
            save_config "$tmp"
            _remove_cron
            echo '{"status":"schedule disabled"}'
            ;;
        *)
            local sched=$(jq '.schedule // {enabled:false}' "$FLOWVPN_CONFIG")
            echo "$sched"
            ;;
    esac
}

_setup_cron() {
    _remove_cron
    local on_time=$(jq -r '.schedule.on // "07:00"' "$FLOWVPN_CONFIG")
    local off_time=$(jq -r '.schedule.off // "23:00"' "$FLOWVPN_CONFIG")
    local on_h=${on_time%%:*} on_m=${on_time##*:}
    local off_h=${off_time%%:*} off_m=${off_time##*:}
    (crontab -l 2>/dev/null; echo "$on_m $on_h * * * /usr/bin/flowvpn start >/dev/null 2>&1 #flowvpn") | crontab -
    (crontab -l 2>/dev/null; echo "$off_m $off_h * * * /usr/bin/flowvpn stop >/dev/null 2>&1 #flowvpn") | crontab -
}

_remove_cron() {
    crontab -l 2>/dev/null | grep -v "#flowvpn" | crontab -
}

# ============================================================
# Auto-update
# ============================================================

cmd_auto_update() {
    local action="$1"
    case "$action" in
        enable)
            local tmp=$(jq '.auto_update = true' "$FLOWVPN_CONFIG")
            save_config "$tmp"
            _setup_auto_update_cron
            echo '{"status":"auto-update enabled"}'
            ;;
        disable)
            local tmp=$(jq '.auto_update = false' "$FLOWVPN_CONFIG")
            save_config "$tmp"
            _remove_auto_update_cron
            echo '{"status":"auto-update disabled"}'
            ;;
        *)
            jq '{auto_update: (.auto_update // false)}' "$FLOWVPN_CONFIG"
            ;;
    esac
}

_setup_auto_update_cron() {
    _remove_auto_update_cron
    (crontab -l 2>/dev/null; echo "0 3 * * * /usr/bin/flowvpn update >/dev/null 2>&1 #flowvpn-update") | crontab -
}

_remove_auto_update_cron() {
    crontab -l 2>/dev/null | grep -v "#flowvpn-update" | crontab -
}

# ============================================================
# Backup / Restore
# ============================================================

cmd_backup() {
    local direct_domains="" vpn_domains=""
    [ -f /etc/flowvpn/direct_domains.txt ] && direct_domains=$(cat /etc/flowvpn/direct_domains.txt)
    [ -f /etc/flowvpn/vpn_domains.txt ] && vpn_domains=$(cat /etc/flowvpn/vpn_domains.txt)
    jq -n --argjson config "$(cat $FLOWVPN_CONFIG)" \
        --arg direct "$direct_domains" --arg vpn "$vpn_domains" \
        '{config:$config, direct_domains:$direct, vpn_domains:$vpn, version:"v4"}'
}

cmd_restore() {
    local data
    if [ -n "$1" ]; then
        data="$1"
    else
        data=$(cat)
    fi
    [ -z "$data" ] && { echo '{"error":"no data"}'; return 1; }
    # Validate JSON structure before applying — prevents writing garbage to config
    if ! printf '%s' "$data" | jq -e '.config' >/dev/null 2>&1; then
        echo '{"error":"invalid backup format"}'; return 1
    fi
    # printf '%s' (not echo) — avoids ash interpreting \n,\t in JSON string values
    printf '%s' "$data" | jq -r '.config' > "$FLOWVPN_CONFIG"
    printf '%s' "$data" | jq -r '.direct_domains // ""' > /etc/flowvpn/direct_domains.txt
    printf '%s' "$data" | jq -r '.vpn_domains // ""' > /etc/flowvpn/vpn_domains.txt
    echo '{"status":"restored"}'
}

# ============================================================
# Per-device routing
# ============================================================

_validate_ipv4() {
    # Returns 0 if $1 is a valid dotted-quad with octets 0-255, else 1.
    local ip="$1"
    case "$ip" in *[!0-9.]*|*..*|.*|*.) return 1;; esac
    local IFS=.; set -- $ip; unset IFS
    [ $# -eq 4 ] || return 1
    for o in "$@"; do
        case "$o" in ''|*[!0-9]*) return 1;; esac
        [ "$o" -le 255 ] 2>/dev/null || return 1
    done
    return 0
}

# Accept "AA:BB:CC:DD:EE:FF" form (case-insensitive). Returns the MAC
# normalized to uppercase so config storage is consistent.
_normalize_mac() {
    local m="$1"
    case "$m" in
        [0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F])
            printf '%s' "$m" | tr 'a-f' 'A-F'
            return 0
            ;;
    esac
    return 1
}

cmd_set_device_route() {
    local id="$1" route="$2"
    [ -z "$id" ] || [ -z "$route" ] && { echo '{"error":"need id (ip or mac) and route (vpn/direct)"}'; return 1; }
    case "$route" in vpn|direct) ;; *) echo '{"error":"route must be vpn or direct"}'; return 1;; esac
    # Accept either IPv4 or MAC. MAC is preferred — survives DHCP changes.
    local mac
    if mac=$(_normalize_mac "$id"); then
        id="$mac"
    elif ! _validate_ipv4 "$id"; then
        echo '{"error":"id must be a valid IPv4 or MAC address"}'; return 1
    fi
    local tmp=$(jq --arg id "$id" --arg r "$route" \
        '.device_rules[$id] = $r' "$FLOWVPN_CONFIG")
    save_config "$tmp"
    # Rebuild nftables if running
    if is_singbox_running; then
        local iface=$(get_config_val interface "br-lan")
        setup_network 2154 32768 "$iface"
    fi
    echo "{\"status\":\"device route set\",\"id\":\"$id\",\"route\":\"$route\"}"
}

cmd_remove_device_route() {
    local id="$1"
    [ -z "$id" ] && { echo '{"error":"need id"}'; return 1; }
    local mac
    if mac=$(_normalize_mac "$id"); then
        id="$mac"
    elif ! _validate_ipv4 "$id"; then
        echo '{"error":"id must be a valid IPv4 or MAC address"}'; return 1
    fi
    local tmp=$(jq --arg id "$id" 'del(.device_rules[$id])' "$FLOWVPN_CONFIG")
    save_config "$tmp"
    if is_singbox_running; then
        local iface=$(get_config_val interface "br-lan")
        setup_network 2154 32768 "$iface"
    fi
    echo "{\"status\":\"device route removed\",\"id\":\"$id\"}"
}

cmd_system_info() {
    local fw_ver="" xray_ver="" sb_ver=""
    [ -f /etc/openwrt_release ] && fw_ver=$(awk -F"'" '/DISTRIB_DESCRIPTION/{print $2}' /etc/openwrt_release)
    xray_ver=$(/usr/bin/xray version 2>/dev/null | head -1 | awk '{print $2}')
    sb_ver=$(/usr/bin/sing-box version 2>/dev/null | head -1 | awk '{print $3}')
    local sys_uptime=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
    local mem_total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)
    local mem_avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)
    local load=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
    local flash_info=$(df -Pk /overlay 2>/dev/null | awk 'NR==2{print $2","$3","$4}')
    local flash_total=$(echo "$flash_info" | cut -d, -f1)
    local flash_used=$(echo "$flash_info" | cut -d, -f2)
    local flash_avail=$(echo "$flash_info" | cut -d, -f3)
    local cpu_model=$(awk -F: '/model name|Hardware/{print $2;exit}' /proc/cpuinfo 2>/dev/null | sed 's/^ //')
    local arch=$(uname -m)
    jq -n \
        --arg flowvpn "4.0.0" \
        --arg xray "$xray_ver" \
        --arg singbox "$sb_ver" \
        --arg openwrt "$fw_ver" \
        --arg arch "$arch" \
        --arg cpu "$cpu_model" \
        --arg load "$load" \
        --argjson sys_uptime "${sys_uptime:-0}" \
        --argjson mem_total_kb "${mem_total:-0}" \
        --argjson mem_avail_kb "${mem_avail:-0}" \
        --argjson flash_total_kb "${flash_total:-0}" \
        --argjson flash_used_kb "${flash_used:-0}" \
        --argjson flash_avail_kb "${flash_avail:-0}" \
        '{flowvpn:$flowvpn, xray:$xray, singbox:$singbox, openwrt:$openwrt,
          arch:$arch, cpu:$cpu, load:$load, sys_uptime:$sys_uptime,
          mem_total_kb:$mem_total_kb, mem_avail_kb:$mem_avail_kb,
          flash_total_kb:$flash_total_kb, flash_used_kb:$flash_used_kb,
          flash_avail_kb:$flash_avail_kb}'
}

cmd_healthcheck() {
    local results="[]"
    _hc() {
        local name="$1" status="$2" detail="$3"
        results=$(echo "$results" | jq --arg n "$name" --arg s "$status" --arg d "$detail" \
            '. + [{name:$n, status:$s, detail:$d}]')
    }

    # 1. Processes
    is_xray_running && _hc "xray" "ok" "PID $(cat /tmp/flowvpn/xray.pid)" \
        || _hc "xray" "error" "Не запущен"
    is_singbox_running && _hc "sing-box" "ok" "PID $(cat /tmp/flowvpn/singbox.pid)" \
        || _hc "sing-box" "error" "Не запущен"

    # 2. Ports
    netstat -tlnp 2>/dev/null | grep -q ":1080" && _hc "SOCKS :1080" "ok" "xray слушает" \
        || _hc "SOCKS :1080" "error" "Порт не открыт"
    netstat -tlnp 2>/dev/null | grep -q ":2154" && _hc "tproxy :2154" "ok" "sing-box слушает" \
        || _hc "tproxy :2154" "error" "Порт не открыт"
    netstat -ulnp 2>/dev/null | grep -q ":5354" && _hc "DNS :5354" "ok" "sing-box DNS слушает" \
        || _hc "DNS :5354" "error" "Порт не открыт"

    # 3. nftables
    if nft list table ip flowvpn >/dev/null 2>&1; then
        local rc=$(nft list table ip flowvpn 2>/dev/null | grep -c "return\|tproxy\|reject")
        _hc "nftables" "ok" "$rc правил в таблице flowvpn"
    else
        _hc "nftables" "error" "Таблица flowvpn не найдена"
    fi

    # 4. IP rule
    ip rule list | grep -q "fwmark 0x1" && _hc "ip rule" "ok" "fwmark 0x1 → table 100" \
        || _hc "ip rule" "error" "Правило отсутствует"

    # 5. DNS
    local dns_srv=$(uci get dhcp.@dnsmasq[0].server 2>/dev/null)
    echo "$dns_srv" | grep -q "5354" && _hc "DNS redirect" "ok" "dnsmasq → $dns_srv" \
        || _hc "DNS redirect" "warn" "dnsmasq: $dns_srv"
    nslookup youtube.com 127.0.0.1 >/dev/null 2>&1 && _hc "DNS youtube.com" "ok" "Резолвится" \
        || _hc "DNS youtube.com" "error" "Не резолвится"

    # 6. VPN connection
    if is_xray_running; then
        # -4 forces IPv4 — sing-box's strategy is ipv4_only but ifconfig.me
        # serves IPv6 too via Happy Eyeballs, which produced confusing
        # AAAA records in the "VPN туннель" check.
        local vpn_ip=$(curl -4 -s --socks5-hostname 127.0.0.1:1080 --max-time 8 https://ifconfig.me 2>/dev/null)
        local home_ip=$(curl -4 -s --max-time 5 https://ifconfig.me 2>/dev/null)
        [ -n "$vpn_ip" ] && _hc "VPN туннель" "ok" "VPN IP: $vpn_ip" \
            || _hc "VPN туннель" "error" "Нет ответа"
        [ -n "$home_ip" ] && [ "$vpn_ip" != "$home_ip" ] && _hc "IP проверка" "ok" "VPN ≠ Home ($home_ip)" \
            || _hc "IP проверка" "warn" "VPN=$vpn_ip Home=$home_ip"
    fi

    # 7. Blocked sites
    for site in youtube.com instagram.com x.com; do
        local code=$(curl -s --socks5-hostname 127.0.0.1:1080 --max-time 8 -o /dev/null -w "%{http_code}" https://$site 2>/dev/null)
        case "$code" in 200|301|302) _hc "$site" "ok" "HTTP $code через VPN" ;; *) _hc "$site" "error" "HTTP $code" ;; esac
    done

    # 8. RU sites direct
    for site in yandex.ru vk.com sber.ru 2ip.ru; do
        local code=$(curl -s --max-time 5 -o /dev/null -w "%{http_code}" https://$site 2>/dev/null)
        case "$code" in 200|301|302) _hc "$site" "ok" "HTTP $code напрямую" ;; *) _hc "$site" "warn" "HTTP $code" ;; esac
    done

    # 9. Rule-sets: query live clash API (reliable after log rotation)
    local rules_json=$(curl -s --max-time 3 -H "Authorization: Bearer $(_get_clash_secret)" http://127.0.0.1:9090/rules 2>/dev/null)
    if echo "$rules_json" | grep -q "geosite-ru"; then
        _hc "geosite-ru" "ok" "Активен"
    else
        _hc "geosite-ru" "error" "Не загружен"
    fi
    if echo "$rules_json" | grep -q "geoip-ru"; then
        _hc "geoip-ru" "ok" "Активен"
    else
        _hc "geoip-ru" "error" "Не загружен"
    fi

    # IP-leak check: simulate a LAN client by going through the xray socks
    # (the same path tproxied client packets take). Cloudflare's trace
    # endpoint reports our exit IP — it must match the current VPN IP.
    # Doing this from the router directly would always see the WAN IP
    # (router itself isn't tproxied — that would cause a routing loop).
    if is_xray_running; then
        local cur_vpn_ip trace seen_ip
        cur_vpn_ip=$(cat "$FLOWVPN_TMP/vpn_ip" 2>/dev/null)
        trace=$(curl -s --max-time 5 --socks5-hostname 127.0.0.1:1080 https://1.1.1.1/cdn-cgi/trace 2>/dev/null)
        seen_ip=$(echo "$trace" | awk -F= '/^ip=/{print $2;exit}')
        if [ -z "$seen_ip" ]; then
            _hc "IP-leak" "warn" "Не удалось проверить (нет связи через VPN)"
        elif [ -z "$cur_vpn_ip" ]; then
            # vpn_ip file may be missing right after a fresh boot before
            # cmd_start has finished writing it — not a real leak, just
            # nothing to compare to yet.
            _hc "IP-leak" "warn" "Нет сохранённого VPN IP (видно $seen_ip)"
        elif [ "$seen_ip" = "$cur_vpn_ip" ]; then
            _hc "IP-leak" "ok" "Клиенты выходят через $seen_ip (VPN)"
        else
            _hc "IP-leak" "error" "Клиенты выходят через $seen_ip — VPN IP $cur_vpn_ip не совпадает"
        fi
    fi

    # 10. Errors — count only "fresh" (last hour) and only real errors.
    # Filtered out as background noise:
    #   - "outbound/direct ... i/o timeout" — Yandex/RU sites unreachable via
    #     ISP's direct path (Lovit CGNAT). Not a VPN bug, apps retry silently.
    #   - "dns: exchange failed" — Apple push-DNS hiccups (iPhone retries).
    # What still counts as a real error: xray crashes, sing-box panics,
    # outbound/socks failures (= our VPN tunnel broke), config errors.
    local cutoff_str=$(date -u -d "@$(($(date +%s) - 3600))" +"%Y-%m-%d %H:%M:%S" 2>/dev/null)
    local sb_err=0 xr_err=0 sb_noise=0
    if [ -n "$cutoff_str" ] && [ -f /tmp/flowvpn/singbox.log ]; then
        local sb_counts
        sb_counts=$(grep "ERROR" /tmp/flowvpn/singbox.log 2>/dev/null | awk -v c="$cutoff_str" '
            {
                if ($2 !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) next
                ts=$2" "$3
                if (ts < c) next
                line=$0
                if (line ~ /outbound\/direct.*i\/o timeout/ || line ~ /dns: exchange failed/) noise++
                else real++
            }
            END { print (real+0)" "(noise+0) }')
        sb_err="${sb_counts%% *}"
        sb_noise="${sb_counts##* }"
    fi
    if [ -n "$cutoff_str" ] && [ -f /tmp/flowvpn/xray.log ]; then
        xr_err=$(grep -iE "error|fail" /tmp/flowvpn/xray.log 2>/dev/null | awk -v c="$cutoff_str" '
            { if ($1 ~ /^[0-9]{4}\/[0-9]{2}\/[0-9]{2}$/) { gsub("/","-",$1); ts=$1" "$2; if (ts >= c) cnt++ } }
            END { print cnt+0 }')
    fi
    if [ "$sb_err" -eq 0 ] && [ "$xr_err" -eq 0 ]; then
        if [ "$sb_noise" -gt 0 ]; then
            _hc "Ошибки" "ok" "Реальных ошибок нет ($sb_noise фоновых отфильтровано)"
        else
            _hc "Ошибки" "ok" "Нет свежих ошибок (за последний час)"
        fi
    else
        _hc "Ошибки" "warn" "За последний час: sing-box: $sb_err, xray: $xr_err"
    fi

    # 11. Resources
    local free_ram=$(free | grep Mem | awk '{print int($4/1024)}')
    local free_flash=$(df /overlay 2>/dev/null | tail -1 | awk '{print int($4/1024)}')
    local cpu=$(cat /proc/loadavg | awk '{print $1}')
    [ "$free_ram" -gt 50 ] && _hc "RAM" "ok" "${free_ram}MB свободно" \
        || _hc "RAM" "warn" "${free_ram}MB свободно — мало!"
    [ "$free_flash" -gt 5 ] && _hc "Flash" "ok" "${free_flash}MB свободно" \
        || _hc "Flash" "error" "${free_flash}MB — критически мало!"
    _hc "CPU" "ok" "Load: $cpu"

    # 12. Log rotation
    local log_lines=$(wc -l < /tmp/flowvpn/singbox.log 2>/dev/null || echo 0)
    [ "$log_lines" -lt 5000 ] && _hc "Лог" "ok" "$log_lines строк" \
        || _hc "Лог" "warn" "$log_lines строк — рекомендуется очистить"

    echo "$results" | jq '.'
}

cmd_set_wifi() {
    local ssid="$1" password="$2"
    [ -z "$password" ] && { echo '{"error":"missing password"}'; return 1; }
    uci set wireless.default_radio0.encryption="psk2"
    uci set wireless.default_radio0.key="$password"
    uci set wireless.default_radio1.encryption="psk2"
    uci set wireless.default_radio1.key="$password"
    [ -n "$ssid" ] && {
        uci set wireless.default_radio0.ssid="${ssid}_2"
        uci set wireless.default_radio1.ssid="${ssid}_5"
    }
    uci commit wireless
    wifi reload >/dev/null 2>&1 &
    echo '{"status":"wifi updated"}'
}

# ============================================================
# Init
# ============================================================

if [ ! -f "$FLOWVPN_CONFIG" ]; then
    mkdir -p /etc/flowvpn
    echo '{"subscription_url":"","selected_server":0,"interface":"br-lan","auto_start":true,"mode":"all_vpn"}' | jq '.' > "$FLOWVPN_CONFIG"
    chmod 600 "$FLOWVPN_CONFIG" 2>/dev/null
fi
# Defense in depth: tighten if a previous version left it world-readable.
[ -f "$FLOWVPN_CONFIG" ] && chmod 600 "$FLOWVPN_CONFIG" 2>/dev/null

case "$1" in
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart ;;
    status)         cmd_status ;;
    set-server)     cmd_set_server "$2" ;;
    probe-server)   cmd_probe_server "$2" ;;
    update)         cmd_update ;;
    ping)           cmd_ping ;;
    auto-select)    cmd_auto_select ;;
    auto-eval)      cmd_auto_eval ;;
    set-mode)       cmd_set_mode "$2" ;;
    add-domain)     cmd_add_domain "$2" "$3" ;;
    remove-domain)  cmd_remove_domain "$2" "$3" ;;
    get-domains)    cmd_get_domains ;;
    get-devices)    cmd_get_devices ;;
    get-log)        cmd_get_log "$2" "$3" ;;
    clear-log)      > "$FLOWVPN_TMP/singbox.log"; echo '{"status":"cleared"}' ;;
    diagnose)       cmd_diagnose ;;
    healthcheck)    cmd_healthcheck ;;
    system-info)    cmd_system_info ;;
    watchdog)       cmd_watchdog "$2" ;;
    get-traffic)    cmd_get_traffic ;;
    reset-traffic)  cmd_reset_traffic ;;
    real-ping)      cmd_real_ping ;;
    get-incidents)  cmd_get_incidents ;;
    clear-incidents) cmd_clear_incidents ;;
    schedule)       cmd_schedule "$2" "$3" "$4" ;;
    auto-update)    cmd_auto_update "$2" ;;
    backup)         cmd_backup ;;
    restore)        cmd_restore "$2" ;;
    set-device)     cmd_set_device_route "$2" "$3" ;;
    remove-device)  cmd_remove_device_route "$2" ;;
    get-dns)        cmd_get_dns ;;
    set-config)     cmd_set_config "$2" "$3" ;;
    set-wifi)       cmd_set_wifi "$2" "$3" ;;
    *)
        echo "FlowVPN v4 — VPN for OpenWrt"
        echo "Usage: flowvpn {start|stop|restart|status|set-server N|update|ping}"
        echo "       flowvpn {set-mode all_vpn|blocklist}"
        echo "       flowvpn {add-domain DOMAIN direct|vpn}"
        echo "       flowvpn {remove-domain DOMAIN direct|vpn}"
        echo "       flowvpn {get-domains|get-devices|get-log|get-dns}"
        echo "       flowvpn {set-config KEY VALUE|set-wifi SSID PASSWORD}"
        ;;
esac
