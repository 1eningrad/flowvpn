#!/bin/ash
# EclipVPN 2026.06 — xray (SOCKS/XHTTP) + sing-box (tproxy/routing)
# Modes: all_vpn (everything VPN, RU direct) | blocklist (only blocked through VPN)

ECLIPVPN_VERSION="2026.06"
# Paths are overridable so the test harness (tests/) can source this file
# against the working tree + a scratch dir instead of the installed locations.
# Production passes none of these, so the defaults are unchanged.
ECLIPVPN_LIB="${ECLIPVPN_LIB:-/usr/lib/eclipvpn}"
ECLIPVPN_CONFIG="${ECLIPVPN_CONFIG:-/etc/eclipvpn/config.json}"
ECLIPVPN_TMP="${ECLIPVPN_TMP:-/tmp/eclipvpn}"

# Raise the open-files cap for everything spawned from here (daemons, watchdog,
# probe xrays). OpenWrt default is 4096; sing-box held 754 fds on an ordinary
# evening with 24 LAN clients (2026-06-10), and fd exhaustion kills xray with
# no useful log line (XKeen's most-reported crash cause). Root, so raising the
# hard limit is allowed; harmless no-op where already higher.
ulimit -n 8192 2>/dev/null

. "$ECLIPVPN_LIB/parse.sh"
. "$ECLIPVPN_LIB/subscriptions.sh"
. "$ECLIPVPN_LIB/xray.sh"
. "$ECLIPVPN_LIB/singbox.sh"
. "$ECLIPVPN_LIB/rules.sh"
. "$ECLIPVPN_LIB/network.sh"
. "$ECLIPVPN_LIB/watchdog.sh"
. "$ECLIPVPN_LIB/lifecycle.sh"
. "$ECLIPVPN_LIB/servers.sh"
. "$ECLIPVPN_LIB/domains.sh"
. "$ECLIPVPN_LIB/traffic.sh"
. "$ECLIPVPN_LIB/health.sh"
. "$ECLIPVPN_LIB/config.sh"

get_config_val() { jq -r --arg k "$1" --arg d "$2" '.[$k] // $d' "$ECLIPVPN_CONFIG"; }
flog() { logger -t eclipvpn "$*"; }
# Log an error AND emit it as the {"error":...} JSON the CLI/CGI returns, so a
# user-visible failure is never silent in the log (the recurring "ошибка есть —
# в логах пусто"). Usage: _err "message"  -> logs ERROR: ... + prints {"error":...}
_err() { flog "ERROR: $1"; jq -n -c --arg e "$1" '{error:$e}'; }
# Verbose step-trace, OFF by default. Enable without a redeploy via
# `eclipvpn set-config log_debug true` to trace e.g. a server switch step-by-step.
flogd() { [ "$(get_config_val log_debug false)" = "true" ] && logger -t eclipvpn "DEBUG: $*"; return 0; }
# Build identity — stamped into /etc/eclipvpn/build by whatever shipped the code
# (deploy.sh / install*.sh / installer.exe): "<short-sha> <commit-date> via=<tool>".
# ECLIPVPN_VERSION is a hand-set release constant and never distinguishes two
# deploys of the same release; THIS is what identifies the running build.
_build_id() { [ -f /etc/eclipvpn/build ] && head -n1 /etc/eclipvpn/build 2>/dev/null || echo "unknown"; }

# Returns the per-install Clash API secret. Generates one on first call.
# Stored in /etc/eclipvpn/clash_secret (chmod 600).
_get_clash_secret() {
    local f=/etc/eclipvpn/clash_secret
    if [ ! -s "$f" ]; then
        mkdir -p /etc/eclipvpn
        local s=""
        s=$(head -c 16 /dev/urandom 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null)
        [ -z "$s" ] && s=$(awk 'BEGIN{srand();for(i=0;i<32;i++)printf "%x",int(rand()*16)}')
        printf '%s' "$s" > "$f"
        chmod 600 "$f" 2>/dev/null
    fi
    cat "$f"
}
# Atomic config write — validates JSON before overwriting.
# chmod 600 because config.json holds the subscription URL (panel credential).
# Also keeps 3 rolling backups (config.json.1 = newest): the jq check below
# only catches syntactic damage, while history's config losses were semantic —
# valid JSON with the subscription gone (bad restore, buggy writer). Volatile
# keys that flip in normal operation (selected_server on every failover,
# running_intent on every start/stop) are excluded from the change detection
# so an evening of throttling-wave failovers doesn't flush the real-settings
# history out of the 3 slots.
# Recovery: cp /etc/eclipvpn/config.json.1 /etc/eclipvpn/config.json && eclipvpn restart 1
#
# Serialization: save_config is the WRITE half of a read-modify-write — the
# caller first reads config.json (jq), edits, then hands the result here. Two
# of those interleaving is a lost update (watchdog failover writing
# selected_server vs. a user set-mode — whoever saves last clobbers the
# other's key). So save_config must ONLY be called from update_config (below),
# which holds the config lock across BOTH the read and this write. Do not call
# save_config directly from a fresh read — that races again.
save_config() {
    local data="$1"
    printf '%s\n' "$data" > "${ECLIPVPN_CONFIG}.tmp"
    if jq '.' "${ECLIPVPN_CONFIG}.tmp" >/dev/null 2>&1; then
        chmod 600 "${ECLIPVPN_CONFIG}.tmp" 2>/dev/null
        if [ -f "$ECLIPVPN_CONFIG" ]; then
            local _old_sig _new_sig
            _old_sig=$(jq -S 'del(.selected_server, .running_intent)' "$ECLIPVPN_CONFIG" 2>/dev/null)
            _new_sig=$(jq -S 'del(.selected_server, .running_intent)' "${ECLIPVPN_CONFIG}.tmp" 2>/dev/null)
            if [ "$_old_sig" != "$_new_sig" ]; then
                mv -f "${ECLIPVPN_CONFIG}.2" "${ECLIPVPN_CONFIG}.3" 2>/dev/null
                mv -f "${ECLIPVPN_CONFIG}.1" "${ECLIPVPN_CONFIG}.2" 2>/dev/null
                # cp, not mv — config.json must never be absent even briefly,
                # concurrent readers (CGI status polls) race this function.
                cp "$ECLIPVPN_CONFIG" "${ECLIPVPN_CONFIG}.1" 2>/dev/null
                chmod 600 "${ECLIPVPN_CONFIG}.1" 2>/dev/null
            fi
        fi
        mv "${ECLIPVPN_CONFIG}.tmp" "$ECLIPVPN_CONFIG"
    else
        rm -f "${ECLIPVPN_CONFIG}.tmp"
        flog "ERROR: invalid JSON, config not saved"
        return 1
    fi
}

# --- unified lock primitive --------------------------------------------------
# One symlink-PID mutex behind BOTH the op-lock (lifecycle ops, try-once) and
# the config-write lock (read-modify-write of config.json, wait). A symlink
# whose TARGET is the owner PID: `ln -s "$$"` creates-if-absent (atomic acquire)
# AND records the owner in the same syscall, so there is no "lock created but
# owner not yet recorded" window for a second arrival to misread as stale and
# steal — the bug that let two cmd_starts through the old mkdir + separate-PID-
# file op-lock. Stale reclaim (owner PID dead) is serialized under a per-lock
# reclaim dir so two waiters can't both rm+recreate. A crash right after `ln`
# still leaves the dead PID in the symlink target on disk, so a stale .lock
# symlink is always reclaimable. CAVEAT (review #4): a crash BETWEEN `mkdir
# $rlock` and its `rmdir` (the reclaim window) orphans the reclaim dir — then
# `_lock_try`'s reclaim branch is permanently disabled (its `mkdir` always
# fails). The config lock (wait mode) still recovers via the ~10s force-steal;
# the op lock (try mode, no force-steal) can WEDGE — every lifecycle op then
# reports "operation in progress" until /tmp is wiped on reboot or a deploy
# rm -rf's op.reclaim.lockdir. Low-probability (tiny window), recoverable, and
# pre-dates this unify — documented, not yet guarded.
#
#   _lock_acquire NAME        try once: 0 = acquired, 1 = held by a LIVE owner
#   _lock_acquire NAME wait   block until acquired; force-steal a wedged holder
#                             after ~10s (always 0 — dropping a write is worse)
#   _lock_release NAME        drop it
#
# NOT reentrant. watchdog.lockdir and auto.lock deliberately stay on their own
# primitives: the watchdog lock has external PID-file consumers (init.d,
# deploy.sh) and a distinct "I'm a duplicate, exit" semantic, and auto.lock
# relies on flock's auto-release-on-subshell-exit in the auto-select rollback.
_lock_try() {
    # One acquire+reclaim cycle. 0 = got it, 1 = held by a live owner.
    local lock="$1" rlock="$2"
    ln -s "$$" "$lock" 2>/dev/null && return 0
    if mkdir "$rlock" 2>/dev/null; then
        local owner; owner=$(readlink "$lock" 2>/dev/null)
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            rm -f "$lock"
            ln -s "$$" "$lock" 2>/dev/null && { rmdir "$rlock" 2>/dev/null; return 0; }
        fi
        rmdir "$rlock" 2>/dev/null
    fi
    return 1
}
_lock_acquire() {
    local name="$1" mode="${2:-try}"
    local lock="$ECLIPVPN_TMP/$name.lock" rlock="$ECLIPVPN_TMP/$name.reclaim.lockdir"
    mkdir -p "$ECLIPVPN_TMP"
    _lock_try "$lock" "$rlock" && return 0
    [ "$mode" = "wait" ] || return 1
    local tries=0
    while ! _lock_try "$lock" "$rlock"; do
        tries=$((tries + 1))
        if [ "$tries" -ge 10 ]; then
            # Wedged holder — steal and proceed; dropping a write is worse.
            rm -f "$lock"; ln -s "$$" "$lock" 2>/dev/null
            flog "WARN: $name lock forced after timeout"
            return 0
        fi
        sleep 1
    done
    return 0
}
_lock_release() { rm -f "$ECLIPVPN_TMP/$1.lock"; }

# Serialized read-modify-write of config.json. Every config mutation here is
# `read (jq reads config.json) -> edit -> write (save_config)`; two interleaving
# silently lose one writer's change (watchdog selected_server failover vs. a
# user cmd_set_*/cmd_sub — whichever saves last wins). update_config holds the
# config lock across BOTH the read and the write, so the whole RMW is atomic
# against every other writer that also goes through here — the ONLY safe way to
# mutate config concurrently with the watchdog.
#
#   update_config '<jq program>' [jq args...]
#
# The jq program receives the CURRENT config as input; its output is saved.
# Pass values as jq args (--arg/--argjson). Returns save_config's status (1 on
# jq or save failure; the lock is always released). NON-REENTRANT.
_config_lock()   { _lock_acquire config wait; }
_config_unlock() { _lock_release config; }
update_config() {
    local prog="$1"; shift
    _config_lock
    local cur new
    cur=$(cat "$ECLIPVPN_CONFIG" 2>/dev/null)
    # save_config writes atomically (mv), so config.json should never read
    # empty. An empty read is a transient (e.g. read raced a swap under heavy
    # concurrency) — retry once, then bail WITHOUT feeding jq empty input
    # (which silently produces no output and looks like a program bug).
    [ -z "$cur" ] && cur=$(cat "$ECLIPVPN_CONFIG" 2>/dev/null)
    if [ -z "$cur" ]; then
        _config_unlock
        flog "ERROR: update_config: config.json empty/unreadable — write skipped (prog: $prog)"
        return 1
    fi
    new=$(printf '%s' "$cur" | jq "$@" "$prog" 2>/dev/null)
    if [ -z "$new" ]; then
        _config_unlock
        # Name the jq program so the Errors tab points at the exact failed
        # write (bad --arg/--argjson, program bug), not an anonymous line.
        flog "ERROR: update_config: jq produced no output for: $prog"
        return 1
    fi
    save_config "$new"
    local rc=$?
    _config_unlock
    return $rc
}

# ============================================================
# Core commands
# ============================================================

# Operation lock — held while a user-initiated lifecycle command (start, stop,
# restart, set-server, set-mode) is in flight. Lifecycle commands can arrive
# simultaneously (init.d's S99eclipvpn races with the UI's "включить" button on
# a slow boot, or the watchdog reviver fires on a borderline tick); two
# concurrent cmd_starts both acquiring would leave two xray processes fighting
# for 127.0.0.1:1080. Try-once on the shared symlink-PID _lock (no wait — a
# second lifecycle op is rejected, not queued). The op.in_progress PID file is
# written alongside for the watchdog's deferral check (it only needs "is an op
# in flight"). Returns 0 on acquire, 1 if another LIVE owner holds it.
_op_begin() {
    _lock_acquire op || return 1
    echo $$ > "$ECLIPVPN_TMP/op.in_progress"
    return 0
}
_op_end() {
    rm -f "$ECLIPVPN_TMP/op.in_progress"
    _lock_release op
}

_ensure_watchdog() {
    # Watchdog handles log rotation, auto-recovery, and auto-failover. It is
    # the only place log rotation runs, so losing it silently lets logs grow
    # unbounded (40k-line floods seen on SevenSky 2026-04-29).
    #
    # Idempotency check is by process scan, not by lock file. The lock-file
    # path turned out to be unreliable: init.d used to spawn its own watchdog
    # in parallel with cmd_start's, racing on the lock and leaving a state
    # where the lock was empty/missing while a watchdog was alive — every
    # subsequent _ensure_watchdog call then spawned a duplicate.
    # `pgrep -f 'eclipvpn watchdog'` would match itself — the pgrep process'
    # own cmdline contains the substring it's searching for, so it always
    # returned 0 and we never spawned. Using ps+grep with the classic
    # `[/]` character-class self-exclusion trick: the grep cmdline contains
    # `[/]usr/bin/eclipvpn watchdog`, which includes the substring
    # `]usr/bin/...` (no leading `/`), so the regex `/usr/bin/eclipvpn watchdog`
    # does not match grep itself. Real watchdog cmdline
    # `/bin/ash /usr/bin/eclipvpn watchdog` does match.
    if ps w 2>/dev/null | grep -q '[/]usr/bin/eclipvpn watchdog$'; then
        return 0
    fi
    /usr/bin/eclipvpn watchdog >/dev/null 2>&1 &
    echo $! > "$ECLIPVPN_TMP/watchdog.pid"
}

# Cron-driven "supervisor for the supervisor" (*/5 line tagged #eclipvpn-watch,
# maintained by _ensure_cron_state). The watchdog is the only thing reviving
# dead daemons and rotating logs, but until this command nothing revived the
# watchdog ITSELF — an OOM-killed watchdog silently lost failover and rotation
# until the next manual start/restart, potentially for weeks.
# Gated on running_intent: init.d stop kills the watchdog deliberately (and
# its cmd_stop call clears the intent), so a dead watchdog must then STAY dead.
cmd_ensure_watchdog() {
    [ "$(get_config_val running_intent false)" = "true" ] || return 0
    _ensure_watchdog
}

# Mirror VPN server IPs into zapret's user-exclude list. Without this,
# zapret's NFQUEUE postrouting hook fragments xray's TLS/Reality
# ClientHello to the VPN endpoint and the handshake fails (Reality
# rejects malformed ClientHello). No-op if zapret isn't installed; the
# write+restart is skipped when the list is unchanged so cron-driven
# `eclipvpn update` (returns the same servers most of the time) doesn't
# churn zapret.
_sync_zapret_exclude() {
    local exclude_file="/opt/zapret/ipset/zapret-ip-user-exclude.txt"
    [ -d /opt/zapret ] && [ -f "$ECLIPVPN_TMP/servers.json" ] || return 0

    local new_list current=""
    new_list=$(jq -r '.[].host // empty' "$ECLIPVPN_TMP/servers.json" 2>/dev/null | sort -u)
    [ -z "$new_list" ] && return 0
    [ -f "$exclude_file" ] && current=$(cat "$exclude_file")
    [ "$new_list" = "$current" ] && return 0

    printf '%s\n' "$new_list" > "$exclude_file"
    /etc/init.d/zapret restart >/dev/null 2>&1
    flog "synced VPN IPs to zapret exclude"
}

_rotate_log() {
    # Size-based rotation with copytruncate semantics.
    # Earlier version did `tail > tmp && mv tmp file`. Rename swaps inode —
    # sing-box and xray hold an open fd on the original inode, so the new
    # file is invisible to them; subsequent log lines get written into the
    # now-orphaned, unlinked file (`/proc/PID/fd/1 → file (deleted)`) and
    # never appear in the journal. Effect: UI's log went silent ~1h after
    # the first rotation.
    #
    # Fix: tail-into-temp, then `cat tmp > file` writes through the same
    # file descriptor that the daemons hold — truncate-then-overwrite
    # preserves the inode.
    local max_lines=2000 keep_lines=500
    for logfile in "$ECLIPVPN_TMP/singbox.log" "$ECLIPVPN_TMP/xray.log"; do
        [ -f "$logfile" ] || continue
        local lines=$(wc -l < "$logfile" 2>/dev/null)
        [ -z "$lines" ] && continue
        if [ "$lines" -gt "$max_lines" ]; then
            local tmp="${logfile}.rot"
            if tail -n "$keep_lines" "$logfile" > "$tmp" 2>/dev/null; then
                cat "$tmp" > "$logfile"  # truncate+write — keeps inode, daemons keep writing
                rm -f "$tmp"
                # Rotation is housekeeping, not an event — silenced because it
                # was 80% of syslog eclipvpn output, drowning real switches/errors
                # in the EclipVPN tab of the log viewer.
            fi
        fi
    done
}





# ============================================================
# Info commands
# ============================================================






# ============================================================
# Watchdog — auto-failover
# ============================================================

# ============================================================
# Proxy-engine abstraction (multi-protocol)
# ============================================================
# A server's protocol decides which binary actually dials the exit:
#   - vless / vmess / trojan / shadowsocks → xray (shared SOCKS:1080 frontend;
#     sing-box's "default" outbound is socks→xray).
#   - hysteria2 → xray CAN'T speak it (QUIC). sing-box dials it NATIVELY as its
#     "default" outbound and ALSO exposes SOCKS:1080 itself, so xray is not run
#     at all and every probe/health path that curls 127.0.0.1:1080 keeps working
#     unchanged (sing-box owns 1080 in that mode; xray owns it otherwise).
# These four helpers are the single source of truth for that decision — used by
# lifecycle (start/restart/status), servers (probe/auto), watchdog, domains,
# config and health. Resolved at call time, so they may reference is_*_running
# (xray.sh/singbox.sh) freely.

# Which engine runs $1. Echoes "xray" or "singbox". Empty/unknown ⇒ xray.
_engine_for_protocol() {
    case "$1" in
        hysteria2) echo "singbox" ;;
        *)         echo "xray" ;;
    esac
}

# Protocol of server index $1 in servers.json (default "vless" when absent —
# an out-of-range index or missing field both fall through // "vless").
_server_protocol() {
    [ -f "$ECLIPVPN_TMP/servers.json" ] || { echo "vless"; return; }
    jq -r --argjson i "$1" '(.[$i].protocol // "vless")' "$ECLIPVPN_TMP/servers.json" 2>/dev/null || echo "vless"
}

# Engine for the currently-selected server.
_selected_engine() {
    _engine_for_protocol "$(_server_protocol "$(get_config_val selected_server 0)")"
}

# Is the VPN tunnel up? Engine-aware. For a hysteria2 server the single sing-box
# process IS the entire tunnel (no xray); for xray-engine protocols both xray
# (SOCKS:1080) and sing-box (tproxy/routing) must be alive. This REPLACES the
# old bare `is_xray_running && is_singbox_running` everywhere — using
# is_xray_running directly on a hysteria2 server reports "down" forever (xray
# never runs), which would make the watchdog revive in a loop and the UI show
# the VPN as stopped.
_vpn_running() {
    if [ "$(_selected_engine)" = "singbox" ]; then
        is_singbox_running
    else
        is_xray_running && is_singbox_running
    fi
}

# Is ANY tunnel daemon currently up, regardless of which engine the *selected*
# server would use? Use this — NOT _vpn_running — to decide "should I restart to
# apply a change" right AFTER selected_server may have changed (cmd_set_server,
# cmd_auto_select). _vpn_running keys off the just-saved server's engine, so
# switching off a live Hysteria2 server (sing-box only) to an xray server makes
# it evaluate is_xray_running (false) and the switch silently no-ops / collides.
# sing-box runs in both engines and xray only in the xray engine, so the OR
# covers a live tunnel of either kind.
_vpn_live() {
    is_singbox_running || is_xray_running
}

# --- make-before-break: active / staged xray SOCKS port ----------------------
# A server switch STAGES the new xray on the alternate SOCKS port, verifies it,
# then has sing-box adopt it — so the active xray port rotates 1080<->1081 across
# switches. $ECLIPVPN_TMP/xray_port holds the active xray's port (absent => 1080).
_active_xray_port() { cat "$ECLIPVPN_TMP/xray_port" 2>/dev/null || echo 1080; }

# Port that health/probe code should curl to reach the LIVE tunnel's SOCKS:
# hysteria2 => sing-box owns 1080; xray => the active xray port.
_active_socks_port() {
    if [ "$(_selected_engine)" = "singbox" ]; then echo 1080; else _active_xray_port; fi
}

# THE single direct→tunnel fetch primitive. Every router-ORIGINATED download
# (subscriptions, blocklist lists, .srs rule-sets) must go through this so none
# can silently miss the fallback — the bug that left blocklist + RU-direct dead
# (the router's own traffic bypasses tproxy/mark 0x8000 and exits the raw WAN,
# which blackholes GitHub on some uplinks like MTS, while the VPN exit reaches
# it fine). Fetch <url> → <dest> DIRECT; if that fails AND the tunnel is up,
# retry through the live SOCKS exit. Always FILE-based (-o): binary-safe for the
# .srs blobs and never buffers a multi-MB body in a shell var. Extra curl args
# (auth headers, --dump-header) pass through via "$@"; --max-filesize caps RAM.
# Short direct timeout (10s) so a blackholed WAN fails fast before the retry.
# The CALLER validates the result file (parseable / line count / SRS magic) and
# passes any per-fetch flags via "$@" — notably `-L` (follow redirects: the
# blocklist IP lists 302 through github releases and NEED it; subscriptions
# deliberately do NOT, to inspect a panel's landing-page redirect themselves).
# This owns transport only. Returns the winning attempt's curl rc (0 = ok).
_router_fetch() {
    local url="$1" dest="$2"; shift 2
    local rc
    curl -fsS --max-time 10 --max-filesize 8000000 "$@" -o "$dest" "$url" 2>/dev/null; rc=$?
    if [ "$rc" -ne 0 ] && _vpn_running 2>/dev/null; then
        curl -fsS --max-time 40 --max-filesize 8000000 \
            --socks5-hostname "127.0.0.1:$(_active_socks_port)" "$@" -o "$dest" "$url" 2>/dev/null; rc=$?
    fi
    return "$rc"
}

# The alternate xray port to STAGE a new exit on, given the current active xray
# port and the OLD tunnel's engine. Old hysteria2 owns 1080 => stage on 1081;
# otherwise whichever of 1080/1081 the live xray is not using.
_stage_xray_port() {
    local active="$1" old_engine="$2"
    [ "$old_engine" = "singbox" ] && { echo 1081; return; }
    [ "$active" = "1081" ] && echo 1080 || echo 1081
}

# --- direct-path DNS: resolver list + bounded probe ---------------------------
# `dns-direct` used to be one hardcoded server (Yandex 77.88.8.8). That is a
# single point of failure for EVERY direct-path lookup: under a CGNAT that
# hijacks UDP/53 (SevenSky) it dies, and with it resolution of all RU sites.
# `dns_direct_servers` is an ordered fallback list; the watchdog promotes the
# first one that answers and records it in $ECLIPVPN_TMP/dns_direct_active.
#
# Do NOT "modernize" the default to Cloudflare: VTB and a few other RU banks
# run authoritative NS that refuse foreign resolvers, so 1.1.1.1 SERVFAILs
# them. Both defaults are Yandex for that reason (.8 primary, .1 secondary).
_dns_direct_list() {
    local raw ip out=""
    raw=$(get_config_val dns_direct_servers "")
    [ -z "$raw" ] && { echo "77.88.8.8 77.88.8.1"; return; }
    local IFS=,
    for ip in $raw; do
        ip=$(printf '%s' "$ip" | tr -d ' ')
        [ -n "$ip" ] && out="$out $ip"
    done
    [ -n "$out" ] && echo "${out# }" || echo "77.88.8.8 77.88.8.1"
}

# The resolver the generator should emit as `dns-direct`. The persisted choice
# wins ONLY while it is still a member of the configured list — otherwise an
# edit to dns_direct_servers would be silently ignored until the next failover.
_active_dns_direct() {
    local saved list first
    list=$(_dns_direct_list)
    first=${list%% *}
    saved=$(cat "$ECLIPVPN_TMP/dns_direct_active" 2>/dev/null)
    [ -n "$saved" ] || { echo "$first"; return; }
    local ip
    for ip in $list; do
        [ "$ip" = "$saved" ] && { echo "$saved"; return; }
    done
    echo "$first"
}

# Bounded "does this resolver answer" probe. There is NO `timeout` binary on
# this busybox and NO sub-second sleep, and busybox `nslookup` against a
# blackholed resolver hangs for far longer than a watchdog tick — so run it in
# the background and reap it with the same netstat-paced busy-poll used by
# start_singbox/stop_singbox (the netstat call is what paces the loop).
# Args: RESOLVER_IP [MAX_ITERS=120 (~3-5s)]. Returns 0 when it answered.
_dns_probe() {
    local ip="$1" max="${2:-120}" pid n=0
    [ -n "$ip" ] || return 1
    nslookup ya.ru "$ip" >/dev/null 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        n=$((n + 1))
        [ "$n" -ge "$max" ] && { kill -9 "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; return 1; }
        netstat -tn >/dev/null 2>&1
    done
    wait "$pid" 2>/dev/null
}

# Per-domain resolver overrides: `dns_overrides` is "domain=ip" pairs, comma
# separated (e.g. "vtb.ru=77.88.8.8"). Emits one "domain<TAB>ip" line per pair.
# Motivation: the global Yandex hardcode above exists to satisfy ONE class of
# domains (RU banks). With overrides that becomes a config line instead of a
# code change, and the global default is free to be whatever resolves best.
_dns_overrides_pairs() {
    local raw pair dom ip
    raw=$(get_config_val dns_overrides "")
    [ -z "$raw" ] && return 0
    local IFS=,
    for pair in $raw; do
        pair=$(printf '%s' "$pair" | tr -d ' ')
        case "$pair" in *=*) ;; *) continue ;; esac
        dom=${pair%%=*}
        ip=${pair##*=}
        [ -n "$dom" ] && [ -n "$ip" ] && printf '%s\t%s\n' "$dom" "$ip"
    done
}

# A server is "metered" (RU-safe, mobile-carrier) when its name contains
# carrier markers. Such servers give a Russian IP, so watchdog must NEVER
# auto-switch to them — doing so defeats the purpose of a VPN.
_is_metered_server() {
    local name="$1"
    # "Обход …" entries are CDN-fronted bypass relays — they exit via a foreign
    # server through a RU CDN; the carrier in the name is which carrier they're
    # tuned for, NOT a metered mobile exit handing back a Russian IP. So they
    # must NOT be skipped from auto-select / watchdog failover the way real
    # metered exits (МТС/Т2/Билайн/Мегафон *location* servers) are.
    case "$name" in
        *Обход*|*обход*) return 1 ;;
    esac
    case "$name" in
        *МТС*|*мтс*|*MTS*|*mts*) return 0 ;;
        *Т2*|*т2*|*Tele2*|*tele2*) return 0 ;;
        *Билайн*|*билайн*|*Beeline*|*beeline*) return 0 ;;
        *Мегафон*|*мегафон*|*Megafon*|*megafon*) return 0 ;;
    esac
    return 1
}

# --- user mute list ---------------------------------------------------
# `muted_servers` is a comma-separated list of case-sensitive NAME substrings
# (same semantics as server_filter). A matching server is hidden from the
# AUTOMATIC pickers only — auto-select, auto-eval and watchdog failover skip
# it — while `set-server` still selects it by hand and an already-selected
# muted server keeps running. Motivating case: the CDN-fronted "Обход" relays
# are billed per traffic, so they must not be switched on behind the user's
# back, but they still have to be one click away when the throttle bites.
#
# Empty by default: nothing is muted unless the user says so.
#
# Matching is `case` globbing with the token quoted (literal, no glob), never a
# regex — this mirrors _apply_server_filter's jq `contains`, and the router's jq
# has no Oniguruma (see parse.sh).
#
# The token list is passed IN rather than read from config here: every caller
# loops over the whole pool, and a get_config_val per server would mean a jq
# spawn per server (~50ms each on a 100+ node pool).
_name_has_token() {
    local name="$1" toks="$2" tok rest
    [ -n "$toks" ] || return 1
    rest="$toks"
    while [ -n "$rest" ]; do
        case "$rest" in
            *,*) tok="${rest%%,*}"; rest="${rest#*,}" ;;
            *)   tok="$rest"; rest="" ;;
        esac
        [ -n "$tok" ] || continue
        case "$name" in *"$tok"*) return 0 ;; esac
    done
    return 1
}

# Read the mute token list once, before a scan loop.
_muted_tokens() { get_config_val muted_servers ""; }

# True when the automatic pickers must skip this server.
# $1 = server name, $2 = muted token list (from _muted_tokens).
#
# NB metered and muted are NOT the same skip. Metered (МТС/Т2/…) is a
# CORRECTNESS skip — those exits hand back a Russian IP and defeat the VPN, so
# they are never auto-picked, not even in the emergency pass. Muted is a COST
# skip, and the emergency pass in cmd_auto_select / cmd_auto_eval /
# _watchdog_pick_best deliberately lifts it when nothing else answers: no
# connection at all is worse than a billed one.
_is_auto_skipped() {
    _is_metered_server "$1" && return 0
    _name_has_token "$1" "$2"
}

# --- measured exit country ----------------------------------------------------
# Name matching cannot tell `Россия (прямой)` (RU exit) from `Россия → Финляндия`
# (RU entry, FI exit), and _is_metered_server only knows carrier names — so on
# 2026-08-30 the emergency failover landed on a Selectel-RU exit: a "working"
# tunnel with no VPN at all. The fix is to classify by the MEASURED exit, not
# the name: every automatic picker asks the candidate's throwaway probe engine
# where it actually comes out, and drops it if that country is blocked.
#
# _exit_country PORT — the exit's ISO-3166 alpha-2 country (uppercase) as seen
# by Cloudflare through SOCKS:PORT, or empty if unknown. cdn-cgi/trace answers
# on any CF-fronted host; cp.cloudflare.com is the host the probes already use,
# so no third-party geo-IP service and no new dependency is involved.
_exit_country() {
    local loc
    loc=$(curl -s --socks5-hostname "127.0.0.1:$1" --max-time 5 \
          https://cp.cloudflare.com/cdn-cgi/trace 2>/dev/null \
          | sed -n 's/^loc=//p' | head -n1 | tr 'a-z' 'A-Z')
    case "$loc" in [A-Z][A-Z]) echo "$loc" ;; esac
}

# Comma-separated blocked exit countries from config `blocked_exit_countries`.
# Key absent ⇒ "RU" (the default protection); explicitly cleared (stored as "")
# ⇒ empty ⇒ the check is off. get_config_val's `//` keeps "" (jq only falls
# back on null/false), which is exactly what makes "cleared" distinguishable.
_blocked_exit_countries() { get_config_val blocked_exit_countries "RU"; }

# _country_blocked CC LIST — true if CC is in the comma list. PURE (the list is
# passed in, never read here — callers loop the pool, same rule as the mute
# matcher). An UNKNOWN country (empty CC: trace failed, CF unreachable through
# that exit) is deliberately NOT blocked: failing closed would let a Cloudflare
# hiccup veto every candidate and turn a recoverable outage into no tunnel.
_country_blocked() {
    local cc="$1" list="$2" tok rest
    [ -n "$cc" ] && [ -n "$list" ] || return 1
    rest="$list"
    while [ -n "$rest" ]; do
        case "$rest" in
            *,*) tok="${rest%%,*}"; rest="${rest#*,}" ;;
            *)   tok="$rest"; rest="" ;;
        esac
        [ "$tok" = "$cc" ] && return 0
    done
    return 1
}

# --- persistent diagnostic state --------------------------------------------
# incidents.json and last_switch.json are the failover JOURNAL — the only record
# of why the tunnel moved and when. They live in $ECLIPVPN_TMP, which /tmp wipes
# on every reboot, so a power cut erased exactly the evidence needed to explain
# the outage that may have caused it (an emergency failover onto a RU exit was
# diagnosed from these files on 2026-08-30 and would have been unreconstructible
# after a reboot). Mirror them into /etc next to the subcache, same contract:
# atomic .tmp + mv + sync, since this is the copy that must survive a power cut.
#
# Deliberately only these two. traffic_state.json is rewritten on EVERY traffic
# poll — mirroring it would hammer the flash overlay for data that is worthless
# after a reboot anyway. Incidents are written a handful of times a day.
_state_mirror_dir() {
    echo "$(dirname "${ECLIPVPN_CONFIG:-/etc/eclipvpn/config.json}")/state"
}

# Mirror one $ECLIPVPN_TMP state file to the persistent dir. Best-effort: a full
# or read-only overlay must never break the caller (an incident write is the
# LAST thing that should abort a failover).
_mirror_state() {
    local bn="$1" dir src
    dir=$(_state_mirror_dir)
    src="$ECLIPVPN_TMP/$bn"
    [ -s "$src" ] || return 0
    mkdir -p "$dir" 2>/dev/null || return 0
    cp "$src" "$dir/$bn.tmp" 2>/dev/null && mv "$dir/$bn.tmp" "$dir/$bn" 2>/dev/null && sync 2>/dev/null
    rm -f "$dir/$bn.tmp" 2>/dev/null
    return 0
}

# Reconcile /tmp and the persistent mirror, in whichever direction is missing:
#   mirror present, /tmp gone   -> refill /tmp  (the reboot case)
#   /tmp present, mirror gone   -> seed the mirror (the UPGRADE case)
# Never clobber a file that already exists on either side — a fresher /tmp copy
# wins (same rule as _restore_subcache), and an existing mirror is authoritative
# history that a truncated /tmp must not overwrite.
#
# The seeding half matters exactly once per install, but it matters: without it
# the journal that existed BEFORE this feature shipped would sit in /tmp
# unmirrored and die at the next reboot — including the very incident that
# motivated the mirror.
_restore_state() {
    local dir bn
    dir=$(_state_mirror_dir)
    mkdir -p "$ECLIPVPN_TMP" 2>/dev/null
    for bn in incidents.json last_switch.json; do
        if [ -s "$dir/$bn" ]; then
            [ -s "$ECLIPVPN_TMP/$bn" ] || cp "$dir/$bn" "$ECLIPVPN_TMP/$bn" 2>/dev/null
        elif [ -s "$ECLIPVPN_TMP/$bn" ]; then
            _mirror_state "$bn"
        fi
    done
}

_record_switch() {
    local from_idx="$1" to_idx="$2" reason="$3"
    local from_name=$(jq -r ".[$from_idx].name // \"\"" "$ECLIPVPN_TMP/servers.json" 2>/dev/null)
    local to_name=$(jq -r ".[$to_idx].name // \"\"" "$ECLIPVPN_TMP/servers.json" 2>/dev/null)
    jq -n --arg from "$from_name" --arg to "$to_name" --arg reason "$reason" \
        --argjson ts "$(date +%s)" \
        '{time:$ts, from:$from, to:$to, reason:$reason}' \
        > "$ECLIPVPN_TMP/last_switch.json" 2>/dev/null
    _mirror_state last_switch.json
}

# Record a server-stability incident. Stored as a JSON array (last 200) keyed
# by host so renumbering after an `update` doesn't lose history. Read by
# cmd_get_incidents and rendered in the UI as per-server fail badges + history.
_log_incident() {
    local type="$1" host="$2" name="$3" detail="$4"

    # Suppress incidents while a user-initiated lifecycle op is in flight
    # (deploy.sh, manual eclipvpn restart, UI restart button, set-server).
    # The owner process — whose PID is in op.in_progress — is allowed to
    # log its own diagnostics: cmd_restart's test_xray miss IS something
    # the operator wants to see. But watchdog probing concurrently with a
    # restart shouldn't pollute the journal with "switch_failed" entries
    # whose root cause is just "we were mid-restart". Self-vs-other check
    # by PID lets cmd_restart still record its own failures.
    local op_marker="$ECLIPVPN_TMP/op.in_progress"
    if [ -f "$op_marker" ]; then
        local op_pid
        op_pid=$(cat "$op_marker" 2>/dev/null)
        if [ -n "$op_pid" ] && [ "$op_pid" != "$$" ] && kill -0 "$op_pid" 2>/dev/null; then
            return 0
        fi
    fi

    local f="$ECLIPVPN_TMP/incidents.json"
    mkdir -p "$ECLIPVPN_TMP"
    [ -f "$f" ] || echo '[]' > "$f"
    local tmp="$f.tmp.$$"
    jq --arg type "$type" --arg host "$host" --arg name "$name" --arg detail "$detail" \
       --argjson ts "$(date +%s)" \
       '. + [{ts:$ts, type:$type, host:$host, server:$name, detail:$detail}] | .[-200:]' \
       "$f" > "$tmp" 2>/dev/null && mv "$tmp" "$f" || rm -f "$tmp"
    _mirror_state incidents.json
}



