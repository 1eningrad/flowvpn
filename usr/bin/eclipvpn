# Sourced by the test harness (ECLIPVPN_SOURCE_ONLY=1)? All functions and libs
# are defined by now — stop here, before config init and the dispatch case, so
# tests can call any function in isolation without side effects.
[ -n "${ECLIPVPN_SOURCE_ONLY:-}" ] && return 0 2>/dev/null

if [ ! -f "$ECLIPVPN_CONFIG" ]; then
    mkdir -p /etc/eclipvpn
    echo '{"subscription_url":"","subscriptions":[],"selected_server":0,"interface":"br-lan","auto_start":true,"mode":"all_vpn"}' | jq '.' > "$ECLIPVPN_CONFIG"
    chmod 600 "$ECLIPVPN_CONFIG" 2>/dev/null
fi
# Defense in depth: tighten if a previous version left it world-readable.
[ -f "$ECLIPVPN_CONFIG" ] && chmod 600 "$ECLIPVPN_CONFIG" 2>/dev/null
# Migrate a legacy single subscription_url into subscriptions[] (idempotent).
_migrate_subscriptions

case "$1" in
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart "$2" ;;
    status)         cmd_status ;;
    set-server)     cmd_set_server "$2" ;;
    probe-server)   cmd_probe_server "$2" ;;
    mute-server)    cmd_mute_server "$2" ;;
    unmute-server)  cmd_unmute_server "$2" ;;
    sub)            cmd_sub "$2" "$3" "$4" ;;
    update)         cmd_update ;;
    ping)           cmd_ping ;;
    auto-select)    cmd_auto_select ;;
    auto-eval)      cmd_auto_eval ;;
    set-mode)       cmd_set_mode "$2" ;;
    add-domain)     cmd_add_domain "$2" "$3" ;;
    remove-domain)  cmd_remove_domain "$2" "$3" ;;
    get-domains)    cmd_get_domains ;;
    preset)         cmd_preset "$2" "$3" ;;
    get-devices)    cmd_get_devices ;;
    get-log)        cmd_get_log "$2" "$3" ;;
    clear-log)
        # Truncate the two files we own and stamp a "cleared" marker so
        # cmd_get_log can hide everything older from syslog (the syslog
        # ringbuffer is router-wide and cannot be selectively cleared).
        > "$ECLIPVPN_TMP/singbox.log"
        > "$ECLIPVPN_TMP/xray.log"
        date +%s > "$ECLIPVPN_TMP/log_cleared_ts"
        echo '{"status":"cleared"}'
        ;;
    diagnose)       cmd_diagnose ;;
    healthcheck)    cmd_healthcheck ;;
    net-check)      cmd_net_check ;;
    system-info)    cmd_system_info ;;
    watchdog)       cmd_watchdog "$2" ;;
    ensure-watchdog) cmd_ensure_watchdog ;;
    get-traffic)    cmd_get_traffic ;;
    traffic-poll)   cmd_traffic_poll ;;
    reset-traffic)  cmd_reset_traffic ;;
    real-ping)      cmd_real_ping ;;
    get-incidents)  cmd_get_incidents ;;
    clear-incidents) cmd_clear_incidents ;;
    schedule)       cmd_schedule "$2" "$3" "$4" ;;
    auto-update)    cmd_auto_update "$2" ;;
    backup)         cmd_backup ;;
    restore)        cmd_restore "$2" ;;
    set-device)     cmd_set_device_route "$2" "$3" ;;
    remove-device)  cmd_remove_device_route "$2" ;;
    get-dns)        cmd_get_dns ;;
    set-config)     cmd_set_config "$2" "$3" ;;
    set-wifi)       cmd_set_wifi "$2" "$3" ;;
    *)
        # Keep in sync with the dispatch arms above (internal watchdog /
        # ensure-watchdog are deliberately omitted).
        cat <<EOF
EclipVPN $ECLIPVPN_VERSION — VPN for OpenWrt (build $(_build_id))
Usage: eclipvpn COMMAND [ARGS]

Lifecycle:
  start | stop | status
  restart [1]                      1 = force, even if the config is unchanged
Servers:
  set-server N | probe-server N    select / test server N (merged pool index)
  mute-server N | unmute-server N  hide / show N for automatic picking
  auto-select | auto-eval          pick fastest / re-check the live server
  ping | real-ping                 TCP latency / real request through the tunnel
Subscriptions:
  sub list | add URL [NAME] | remove ID | enable ID | disable ID
  sub rename ID NAME | filter ID TOKENS|off
  update                           refresh subscriptions + routing rules
Routing:
  set-mode all_vpn|blocklist
  add-domain DOM vpn|direct | remove-domain DOM vpn|direct | get-domains
  preset list | enable NAME | disable NAME
  get-devices | set-device ID vpn|direct | remove-device ID
Diagnostics:
  diagnose | healthcheck | net-check | system-info | get-dns
  get-log [N] [all|vpn|direct|error|dns|flow] | clear-log
  get-traffic | traffic-poll | reset-traffic
  get-incidents | clear-incidents
Settings:
  set-config KEY VALUE | set-wifi SSID PASSWORD
  schedule set ON OFF | disable | get
  auto-update enable|disable|status
  backup | restore JSON
EOF
        ;;
esac
