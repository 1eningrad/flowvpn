#!/bin/ash
# EclipVPN 2026.06 — xray (SOCKS/XHTTP) + sing-box (tproxy/routing)
# Modes: all_vpn (everything VPN, RU direct) | blocklist (only blocked through VPN)

ECLIPVPN_VERSION="2026.06"
ECLIPVPN_LIB="/usr/lib/eclipvpn"
ECLIPVPN_CONFIG="/etc/eclipvpn/config.json"
ECLIPVPN_TMP="/tmp/eclipvpn"

# Raise the open-files cap for everything spawned from here (daemons, watchdog,
# probe xrays). OpenWrt default is 4096; sing-box held 754 fds on an ordinary
# evening with 24 LAN clients (2026-06-10), and fd exhaustion kills xray with
# no useful log line (XKeen's most-reported crash cause). Root, so raising the
# hard limit is allowed; harmless no-op where already higher.
ulimit -n 8192 2>/dev/null

. "$ECLIPVPN_LIB/parse.sh"
. "$ECLIPVPN_LIB/xray.sh"
. "$ECLIPVPN_LIB/singbox.sh"
. "$ECLIPVPN_LIB/network.sh"
. "$ECLIPVPN_LIB/watchdog.sh"
. "$ECLIPVPN_LIB/lifecycle.sh"
. "$ECLIPVPN_LIB/servers.sh"
. "$ECLIPVPN_LIB/domains.sh"

get_config_val() { jq -r --arg k "$1" --arg d "$2" '.[$k] // $d' "$ECLIPVPN_CONFIG"; }
flog() { logger -t eclipvpn "$*"; }

# Returns the per-install Clash API secret. Generates one on first call.
# Stored in /etc/eclipvpn/clash_secret (chmod 600).
_get_clash_secret() {
    local f=/etc/eclipvpn/clash_secret
    if [ ! -s "$f" ]; then
        mkdir -p /etc/eclipvpn
        local s=""
        s=$(head -c 16 /dev/urandom 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null)
        [ -z "$s" ] && s=$(awk 'BEGIN{srand();for(i=0;i<32;i++)printf "%x",int(rand()*16)}')
        printf '%s' "$s" > "$f"
        chmod 600 "$f" 2>/dev/null
    fi
    cat "$f"
}
# Atomic config write — validates JSON before overwriting.
# chmod 600 because config.json holds the subscription URL (panel credential).
# Also keeps 3 rolling backups (config.json.1 = newest): the jq check below
# only catches syntactic damage, while history's config losses were semantic —
# valid JSON with the subscription gone (bad restore, buggy writer). Volatile
# keys that flip in normal operation (selected_server on every failover,
# running_intent on every start/stop) are excluded from the change detection
# so an evening of throttling-wave failovers doesn't flush the real-settings
# history out of the 3 slots.
# Recovery: cp /etc/eclipvpn/config.json.1 /etc/eclipvpn/config.json && eclipvpn restart 1
save_config() {
    local data="$1"
    printf '%s\n' "$data" > "${ECLIPVPN_CONFIG}.tmp"
    if jq '.' "${ECLIPVPN_CONFIG}.tmp" >/dev/null 2>&1; then
        chmod 600 "${ECLIPVPN_CONFIG}.tmp" 2>/dev/null
        if [ -f "$ECLIPVPN_CONFIG" ]; then
            local _old_sig _new_sig
            _old_sig=$(jq -S 'del(.selected_server, .running_intent)' "$ECLIPVPN_CONFIG" 2>/dev/null)
            _new_sig=$(jq -S 'del(.selected_server, .running_intent)' "${ECLIPVPN_CONFIG}.tmp" 2>/dev/null)
            if [ "$_old_sig" != "$_new_sig" ]; then
                mv -f "${ECLIPVPN_CONFIG}.2" "${ECLIPVPN_CONFIG}.3" 2>/dev/null
                mv -f "${ECLIPVPN_CONFIG}.1" "${ECLIPVPN_CONFIG}.2" 2>/dev/null
                # cp, not mv — config.json must never be absent even briefly,
                # concurrent readers (CGI status polls) race this function.
                cp "$ECLIPVPN_CONFIG" "${ECLIPVPN_CONFIG}.1" 2>/dev/null
                chmod 600 "${ECLIPVPN_CONFIG}.1" 2>/dev/null
            fi
        fi
        mv "${ECLIPVPN_CONFIG}.tmp" "$ECLIPVPN_CONFIG"
    else
        rm -f "${ECLIPVPN_CONFIG}.tmp"
        flog "ERROR: invalid JSON, config not saved"
        return 1
    fi
}

# ============================================================
# Core commands
# ============================================================

# Operation lock — held while a user-initiated lifecycle command (start,
# stop, restart, set-server, set-mode) is in flight.
#
# Real mutex via mkdir, not just a pidfile marker: lifecycle commands can
# arrive simultaneously (init.d's S99eclipvpn races with the UI's "включить"
# button on a slow boot, or the watchdog reviver fires on a borderline
# tick). Two concurrent cmd_start invocations both passed the old marker
# write and ran end-to-end, leaving two xray processes fighting for
# 127.0.0.1:1080. The watchdog's deferral check still reads the PID file —
# kept identical for compatibility — but the gate is now mkdir's atomicity.
#
# Returns 0 on acquire, 1 if another live owner holds the lock. Stale lock
# (owner PID dead) is reclaimed transparently.
_op_begin() {
    mkdir -p "$ECLIPVPN_TMP"
    if mkdir "$ECLIPVPN_TMP/op.lockdir" 2>/dev/null; then
        echo $$ > "$ECLIPVPN_TMP/op.in_progress"
        return 0
    fi
    local owner
    owner=$(cat "$ECLIPVPN_TMP/op.in_progress" 2>/dev/null)
    if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then
        rm -rf "$ECLIPVPN_TMP/op.lockdir"
        if mkdir "$ECLIPVPN_TMP/op.lockdir" 2>/dev/null; then
            echo $$ > "$ECLIPVPN_TMP/op.in_progress"
            return 0
        fi
    fi
    return 1
}
_op_end() {
    rm -f "$ECLIPVPN_TMP/op.in_progress"
    rmdir "$ECLIPVPN_TMP/op.lockdir" 2>/dev/null
}

_ensure_watchdog() {
    # Watchdog handles log rotation, auto-recovery, and auto-failover. It is
    # the only place log rotation runs, so losing it silently lets logs grow
    # unbounded (40k-line floods seen on SevenSky 2026-04-29).
    #
    # Idempotency check is by process scan, not by lock file. The lock-file
    # path turned out to be unreliable: init.d used to spawn its own watchdog
    # in parallel with cmd_start's, racing on the lock and leaving a state
    # where the lock was empty/missing while a watchdog was alive — every
    # subsequent _ensure_watchdog call then spawned a duplicate.
    # `pgrep -f 'eclipvpn watchdog'` would match itself — the pgrep process'
    # own cmdline contains the substring it's searching for, so it always
    # returned 0 and we never spawned. Using ps+grep with the classic
    # `[/]` character-class self-exclusion trick: the grep cmdline contains
    # `[/]usr/bin/eclipvpn watchdog`, which includes the substring
    # `]usr/bin/...` (no leading `/`), so the regex `/usr/bin/eclipvpn watchdog`
    # does not match grep itself. Real watchdog cmdline
    # `/bin/ash /usr/bin/eclipvpn watchdog` does match.
    if ps w 2>/dev/null | grep -q '[/]usr/bin/eclipvpn watchdog$'; then
        return 0
    fi
    /usr/bin/eclipvpn watchdog >/dev/null 2>&1 &
    echo $! > "$ECLIPVPN_TMP/watchdog.pid"
}

# Cron-driven "supervisor for the supervisor" (*/5 line tagged #eclipvpn-watch,
# maintained by _ensure_cron_state). The watchdog is the only thing reviving
# dead daemons and rotating logs, but until this command nothing revived the
# watchdog ITSELF — an OOM-killed watchdog silently lost failover and rotation
# until the next manual start/restart, potentially for weeks.
# Gated on running_intent: init.d stop kills the watchdog deliberately (and
# its cmd_stop call clears the intent), so a dead watchdog must then STAY dead.
cmd_ensure_watchdog() {
    [ "$(get_config_val running_intent false)" = "true" ] || return 0
    _ensure_watchdog
}

# Mirror VPN server IPs into zapret's user-exclude list. Without this,
# zapret's NFQUEUE postrouting hook fragments xray's TLS/Reality
# ClientHello to the VPN endpoint and the handshake fails (Reality
# rejects malformed ClientHello). No-op if zapret isn't installed; the
# write+restart is skipped when the list is unchanged so cron-driven
# `eclipvpn update` (returns the same servers most of the time) doesn't
# churn zapret.
_sync_zapret_exclude() {
    local exclude_file="/opt/zapret/ipset/zapret-ip-user-exclude.txt"
    [ -d /opt/zapret ] && [ -f "$ECLIPVPN_TMP/servers.json" ] || return 0

    local new_list current=""
    new_list=$(jq -r '.[].host // empty' "$ECLIPVPN_TMP/servers.json" 2>/dev/null | sort -u)
    [ -z "$new_list" ] && return 0
    [ -f "$exclude_file" ] && current=$(cat "$exclude_file")
    [ "$new_list" = "$current" ] && return 0

    printf '%s\n' "$new_list" > "$exclude_file"
    /etc/init.d/zapret restart >/dev/null 2>&1
    flog "synced VPN IPs to zapret exclude"
}

_rotate_log() {
    # Size-based rotation with copytruncate semantics.
    # Earlier version did `tail > tmp && mv tmp file`. Rename swaps inode —
    # sing-box and xray hold an open fd on the original inode, so the new
    # file is invisible to them; subsequent log lines get written into the
    # now-orphaned, unlinked file (`/proc/PID/fd/1 → file (deleted)`) and
    # never appear in the journal. Effect: UI's log went silent ~1h after
    # the first rotation.
    #
    # Fix: tail-into-temp, then `cat tmp > file` writes through the same
    # file descriptor that the daemons hold — truncate-then-overwrite
    # preserves the inode.
    local max_lines=2000 keep_lines=500
    for logfile in "$ECLIPVPN_TMP/singbox.log" "$ECLIPVPN_TMP/xray.log"; do
        [ -f "$logfile" ] || continue
        local lines=$(wc -l < "$logfile" 2>/dev/null)
        [ -z "$lines" ] && continue
        if [ "$lines" -gt "$max_lines" ]; then
            local tmp="${logfile}.rot"
            if tail -n "$keep_lines" "$logfile" > "$tmp" 2>/dev/null; then
                cat "$tmp" > "$logfile"  # truncate+write — keeps inode, daemons keep writing
                rm -f "$tmp"
                # Rotation is housekeeping, not an event — silenced because it
                # was 80% of syslog eclipvpn output, drowning real switches/errors
                # in the EclipVPN tab of the log viewer.
            fi
        fi
    done
}


# Polled traffic snapshot — proxies the Clash API /traffic stream into a
# single JSON line for the UI. Replaces the previous direct-WebSocket-from-
# browser model: clash_api is now bound to 127.0.0.1, so the secret never
# leaves the router and LAN devices can't drive sing-box's clash interface.
cmd_traffic_poll() {
    local secret
    secret=$(_get_clash_secret 2>/dev/null)
    [ -z "$secret" ] && { echo '{"up":0,"down":0}'; return; }
    # /traffic streams one JSON object per second. --max-time caps the
    # request at ~1.3s so the CGI returns promptly even if the stream stalls.
    local line
    line=$(curl -s --max-time 1.3 -H "Authorization: Bearer $secret" \
        http://127.0.0.1:9090/traffic 2>/dev/null | head -1)
    if [ -n "$line" ]; then
        printf '%s\n' "$line"
    else
        echo '{"up":0,"down":0}'
    fi
}



# ============================================================
# Info commands
# ============================================================

cmd_get_devices() {
    local devices="[]"
    if [ -f /tmp/dhcp.leases ]; then
        while read -r ts mac ip name id; do
            devices=$(echo "$devices" | jq --arg ip "$ip" --arg mac "$mac" --arg name "$name" \
                '. + [{ip:$ip, mac:$mac, name:$name}]')
        done < /tmp/dhcp.leases
    fi
    echo "$devices" | jq '.'
}

cmd_get_log() {
    local lines="${1:-100}" filter="${2:-all}"
    if [ ! -f "$ECLIPVPN_TMP/singbox.log" ]; then
        echo "[]"
        return
    fi

    local grep_filter=""
    case "$filter" in
        vpn)    grep_filter="outbound/socks" ;;
        direct) grep_filter="outbound/direct" ;;
        error)  grep_filter="ERROR" ;;
        dns)    grep_filter="dns:.*exchanged" ;;
        *)      grep_filter="outbound/\|ERROR\|dns:.*exchanged" ;;
    esac

    # Background-noise pattern shared with healthcheck — keeps the "Errors"
    # filter focused on real problems instead of ISP-level direct timeouts
    # to RU services and Apple push-DNS hiccups (apps retry these silently).
    local noise_excludes=""
    [ "$filter" = "error" ] && noise_excludes='\|outbound/direct.*i/o timeout\|dns: exchange failed'

    # Get timezone offset
    local tz_str=$(cat /etc/TZ 2>/dev/null)
    local TZ_OFFSET=$(echo "$tz_str" | sed 's/[A-Za-z]*//g; s/^-//' | awk '{print int($1)}')
    [ -z "$TZ_OFFSET" ] && TZ_OFFSET=3

    # Collect from multiple sources. mktemp + EXIT trap (in subshell so the
    # trap doesn't leak to the calling shell, e.g. watchdog).
    mkdir -p "$ECLIPVPN_TMP"
    (
    local tmplog
    tmplog=$(mktemp "$ECLIPVPN_TMP/combined.XXXXXX") || { echo "[]"; exit 1; }
    trap 'rm -f "$tmplog"' EXIT INT TERM

    # Source 1: sing-box log (skip for flow-only filter)
    if [ "$filter" != "flow" ]; then
        grep "$grep_filter" "$ECLIPVPN_TMP/singbox.log" 2>/dev/null | \
            grep -v "packet connection$\|WARN\|cached\|inbound/\|1\.1\.1\.1:853\|1\.0\.0\.1:853\|8\.8\.8\.8:853\|8\.8\.4\.4:853\|127\.0\.0\.1:53\|127\.0\.0\.1:5354${noise_excludes}" | \
            sed 's/\x1b\[[0-9;]*m//g; s/\x1b\[0m//g' | \
            awk '{print "SING|"$0}' >> "$tmplog"
    fi

    # Source 2: xray log — only errors
    if [ "$filter" = "all" ] || [ "$filter" = "error" ]; then
        grep -iE "error|fail|warning" "$ECLIPVPN_TMP/xray.log" 2>/dev/null | \
            grep -v "accepted\|started\|Reading config" | \
            tail -50 | awk '{print "XRAY|"$0}' >> "$tmplog"
    fi

    # Source 3: syslog eclipvpn entries. The syslog ringbuffer is shared
    # router-wide and can't be truncated, so filter by the "log cleared"
    # marker that cmd_clear_log writes — events older than that timestamp
    # were dismissed by the user and shouldn't reappear in the UI.
    if [ "$filter" = "all" ] || [ "$filter" = "flow" ]; then
        local cleared_since=0
        [ -f "$ECLIPVPN_TMP/log_cleared_ts" ] && cleared_since=$(cat "$ECLIPVPN_TMP/log_cleared_ts" 2>/dev/null)
        # logread on this busybox formats lines like
        #   "Thu Apr 30 00:18:32 2026 user.notice eclipvpn: ..."
        # No epoch prefix and the time is in *local* timezone, but
        # log_cleared_ts is `date +%s` (UTC epoch). Parse the textual
        # date in awk and subtract TZ_OFFSET to compare apples to apples.
        # mktime is gawk-only, so we build the epoch by hand.
        logread 2>/dev/null | grep 'eclipvpn:' | tail -100 | \
            awk -v ts="${cleared_since:-0}" -v tz="${TZ_OFFSET:-3}" '
                BEGIN {
                    split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", m, " ")
                    for (i=1; i<=12; i++) mn[m[i]] = i
                    split("31 28 31 30 31 30 31 31 30 31 30 31", dim, " ")
                }
                {
                    if ($1 ~ /^[A-Z][a-z]{2}$/ && $2 in mn) {
                        mo = mn[$2]; day = $3+0; year = $5+0
                        split($4, hms, ":"); hh=hms[1]+0; mi=hms[2]+0; se=hms[3]+0
                        days = (year - 1970) * 365 + int((year - 1969) / 4)
                        for (i=1; i<mo; i++) days += dim[i]
                        if (mo > 2 && (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0))) days += 1
                        days += day - 1
                        # local epoch → UTC epoch.
                        epoch = days * 86400 + hh*3600 + mi*60 + se - tz*3600
                        if (epoch + 0 >= ts + 0) print
                    }
                }' | awk '{print "FLOW|"$0}' >> "$tmplog"
    fi

    # Sort and parse
    sort "$tmplog" 2>/dev/null | tail -"$lines" | \
        sed 's/\x1b\[[0-9;]*m//g; s/\x1b\[0m//g' | \
        awk -v tz="${TZ_OFFSET:-3}" '{
            # Extract source prefix (SING|, XRAY|, FLOW|)
            src="sing"
            if(substr($0,1,5)=="SING|"){src="sing";$0=substr($0,6)}
            else if(substr($0,1,5)=="XRAY|"){src="xray";$0=substr($0,6)}
            else if(substr($0,1,5)=="FLOW|"){src="flow";$0=substr($0,6)}

            # Extract time
            time=""
            for(i=1;i<=NF;i++){
                if($i ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/){
                    split($(i+1),t,":")
                    h=t[1]+0+tz; if(h>=24)h-=24; if(h<0)h+=24
                    time=$i" "sprintf("%02d:%02d:%02d",h,t[2]+0,t[3]+0)
                    break
                }
            }

            # FLOW entries (syslog: "Fri Apr 24 14:35:52 2026 user.notice eclipvpn: message")
            if(src=="flow"){
                msg=""
                for(i=1;i<=NF;i++){
                    if($i ~ /^eclipvpn/){
                        for(j=i+1;j<=NF;j++) msg=msg" "$j
                        break
                    }
                }
                # Extract time: field 4 = HH:MM:SS
                time=$1" "$2" "$3" "$4
                gsub(/^ +/,"",msg)
                if(msg != "") print time"|"msg"|flow"
                next
            }

            # XRAY entries
            if(src=="xray"){
                route="xray"
                dst=""
                if(/accepted/){
                    for(i=1;i<=NF;i++){
                        if($i=="accepted"){dst=$(i+1); break}
                    }
                } else if(/error|fail|timeout/){
                    route="error"
                    idx=0
                    for(i=1;i<=length($0);i++){if(substr($0,i,2)=="] ")idx=i+2}
                    if(idx>0)dst=substr($0,idx)
                    if(length(dst)>100)dst=substr(dst,1,100)"..."
                }
                if(dst != "") print time"|"dst"|"route
                next
            }

            # SING entries
            route=""
            if(/outbound\/socks/) route="vpn"
            else if(/outbound\/direct/) route="direct"
            else if(/ERROR/) route="error"
            else if(/dns:.*exchanged/) route="dns"

            dst=""
            if(route=="error"){
                idx=0
                for(i=1;i<=length($0);i++){if(substr($0,i,2)=="] ")idx=i+2}
                if(idx>0)dst=substr($0,idx)
                if(length(dst)>100)dst=substr(dst,1,100)"..."
            } else if(route=="dns"){
                for(i=1;i<=NF;i++){
                    if($i=="exchanged"){
                        if($(i+1)=="A"||$(i+1)=="AAAA") dst=$(i+2)" → "$(i+6)
                        else if($(i+1)=="CNAME") dst=$(i+2)" → "$(i+6)
                        else dst=$(i+1)" "$(i+2)
                        break
                    }
                }
            } else {
                for(i=1;i<=NF;i++){
                    if($i=="to"&&$(i+1)!~/^127\.|^:$|^0\.0/){dst=$(i+1);break}
                }
            }
            gsub(/\.$/,"",dst)

            if(route!=""&&(dst!=""||route=="error")) print time"|"dst"|"route
        }' | \
        jq -R -s 'split("\n") | map(select(length > 0)) | map(split("|") | {time: .[0], dst: .[1], route: .[2]})'

    rm -f "$tmplog"
    )
}

cmd_get_dns() {
    local mode=$(get_config_val mode "all_vpn")
    local dnsmasq_server=""
    dnsmasq_server=$(uci get dhcp.@dnsmasq[0].server 2>/dev/null)
    jq -n --arg mode "$mode" --arg dnsmasq "$dnsmasq_server" \
        '{mode:$mode, dnsmasq_server:$dnsmasq, proxy_dns:"tls://1.1.1.1", direct_dns:"udp://77.88.8.8",
          dot_blocked:true, quic_blocked:($mode != "all_vpn")}'
}

cmd_set_config() {
    local key="$1" value="$2"
    [ -z "$key" ] || [ -z "$value" ] && { echo '{"error":"missing key or value"}'; return 1; }
    # Whitelist allowed keys
    case "$key" in
        subscription_url|interface|mode|auto_start|selected_server|blocklist_source|auto_mode|tput_guard|tput_min_kbps|wan_mtu) ;;
        *) echo '{"error":"invalid key"}'; return 1 ;;
    esac
    # mode change needs to wipe rules and refetch them — same dance as
    # cmd_set_mode. Without this delegation, `set-config?key=mode&value=...`
    # via CGI saves the new mode to config but leaves the old mode's rules
    # in place; sing-box restarts with the wrong list (e.g. blocklist mode
    # without domains.list → all traffic goes direct).
    [ "$key" = "mode" ] && { cmd_set_mode "$value"; return $?; }
    # blocklist_source: validate value at the boundary (CGI lets any
    # `[a-zA-Z0-9_-]` through, so a malformed value would silently fall
    # through to the default branch in _fetch_blocklist_domains).
    if [ "$key" = "blocklist_source" ]; then
        case "$value" in curated|full) ;; *) echo '{"error":"blocklist_source must be curated or full"}'; return 1 ;; esac
    fi
    # Boolean keys: store as JSON true/false instead of "true"/"false" string,
    # so cmd_status's `// true` defaults work and the UI gets a real bool.
    local tmp
    case "$key" in
        auto_start|auto_mode|tput_guard)
            local bv
            case "$value" in
                true|1|on|yes) bv=true ;;
                *) bv=false ;;
            esac
            tmp=$(jq --arg k "$key" --argjson v "$bv" '.[$k] = $v' "$ECLIPVPN_CONFIG")
            ;;
        selected_server|tput_min_kbps|wan_mtu)
            case "$value" in ''|*[!0-9]*) echo '{"error":"'"$key"' must be numeric"}'; return 1 ;; esac
            # wan_mtu: 0 = leave the interface alone; otherwise clamp to a
            # sane range — _apply_wan_mtu would happily set MTU 100 and
            # take the whole WAN down.
            if [ "$key" = "wan_mtu" ] && [ "$value" != "0" ]; then
                if [ "$value" -lt 576 ] || [ "$value" -gt 1500 ]; then
                    echo '{"error":"wan_mtu must be 0 (off) or 576-1500"}'; return 1
                fi
            fi
            tmp=$(jq --arg k "$key" --argjson v "$value" '.[$k] = $v' "$ECLIPVPN_CONFIG")
            ;;
        *)
            tmp=$(jq --arg k "$key" --arg v "$value" '.[$k] = $v' "$ECLIPVPN_CONFIG")
            ;;
    esac
    save_config "$tmp" || { echo '{"error":"save failed"}'; return 1; }
    jq -n --arg k "$key" '{status:"saved",key:$k}'
}

cmd_diagnose() {
    # Tab-separated rows (name<TAB>status<TAB>detail) → single jq at end.
    # Three network probes run in parallel (saves ~10-15s on aarch64).
    local diag_dir="$ECLIPVPN_TMP/diag.$$"
    mkdir -p "$diag_dir"
    local rows="$diag_dir/rows"
    : > "$rows"
    trap "rm -rf '$diag_dir'" EXIT INT TERM

    _add() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$rows"; }

    # Kick off network probes in parallel — they dominate total runtime.
    if is_xray_running; then
        ( curl -s --socks5-hostname 127.0.0.1:1080 --max-time 5 https://ifconfig.me 2>/dev/null > "$diag_dir/vpn_ip" ) &
        ( curl -s --socks5-hostname 127.0.0.1:1080 --max-time 8 -o /dev/null -w "%{http_code}" https://youtube.com 2>/dev/null > "$diag_dir/yt_code" ) &
    fi
    ( curl -s --max-time 5 -o /dev/null -w "%{http_code}" https://yandex.ru 2>/dev/null > "$diag_dir/ya_code" ) &

    # Local checks while probes are in flight.

    # 1. xray
    if is_xray_running; then
        _add "xray-core" "ok" "PID $(cat /tmp/eclipvpn/xray.pid 2>/dev/null), порт 1080"
    else
        _add "xray-core" "error" "Не запущен"
    fi

    # 2. sing-box
    if is_singbox_running; then
        _add "sing-box" "ok" "PID $(cat /tmp/eclipvpn/singbox.pid 2>/dev/null), порт 2154"
    else
        _add "sing-box" "error" "Не запущен"
    fi

    # 3. nftables
    if nft list table ip eclipvpn >/dev/null 2>&1; then
        local rule_count=$(nft list table ip eclipvpn 2>/dev/null | grep -c "tproxy\|return\|reject")
        _add "nftables" "ok" "Таблица eclipvpn: $rule_count правил"
    else
        _add "nftables" "error" "Таблица eclipvpn не найдена"
    fi

    # 4. ip rule for tproxy
    if ip rule list | grep -q "fwmark 0x1"; then
        _add "ip-rule" "ok" "fwmark 0x1 → table 100"
    else
        _add "ip-rule" "error" "Правило fwmark не найдено"
    fi

    # 5. dnsmasq → sing-box
    local dns_srv=$(uci get dhcp.@dnsmasq[0].server 2>/dev/null)
    if echo "$dns_srv" | grep -q "5354"; then
        _add "dns-redirect" "ok" "dnsmasq → sing-box ($dns_srv)"
    else
        _add "dns-redirect" "warn" "dnsmasq не перенаправлен: $dns_srv"
    fi

    # 6. DNS resolution
    local dns_test=$(nslookup youtube.com 127.0.0.1 2>&1 | grep -c "Address.*[0-9]")
    if [ "$dns_test" -gt 1 ]; then
        _add "dns-resolve" "ok" "youtube.com резолвится"
    else
        _add "dns-resolve" "error" "youtube.com не резолвится"
    fi

    # Wait for the parallel probes before consuming their results.
    wait
    local vpn_ip="" yt_code="" ya_code=""
    [ -f "$diag_dir/vpn_ip" ]  && vpn_ip=$(cat "$diag_dir/vpn_ip" 2>/dev/null)
    [ -f "$diag_dir/yt_code" ] && yt_code=$(cat "$diag_dir/yt_code" 2>/dev/null)
    [ -f "$diag_dir/ya_code" ] && ya_code=$(cat "$diag_dir/ya_code" 2>/dev/null)

    # 7. VPN connection
    if ! is_xray_running; then
        _add "vpn-connection" "error" "xray не запущен"
    elif [ -n "$vpn_ip" ]; then
        _add "vpn-connection" "ok" "VPN IP: $vpn_ip"
    else
        _add "vpn-connection" "error" "Нет ответа через VPN"
    fi

    # 8. Blocked site through VPN
    if ! is_xray_running; then
        _add "test-blocked" "error" "xray не запущен"
    elif [ "$yt_code" = "301" ] || [ "$yt_code" = "200" ]; then
        _add "test-blocked" "ok" "youtube.com: HTTP $yt_code через VPN"
    else
        _add "test-blocked" "error" "youtube.com: HTTP $yt_code"
    fi

    # 9. RU site direct
    if [ "$ya_code" = "302" ] || [ "$ya_code" = "200" ]; then
        _add "test-direct" "ok" "yandex.ru: HTTP $ya_code напрямую"
    else
        _add "test-direct" "warn" "yandex.ru: HTTP $ya_code"
    fi

    # 10. sing-box log errors — read tail by BYTES, not lines.
    # `tail -n N` walks the file from the start on busybox, so a 45MB log
    # blocks for ~100s and overruns uhttpd's 30s network_timeout.
    # `tail -c N` seeks from the end and is O(1).
    local err_count=0 last_err=""
    if [ -f "$ECLIPVPN_TMP/singbox.log" ]; then
        local err_lines=$(tail -c 262144 "$ECLIPVPN_TMP/singbox.log" 2>/dev/null | tr -d '\0' | grep "ERROR")
        if [ -n "$err_lines" ]; then
            err_count=$(printf '%s\n' "$err_lines" | wc -l)
            last_err=$(printf '%s\n' "$err_lines" | tail -1 | sed 's/.*\] //')
        fi
    fi
    if [ "$err_count" -eq 0 ]; then
        _add "log-errors" "ok" "Ошибок нет (последние 256KB)"
    else
        _add "log-errors" "warn" "$err_count ошибок. Последняя: $last_err"
    fi

    # 11. Log size — bytes, not line count.
    local log_bytes=0 log_mb=0
    if [ -f "$ECLIPVPN_TMP/singbox.log" ]; then
        log_bytes=$(wc -c < "$ECLIPVPN_TMP/singbox.log" 2>/dev/null)
        log_mb=$((log_bytes / 1048576))
    fi
    if [ "$log_mb" -ge 10 ]; then
        _add "log-size" "warn" "${log_mb}MB — лог большой, рекомендуется очистить"
    else
        _add "log-size" "ok" "${log_mb}MB"
    fi

    # 12. Disk space
    local free_mb=$(df /overlay 2>/dev/null | tail -1 | awk '{print int($4/1024)}')
    if [ "$free_mb" -lt 5 ]; then
        _add "disk" "error" "Мало места: ${free_mb}MB свободно"
    else
        _add "disk" "ok" "${free_mb}MB свободно на /overlay"
    fi

    # Convert TSV → JSON in a single jq invocation.
    jq -R -s '
        split("\n") | map(select(length > 0)) | map(split("\t")) |
        map({name:.[0], status:.[1], detail:.[2]})
    ' < "$rows"
}

# ============================================================
# Watchdog — auto-failover
# ============================================================

# A server is "metered" (RU-safe, mobile-carrier) when its name contains
# carrier markers. Such servers give a Russian IP, so watchdog must NEVER
# auto-switch to them — doing so defeats the purpose of a VPN.
_is_metered_server() {
    local name="$1"
    case "$name" in
        *МТС*|*мтс*|*MTS*|*mts*) return 0 ;;
        *Т2*|*т2*|*Tele2*|*tele2*|*Би*) return 0 ;;
        *Билайн*|*билайн*|*Beeline*|*beeline*) return 0 ;;
        *Мегафон*|*мегафон*|*Megafon*|*megafon*) return 0 ;;
    esac
    return 1
}

_record_switch() {
    local from_idx="$1" to_idx="$2" reason="$3"
    local from_name=$(jq -r ".[$from_idx].name // \"\"" "$ECLIPVPN_TMP/servers.json" 2>/dev/null)
    local to_name=$(jq -r ".[$to_idx].name // \"\"" "$ECLIPVPN_TMP/servers.json" 2>/dev/null)
    jq -n --arg from "$from_name" --arg to "$to_name" --arg reason "$reason" \
        --argjson ts "$(date +%s)" \
        '{time:$ts, from:$from, to:$to, reason:$reason}' \
        > "$ECLIPVPN_TMP/last_switch.json" 2>/dev/null
}

# Record a server-stability incident. Stored as a JSON array (last 200) keyed
# by host so renumbering after an `update` doesn't lose history. Read by
# cmd_get_incidents and rendered in the UI as per-server fail badges + history.
_log_incident() {
    local type="$1" host="$2" name="$3" detail="$4"

    # Suppress incidents while a user-initiated lifecycle op is in flight
    # (deploy.sh, manual eclipvpn restart, UI restart button, set-server).
    # The owner process — whose PID is in op.in_progress — is allowed to
    # log its own diagnostics: cmd_restart's test_xray miss IS something
    # the operator wants to see. But watchdog probing concurrently with a
    # restart shouldn't pollute the journal with "switch_failed" entries
    # whose root cause is just "we were mid-restart". Self-vs-other check
    # by PID lets cmd_restart still record its own failures.
    local op_marker="$ECLIPVPN_TMP/op.in_progress"
    if [ -f "$op_marker" ]; then
        local op_pid
        op_pid=$(cat "$op_marker" 2>/dev/null)
        if [ -n "$op_pid" ] && [ "$op_pid" != "$$" ] && kill -0 "$op_pid" 2>/dev/null; then
            return 0
        fi
    fi

    local f="$ECLIPVPN_TMP/incidents.json"
    mkdir -p "$ECLIPVPN_TMP"
    [ -f "$f" ] || echo '[]' > "$f"
    local tmp="$f.tmp.$$"
    jq --arg type "$type" --arg host "$host" --arg name "$name" --arg detail "$detail" \
       --argjson ts "$(date +%s)" \
       '. + [{ts:$ts, type:$type, host:$host, server:$name, detail:$detail}] | .[-200:]' \
       "$f" > "$tmp" 2>/dev/null && mv "$tmp" "$f" || rm -f "$tmp"
}

cmd_get_incidents() {
    local f="$ECLIPVPN_TMP/incidents.json"
    if [ ! -f "$f" ]; then echo '{"incidents":[],"stats":[]}'; return; fi
    local now=$(date +%s)
    local h24=$((now - 86400))
    local h7d=$((now - 604800))
    jq --argjson h24 "$h24" --argjson h7d "$h7d" '
      . as $all |
      ($all | sort_by(-.ts) | .[0:200]) as $incidents |
      ($all
        | map(select(.host != null and .host != ""))
        | group_by(.host)
        | map({
            host:      .[0].host,
            server:    (max_by(.ts).server),
            count_24h: (map(select(.ts >= $h24)) | length),
            count_7d:  (map(select(.ts >= $h7d)) | length),
            last_ts:   (max_by(.ts).ts),
            last_type: (max_by(.ts).type)
          })
        | map(select(.count_7d > 0))
        | sort_by(-.count_24h, -.count_7d)
      ) as $stats |
      {incidents: $incidents, stats: $stats}
    ' "$f" 2>/dev/null || echo '{"incidents":[],"stats":[]}'
}

cmd_clear_incidents() {
    echo '[]' > "$ECLIPVPN_TMP/incidents.json"
    echo '{"status":"cleared"}'
}

# Watchdog (connectivity probing, auto-failover, throughput guard) lives in
# usr/lib/eclipvpn/watchdog.sh — sourced at the top of this file.

# ============================================================
# Traffic stats
# ============================================================

cmd_get_traffic() {
    # Honest per-outbound accounting via Clash API /connections.
    #
    # The API returns a snapshot of currently-active connections, each with
    # cumulative upload/download since that connection started, plus a
    # "chains" array showing which outbound it routed through ("default" =
    # VPN, "direct" = bypass). Closed connections drop off the list and
    # their final bytes would be lost.
    #
    # We maintain a state file with per-connection-id last-seen counters.
    # On each poll we compute deltas and add them to per-chain totals;
    # connections that have closed are simply not in the new snapshot, so
    # their last-known bytes stay accumulated. Result: cumulative VPN_dl,
    # VPN_ul, DIR_dl, DIR_ul since tracking started (cleared on sing-box
    # restart by start_singbox).
    #
    # The whole RMW is wrapped in flock — UI polls every 5s and two open
    # tabs would otherwise both read the same `seen` snapshot, compute
    # the same deltas, and double-count traffic.
    mkdir -p "$ECLIPVPN_TMP"
    local state_file="$ECLIPVPN_TMP/traffic_state.json"
    (
        command -v flock >/dev/null 2>&1 && flock -x 200
        [ -f "$state_file" ] || \
            printf '%s\n' '{"vpn_dl":0,"vpn_ul":0,"dir_dl":0,"dir_ul":0,"started":0,"seen":{}}' > "$state_file"

        local conns secret
        secret=$(_get_clash_secret)
        conns=$(curl -s --max-time 3 -H "Authorization: Bearer $secret" \
            http://127.0.0.1:9090/connections 2>/dev/null)

        if [ -z "$conns" ] || ! echo "$conns" | jq -e . >/dev/null 2>&1; then
            jq '. + {total_dl:0, total_ul:0, vpn_active:0, direct_active:0,
                     vpn_conns:0, direct_conns:0, api_ok:false} | del(.seen)' "$state_file"
            return 0
        fi

        local new_state
        new_state=$(jq -n \
        --slurpfile state "$state_file" \
        --argjson conns "$conns" '
        ($state[0]) as $s |
        ($s.seen // {}) as $seen |
        ($conns.connections // []) as $active |
        # Classify each active connection: dir if "direct" appears in chains,
        # otherwise vpn (covers "default" and any other proxy chain).
        ($active | map({
            id: .id,
            dl: (.download // 0),
            ul: (.upload // 0),
            chain: (if (.chains // [] | index("direct")) then "dir" else "vpn" end)
        })) as $cur |
        # Compute per-connection deltas. If current < previously-seen (rare:
        # the connection ID was reused after close), fall back to the full
        # current value rather than going negative.
        ($cur | map(
            . + {
                dl_delta: (if .dl >= (($seen[.id].dl) // 0) then .dl - (($seen[.id].dl) // 0) else .dl end),
                ul_delta: (if .ul >= (($seen[.id].ul) // 0) then .ul - (($seen[.id].ul) // 0) else .ul end)
            }
        )) as $deltas |
        ($deltas | map(select(.chain == "vpn"))) as $vpn |
        ($deltas | map(select(.chain == "dir"))) as $dir |
        # New seen{}: only currently-active IDs. Closed ones drop out, but
        # their bytes were already added to vpn_*/dir_* on prior polls.
        ($cur | map({key: .id, value: {dl: .dl, ul: .ul, chain: .chain}}) | from_entries) as $new_seen |
        {
            vpn_dl: ($s.vpn_dl + (($vpn | map(.dl_delta) | add) // 0)),
            vpn_ul: ($s.vpn_ul + (($vpn | map(.ul_delta) | add) // 0)),
            dir_dl: ($s.dir_dl + (($dir | map(.dl_delta) | add) // 0)),
            dir_ul: ($s.dir_ul + (($dir | map(.ul_delta) | add) // 0)),
            started: (if $s.started > 0 then $s.started else now | floor end),
            seen: $new_seen
        }
    ')

        if [ -n "$new_state" ] && echo "$new_state" | jq -e . >/dev/null 2>&1; then
            printf '%s\n' "$new_state" > "${state_file}.tmp" && mv "${state_file}.tmp" "$state_file"
        fi

        # Public response — strip the internal seen{} and add live fields.
        cat "$state_file" | jq \
            --argjson conns "$conns" \
            '{
                vpn_dl, vpn_ul, dir_dl, dir_ul, started,
                total_dl: ($conns.downloadTotal // 0),
                total_ul: ($conns.uploadTotal // 0),
                vpn_active: ([$conns.connections[]? | select(.chains | index("direct") | not)
                                                    | (.upload // 0) + (.download // 0)] | add // 0),
                direct_active: ([$conns.connections[]? | select(.chains | index("direct"))
                                                    | (.upload // 0) + (.download // 0)] | add // 0),
                vpn_conns: ([$conns.connections[]? | select(.chains | index("direct") | not)] | length),
                direct_conns: ([$conns.connections[]? | select(.chains | index("direct"))] | length),
                api_ok: true
            }'
    ) 200>"$state_file.lock"
}

cmd_real_ping() {
    # Real end-to-end latency through VLESS+Reality+XHTTP, not just TCP RTT
    # to :443. Uses sing-box's Clash-API delay endpoint, which dials the
    # actual outbound and times an HTTP HEAD to gstatic.com/generate_204.
    # Cheap (≤5s) and exact — what users actually feel.
    if ! is_singbox_running; then
        echo '{"ok":false, "error":"sing-box not running"}'
        return
    fi
    local secret=$(_get_clash_secret)
    local resp
    resp=$(curl -s --max-time 7 -H "Authorization: Bearer $secret" \
        "http://127.0.0.1:9090/proxies/default/delay?url=https://www.gstatic.com/generate_204&timeout=5000" 2>/dev/null)
    if [ -z "$resp" ]; then
        echo '{"ok":false, "error":"clash api unavailable"}'
        return
    fi
    # Either {"delay":NN} on success or {"message":"..."} on failure.
    local delay
    delay=$(echo "$resp" | jq -r '.delay // empty' 2>/dev/null)
    if [ -n "$delay" ] && [ "$delay" -gt 0 ] 2>/dev/null; then
        echo "{\"ok\":true, \"delay_ms\":$delay}"
    else
        local msg
        msg=$(echo "$resp" | jq -r '.message // "timeout"' 2>/dev/null)
        jq -n --arg e "$msg" '{ok:false, error:$e}'
    fi
}

cmd_reset_traffic() {
    # Reset cumulative per-chain counters (vpn_dl/ul, dir_dl/ul) and start a
    # fresh accounting window. Keeps `seen{}` populated with current
    # connection IDs so the next poll computes deltas from now, not from
    # whatever bytes those open connections had accumulated before.
    local state_file="$ECLIPVPN_TMP/traffic_state.json"
    mkdir -p "$ECLIPVPN_TMP"
    (
        command -v flock >/dev/null 2>&1 && flock -x 200
        local now=$(date +%s)
        local seen='{}'
        if [ -f "$state_file" ]; then
            seen=$(jq '.seen // {}' "$state_file" 2>/dev/null || echo '{}')
        fi
        jq -n --argjson seen "$seen" --argjson ts "$now" \
            '{vpn_dl:0, vpn_ul:0, dir_dl:0, dir_ul:0, started:$ts, seen:$seen}' \
            > "$state_file.tmp" && mv "$state_file.tmp" "$state_file"
    ) 200>"$state_file.lock"
    echo "{\"status\":\"reset\",\"started\":$(date +%s)}"
}

# ============================================================
# Schedule
# ============================================================

cmd_schedule() {
    local action="$1" on_time="$2" off_time="$3"
    case "$action" in
        set)
            [ -z "$on_time" ] || [ -z "$off_time" ] && { echo '{"error":"need on_time and off_time"}'; return 1; }
            # Reject HH:MM with hour 24-29 (the CGI's [0-2][0-9] pattern lets
            # those through); cron would silently never fire on them.
            local _t
            for _t in "$on_time" "$off_time"; do
                case "$_t" in
                    [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;;
                    *) echo '{"error":"time must be HH:MM in 00:00-23:59"}'; return 1 ;;
                esac
            done
            local tmp=$(jq --arg on "$on_time" --arg off "$off_time" \
                '.schedule = {enabled:true, on:$on, off:$off}' "$ECLIPVPN_CONFIG")
            save_config "$tmp" || { echo '{"error":"save failed"}'; return 1; }
            _setup_cron
            jq -n --arg on "$on_time" --arg off "$off_time" '{status:"schedule set",on:$on,off:$off}'
            ;;
        disable)
            local tmp=$(jq '.schedule.enabled = false' "$ECLIPVPN_CONFIG")
            save_config "$tmp" || { echo '{"error":"save failed"}'; return 1; }
            _remove_cron
            echo '{"status":"schedule disabled"}'
            ;;
        *)
            local sched=$(jq '.schedule // {enabled:false}' "$ECLIPVPN_CONFIG")
            echo "$sched"
            ;;
    esac
}

_setup_cron() {
    _remove_cron
    local on_time off_time
    on_time=$(jq -r '.schedule.on // "07:00"' "$ECLIPVPN_CONFIG")
    off_time=$(jq -r '.schedule.off // "23:00"' "$ECLIPVPN_CONFIG")
    # Re-validate HH:MM. The CGI checks at the boundary, but cmd_restore
    # writes .schedule from a backup blob — a crafted backup could put
    # "07:00; rm -rf /" in here and that string would otherwise land
    # straight into a crontab line, executed by root.
    case "$on_time"  in [0-2][0-9]:[0-5][0-9]) ;; *) flog "ERROR: invalid schedule.on '$on_time' — cron not installed"; return 1 ;; esac
    case "$off_time" in [0-2][0-9]:[0-5][0-9]) ;; *) flog "ERROR: invalid schedule.off '$off_time' — cron not installed"; return 1 ;; esac
    local on_h=${on_time%%:*} on_m=${on_time##*:}
    local off_h=${off_time%%:*} off_m=${off_time##*:}
    (crontab -l 2>/dev/null; echo "$on_m $on_h * * * /usr/bin/eclipvpn start >/dev/null 2>&1 #eclipvpn") | crontab -
    (crontab -l 2>/dev/null; echo "$off_m $off_h * * * /usr/bin/eclipvpn stop >/dev/null 2>&1 #eclipvpn") | crontab -
}

_remove_cron() {
    # Anchored: a bare "#eclipvpn" substring match also swallowed the
    # auto-update line ("#eclipvpn-update"), so every schedule set/disable
    # silently killed the nightly refresh while config still said enabled.
    crontab -l 2>/dev/null | grep -v "#eclipvpn$" | crontab -
}

# Reconcile crontab with config.json. Two cases this self-heals:
#   - `restore` onto a fresh router: schedule/auto_update arrive as config
#     flags, but no crontab lines exist — both features look enabled in the
#     UI while nothing ever fires;
#   - migration from a pre-rename install: its cron lines point at the
#     deleted /usr/bin/flowvpn binary.
# Cheap (one crontab read + two jq calls), called from cmd_start (covers
# boot and every manual start) and from cmd_restore.
_ensure_cron_state() {
    local cur
    cur=$(crontab -l 2>/dev/null)
    case "$cur" in
        *"/usr/bin/flowvpn"*)
            printf '%s\n' "$cur" | grep -v "/usr/bin/flowvpn " | crontab -
            cur=$(crontab -l 2>/dev/null)
            ;;
    esac
    if [ "$(jq -r '.schedule.enabled // false' "$ECLIPVPN_CONFIG" 2>/dev/null)" = "true" ]; then
        printf '%s\n' "$cur" | grep -q "#eclipvpn$" || _setup_cron
    else
        printf '%s\n' "$cur" | grep -q "#eclipvpn$" && _remove_cron
    fi
    if [ "$(jq -r '.auto_update // false' "$ECLIPVPN_CONFIG" 2>/dev/null)" = "true" ]; then
        printf '%s\n' "$cur" | grep -q "#eclipvpn-update$" || _setup_auto_update_cron
    else
        printf '%s\n' "$cur" | grep -q "#eclipvpn-update$" && _remove_auto_update_cron
    fi
    # Watchdog supervision line — installed unconditionally (the command
    # self-gates on running_intent, so it's inert after a deliberate stop).
    # Marker #eclipvpn-watch: the anchored greps elsewhere (#eclipvpn$ in
    # _remove_cron, #eclipvpn-update in _remove_auto_update_cron) can't
    # collide with it.
    printf '%s\n' "$cur" | grep -q "#eclipvpn-watch$" || \
        (crontab -l 2>/dev/null; echo "*/5 * * * * /usr/bin/eclipvpn ensure-watchdog >/dev/null 2>&1 #eclipvpn-watch") | crontab -
    return 0
}

# ============================================================
# Auto-update
# ============================================================

cmd_auto_update() {
    local action="$1"
    case "$action" in
        enable)
            local tmp=$(jq '.auto_update = true' "$ECLIPVPN_CONFIG")
            save_config "$tmp"
            _setup_auto_update_cron
            echo '{"status":"auto-update enabled"}'
            ;;
        disable)
            local tmp=$(jq '.auto_update = false' "$ECLIPVPN_CONFIG")
            save_config "$tmp"
            _remove_auto_update_cron
            echo '{"status":"auto-update disabled"}'
            ;;
        *)
            jq '{auto_update: (.auto_update // false)}' "$ECLIPVPN_CONFIG"
            ;;
    esac
}

_setup_auto_update_cron() {
    _remove_auto_update_cron
    (crontab -l 2>/dev/null; echo "0 3 * * * /usr/bin/eclipvpn update >/dev/null 2>&1 #eclipvpn-update") | crontab -
}

_remove_auto_update_cron() {
    crontab -l 2>/dev/null | grep -v "#eclipvpn-update" | crontab -
}

# ============================================================
# Backup / Restore
# ============================================================

cmd_backup() {
    local direct_domains="" vpn_domains=""
    [ -f /etc/eclipvpn/direct_domains.txt ] && direct_domains=$(cat /etc/eclipvpn/direct_domains.txt)
    [ -f /etc/eclipvpn/vpn_domains.txt ] && vpn_domains=$(cat /etc/eclipvpn/vpn_domains.txt)
    jq -n --argjson config "$(cat $ECLIPVPN_CONFIG)" \
        --arg direct "$direct_domains" --arg vpn "$vpn_domains" \
        '{config:$config, direct_domains:$direct, vpn_domains:$vpn, version:"v4"}'
}

cmd_restore() {
    local data
    if [ -n "$1" ]; then
        data="$1"
    else
        data=$(cat)
    fi
    [ -z "$data" ] && { echo '{"error":"no data"}'; return 1; }
    # Validate JSON structure before applying — prevents writing garbage to config
    if ! printf '%s' "$data" | jq -e '.config' >/dev/null 2>&1; then
        echo '{"error":"invalid backup format"}'; return 1
    fi
    # Route the config through save_config so we get atomic mv + chmod 600 +
    # JSON re-validation. A raw `>` redirect would leave a world-readable
    # file with the subscription URL on partial writes (OOM kill, reboot).
    local cfg
    cfg=$(printf '%s' "$data" | jq -c '.config')
    save_config "$cfg" || { echo '{"error":"invalid config in backup"}'; return 1; }

    # Domain lists are merged into ru_domains.list / vpn_domains.list at
    # the next mode/start. A backup blob is untrusted input, so filter to
    # the same shape the CGI's `domain` validator accepts: no leading dot,
    # no consecutive dots, only [a-zA-Z0-9.*_/-]. The slash is deliberate —
    # the direct list holds IP-CIDR entries like 192.168.0.0/24 (the CGI
    # allows them); the old slash-less filter silently dropped them on
    # restore. Anything else (control chars, metacharacters) is dropped.
    local re='^[a-zA-Z0-9*][a-zA-Z0-9.*_/-]*$'
    printf '%s' "$data" | jq -r '.direct_domains // ""' \
        | tr -d '\r' | grep -v '\.\.' | grep -E "$re" \
        > /etc/eclipvpn/direct_domains.txt 2>/dev/null
    printf '%s' "$data" | jq -r '.vpn_domains // ""' \
        | tr -d '\r' | grep -v '\.\.' | grep -E "$re" \
        > /etc/eclipvpn/vpn_domains.txt 2>/dev/null
    # The restored config may carry schedule/auto_update flags from the old
    # router — re-arm crontab to match, or both silently stay inert here.
    _ensure_cron_state

    # Apply immediately. The old code returned "restored" while the live tunnel
    # kept the PREVIOUS config until a manual restart — yet the UI dialog
    # promised "VPN перезапустится". If the VPN is running, a soft restart
    # picks up the restored mode/device_rules. servers.json is intentionally
    # NOT in a backup, so on a fresh router this stays down until the user
    # presses Start (cmd_start fetches the subscription then) — `applied`
    # tells the UI which case happened so it can prompt honestly.
    local applied=false
    if is_xray_running && cmd_restart >/dev/null 2>&1; then
        applied=true
    fi
    jq -n --argjson a "$applied" '{status:"restored", applied:$a}'
}

# ============================================================
# Per-device routing
# ============================================================

_validate_ipv4() {
    # Returns 0 if $1 is a valid dotted-quad with octets 0-255, else 1.
    local ip="$1"
    case "$ip" in *[!0-9.]*|*..*|.*|*.) return 1;; esac
    local IFS=.; set -- $ip; unset IFS
    [ $# -eq 4 ] || return 1
    for o in "$@"; do
        case "$o" in ''|*[!0-9]*) return 1;; esac
        [ "$o" -le 255 ] 2>/dev/null || return 1
    done
    return 0
}

# Accept "AA:BB:CC:DD:EE:FF" form (case-insensitive). Returns the MAC
# normalized to uppercase so config storage is consistent.
_normalize_mac() {
    local m="$1"
    case "$m" in
        [0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F])
            printf '%s' "$m" | tr 'a-f' 'A-F'
            return 0
            ;;
    esac
    return 1
}

cmd_set_device_route() {
    local id="$1" route="$2"
    [ -z "$id" ] || [ -z "$route" ] && { echo '{"error":"need id (ip or mac) and route (vpn/direct)"}'; return 1; }
    case "$route" in vpn|direct) ;; *) echo '{"error":"route must be vpn or direct"}'; return 1;; esac
    # Accept either IPv4 or MAC. MAC is preferred — survives DHCP changes.
    local mac
    if mac=$(_normalize_mac "$id"); then
        id="$mac"
    elif ! _validate_ipv4 "$id"; then
        echo '{"error":"id must be a valid IPv4 or MAC address"}'; return 1
    fi
    local tmp=$(jq --arg id "$id" --arg r "$route" \
        '.device_rules[$id] = $r' "$ECLIPVPN_CONFIG")
    save_config "$tmp"
    # Rebuild nftables if running
    if is_singbox_running; then
        local iface=$(get_config_val interface "br-lan")
        setup_network 2154 32768 "$iface"
    fi
    echo "{\"status\":\"device route set\",\"id\":\"$id\",\"route\":\"$route\"}"
}

cmd_remove_device_route() {
    local id="$1"
    [ -z "$id" ] && { echo '{"error":"need id"}'; return 1; }
    local mac
    if mac=$(_normalize_mac "$id"); then
        id="$mac"
    elif ! _validate_ipv4 "$id"; then
        echo '{"error":"id must be a valid IPv4 or MAC address"}'; return 1
    fi
    local tmp=$(jq --arg id "$id" 'del(.device_rules[$id])' "$ECLIPVPN_CONFIG")
    save_config "$tmp"
    if is_singbox_running; then
        local iface=$(get_config_val interface "br-lan")
        setup_network 2154 32768 "$iface"
    fi
    echo "{\"status\":\"device route removed\",\"id\":\"$id\"}"
}

cmd_system_info() {
    local fw_ver="" xray_ver="" sb_ver=""
    [ -f /etc/openwrt_release ] && fw_ver=$(awk -F"'" '/DISTRIB_DESCRIPTION/{print $2}' /etc/openwrt_release)
    xray_ver=$(/usr/bin/xray version 2>/dev/null | head -1 | awk '{print $2}')
    sb_ver=$(/usr/bin/sing-box version 2>/dev/null | head -1 | awk '{print $3}')
    local sys_uptime=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
    local mem_total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)
    local mem_avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)
    local load=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
    local flash_info=$(df -Pk /overlay 2>/dev/null | awk 'NR==2{print $2","$3","$4}')
    local flash_total=$(echo "$flash_info" | cut -d, -f1)
    local flash_used=$(echo "$flash_info" | cut -d, -f2)
    local flash_avail=$(echo "$flash_info" | cut -d, -f3)
    local cpu_model=$(awk -F: '/model name|Hardware/{print $2;exit}' /proc/cpuinfo 2>/dev/null | sed 's/^ //')
    local arch=$(uname -m)
    jq -n \
        --arg eclipvpn "$ECLIPVPN_VERSION" \
        --arg xray "$xray_ver" \
        --arg singbox "$sb_ver" \
        --arg openwrt "$fw_ver" \
        --arg arch "$arch" \
        --arg cpu "$cpu_model" \
        --arg load "$load" \
        --argjson sys_uptime "${sys_uptime:-0}" \
        --argjson mem_total_kb "${mem_total:-0}" \
        --argjson mem_avail_kb "${mem_avail:-0}" \
        --argjson flash_total_kb "${flash_total:-0}" \
        --argjson flash_used_kb "${flash_used:-0}" \
        --argjson flash_avail_kb "${flash_avail:-0}" \
        '{eclipvpn:$eclipvpn, xray:$xray, singbox:$singbox, openwrt:$openwrt,
          arch:$arch, cpu:$cpu, load:$load, sys_uptime:$sys_uptime,
          mem_total_kb:$mem_total_kb, mem_avail_kb:$mem_avail_kb,
          flash_total_kb:$flash_total_kb, flash_used_kb:$flash_used_kb,
          flash_avail_kb:$flash_avail_kb}'
}

cmd_healthcheck() {
    local results="[]"
    _hc() {
        local name="$1" status="$2" detail="$3"
        results=$(echo "$results" | jq --arg n "$name" --arg s "$status" --arg d "$detail" \
            '. + [{name:$n, status:$s, detail:$d}]')
    }

    # 1. Processes
    is_xray_running && _hc "xray" "ok" "PID $(cat /tmp/eclipvpn/xray.pid)" \
        || _hc "xray" "error" "Не запущен"
    is_singbox_running && _hc "sing-box" "ok" "PID $(cat /tmp/eclipvpn/singbox.pid)" \
        || _hc "sing-box" "error" "Не запущен"

    # 2. Ports
    netstat -tlnp 2>/dev/null | grep -q ":1080 " && _hc "SOCKS :1080" "ok" "xray слушает" \
        || _hc "SOCKS :1080" "error" "Порт не открыт"
    netstat -tlnp 2>/dev/null | grep -q ":2154 " && _hc "tproxy :2154" "ok" "sing-box слушает" \
        || _hc "tproxy :2154" "error" "Порт не открыт"
    netstat -ulnp 2>/dev/null | grep -q ":5354 " && _hc "DNS :5354" "ok" "sing-box DNS слушает" \
        || _hc "DNS :5354" "error" "Порт не открыт"

    # 3. nftables
    if nft list table ip eclipvpn >/dev/null 2>&1; then
        local rc=$(nft list table ip eclipvpn 2>/dev/null | grep -c "return\|tproxy\|reject")
        _hc "nftables" "ok" "$rc правил в таблице eclipvpn"
    else
        _hc "nftables" "error" "Таблица eclipvpn не найдена"
    fi

    # 4. IP rule
    ip rule list | grep -q "fwmark 0x1" && _hc "ip rule" "ok" "fwmark 0x1 → table 100" \
        || _hc "ip rule" "error" "Правило отсутствует"

    # 5. DNS
    local dns_srv=$(uci get dhcp.@dnsmasq[0].server 2>/dev/null)
    echo "$dns_srv" | grep -q "5354" && _hc "DNS redirect" "ok" "dnsmasq → $dns_srv" \
        || _hc "DNS redirect" "warn" "dnsmasq: $dns_srv"
    nslookup youtube.com 127.0.0.1 >/dev/null 2>&1 && _hc "DNS youtube.com" "ok" "Резолвится" \
        || _hc "DNS youtube.com" "error" "Не резолвится"

    # 6. VPN connection
    if is_xray_running; then
        # -4 forces IPv4 — sing-box's strategy is ipv4_only but ifconfig.me
        # serves IPv6 too via Happy Eyeballs, which produced confusing
        # AAAA records in the "VPN туннель" check.
        local vpn_ip=$(curl -4 -s --socks5-hostname 127.0.0.1:1080 --max-time 8 https://ifconfig.me 2>/dev/null)
        local home_ip=$(curl -4 -s --max-time 5 https://ifconfig.me 2>/dev/null)
        [ -n "$vpn_ip" ] && _hc "VPN туннель" "ok" "VPN IP: $vpn_ip" \
            || _hc "VPN туннель" "error" "Нет ответа"
        [ -n "$home_ip" ] && [ "$vpn_ip" != "$home_ip" ] && _hc "IP проверка" "ok" "VPN ≠ Home ($home_ip)" \
            || _hc "IP проверка" "warn" "VPN=$vpn_ip Home=$home_ip"
    fi

    # 7. Blocked sites
    for site in youtube.com instagram.com x.com; do
        local code=$(curl -s --socks5-hostname 127.0.0.1:1080 --max-time 8 -o /dev/null -w "%{http_code}" https://$site 2>/dev/null)
        case "$code" in 200|301|302) _hc "$site" "ok" "HTTP $code через VPN" ;; *) _hc "$site" "error" "HTTP $code" ;; esac
    done

    # 8. RU sites direct
    for site in yandex.ru vk.com sber.ru 2ip.ru; do
        local code=$(curl -s --max-time 5 -o /dev/null -w "%{http_code}" https://$site 2>/dev/null)
        case "$code" in 200|301|302) _hc "$site" "ok" "HTTP $code напрямую" ;; *) _hc "$site" "warn" "HTTP $code" ;; esac
    done

    # 9. Rule-sets: query live clash API (reliable after log rotation)
    local rules_json=$(curl -s --max-time 3 -H "Authorization: Bearer $(_get_clash_secret)" http://127.0.0.1:9090/rules 2>/dev/null)
    if echo "$rules_json" | grep -q "geosite-ru"; then
        _hc "geosite-ru" "ok" "Активен"
    else
        _hc "geosite-ru" "error" "Не загружен"
    fi
    if echo "$rules_json" | grep -q "geoip-ru"; then
        _hc "geoip-ru" "ok" "Активен"
    else
        _hc "geoip-ru" "error" "Не загружен"
    fi

    # IP-leak check: simulate a LAN client by going through the xray socks
    # (the same path tproxied client packets take). Cloudflare's trace
    # endpoint reports our exit IP — it must match the current VPN IP.
    # Doing this from the router directly would always see the WAN IP
    # (router itself isn't tproxied — that would cause a routing loop).
    if is_xray_running; then
        local cur_vpn_ip trace seen_ip
        cur_vpn_ip=$(cat "$ECLIPVPN_TMP/vpn_ip" 2>/dev/null)
        trace=$(curl -s --max-time 5 --socks5-hostname 127.0.0.1:1080 https://1.1.1.1/cdn-cgi/trace 2>/dev/null)
        seen_ip=$(echo "$trace" | awk -F= '/^ip=/{print $2;exit}')
        if [ -z "$seen_ip" ]; then
            _hc "IP-leak" "warn" "Не удалось проверить (нет связи через VPN)"
        elif [ -z "$cur_vpn_ip" ]; then
            # vpn_ip file may be missing right after a fresh boot before
            # cmd_start has finished writing it — not a real leak, just
            # nothing to compare to yet.
            _hc "IP-leak" "warn" "Нет сохранённого VPN IP (видно $seen_ip)"
        elif [ "$seen_ip" = "$cur_vpn_ip" ]; then
            _hc "IP-leak" "ok" "Клиенты выходят через $seen_ip (VPN)"
        else
            _hc "IP-leak" "error" "Клиенты выходят через $seen_ip — VPN IP $cur_vpn_ip не совпадает"
        fi
    fi

    # 10. Errors — count only "fresh" (last hour) and only real errors.
    # Filtered out as background noise:
    #   - "outbound/direct ... i/o timeout" — Yandex/RU sites unreachable via
    #     ISP's direct path (Lovit CGNAT). Not a VPN bug, apps retry silently.
    #   - "dns: exchange failed" — Apple push-DNS hiccups (iPhone retries).
    # What still counts as a real error: xray crashes, sing-box panics,
    # outbound/socks failures (= our VPN tunnel broke), config errors.
    local _cut=$(($(date +%s) - 3600))
    # `date -d @epoch` is GNU-only; busybox needs `-D %s -d <epoch>`. Try GNU
    # first, fall back to the busybox form so the freshness cutoff is never
    # empty (empty silently disabled the whole error count on busybox).
    local cutoff_str=$(date -u -d "@$_cut" +"%Y-%m-%d %H:%M:%S" 2>/dev/null)
    [ -z "$cutoff_str" ] && cutoff_str=$(date -u -D %s -d "$_cut" +"%Y-%m-%d %H:%M:%S" 2>/dev/null)
    local sb_err=0 xr_err=0 sb_noise=0
    if [ -n "$cutoff_str" ] && [ -f /tmp/eclipvpn/singbox.log ]; then
        local sb_counts
        sb_counts=$(grep "ERROR" /tmp/eclipvpn/singbox.log 2>/dev/null | awk -v c="$cutoff_str" '
            {
                if ($2 !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) next
                ts=$2" "$3
                if (ts < c) next
                line=$0
                if (line ~ /outbound\/direct.*i\/o timeout/ || line ~ /dns: exchange failed/) noise++
                else real++
            }
            END { print (real+0)" "(noise+0) }')
        sb_err="${sb_counts%% *}"
        sb_noise="${sb_counts##* }"
    fi
    if [ -n "$cutoff_str" ] && [ -f /tmp/eclipvpn/xray.log ]; then
        xr_err=$(grep -iE "error|fail" /tmp/eclipvpn/xray.log 2>/dev/null | awk -v c="$cutoff_str" '
            { if ($1 ~ /^[0-9]{4}\/[0-9]{2}\/[0-9]{2}$/) { gsub("/","-",$1); ts=$1" "$2; if (ts >= c) cnt++ } }
            END { print cnt+0 }')
    fi
    if [ "$sb_err" -eq 0 ] && [ "$xr_err" -eq 0 ]; then
        if [ "$sb_noise" -gt 0 ]; then
            _hc "Ошибки" "ok" "Реальных ошибок нет ($sb_noise фоновых отфильтровано)"
        else
            _hc "Ошибки" "ok" "Нет свежих ошибок (за последний час)"
        fi
    else
        _hc "Ошибки" "warn" "За последний час: sing-box: $sb_err, xray: $xr_err"
    fi

    # 11. Resources
    local free_ram=$(free | grep Mem | awk '{print int($4/1024)}')
    local free_flash=$(df /overlay 2>/dev/null | tail -1 | awk '{print int($4/1024)}')
    local cpu=$(cat /proc/loadavg | awk '{print $1}')
    [ "$free_ram" -gt 50 ] && _hc "RAM" "ok" "${free_ram}MB свободно" \
        || _hc "RAM" "warn" "${free_ram}MB свободно — мало!"
    [ "$free_flash" -gt 5 ] && _hc "Flash" "ok" "${free_flash}MB свободно" \
        || _hc "Flash" "error" "${free_flash}MB — критически мало!"
    _hc "CPU" "ok" "Load: $cpu"

    # 12. Log rotation
    local log_lines=$(wc -l < /tmp/eclipvpn/singbox.log 2>/dev/null || echo 0)
    [ "$log_lines" -lt 5000 ] && _hc "Лог" "ok" "$log_lines строк" \
        || _hc "Лог" "warn" "$log_lines строк — рекомендуется очистить"

    echo "$results" | jq '.'
}

cmd_set_wifi() {
    local ssid="$1" password="$2"
    [ -z "$password" ] && { echo '{"error":"missing password"}'; return 1; }
    # WPA2-PSK keys must be 8-63 chars. Anything shorter/longer makes hostapd
    # refuse to bring the radio up → total Wi-Fi loss, and you may be
    # administering the router over that very Wi-Fi. Reject before committing.
    local _plen=${#password}
    if [ "$_plen" -lt 8 ] || [ "$_plen" -gt 63 ]; then
        echo '{"error":"password must be 8-63 characters"}'; return 1
    fi
    uci set wireless.default_radio0.encryption="psk2"
    uci set wireless.default_radio0.key="$password"
    uci set wireless.default_radio1.encryption="psk2"
    uci set wireless.default_radio1.key="$password"
    [ -n "$ssid" ] && {
        uci set wireless.default_radio0.ssid="${ssid}_2"
        uci set wireless.default_radio1.ssid="${ssid}_5"
    }
    uci commit wireless
    wifi reload >/dev/null 2>&1 &
    echo '{"status":"wifi updated"}'
}

# ============================================================
# Init
# ============================================================

if [ ! -f "$ECLIPVPN_CONFIG" ]; then
    mkdir -p /etc/eclipvpn
    echo '{"subscription_url":"","selected_server":0,"interface":"br-lan","auto_start":true,"mode":"all_vpn"}' | jq '.' > "$ECLIPVPN_CONFIG"
    chmod 600 "$ECLIPVPN_CONFIG" 2>/dev/null
fi
# Defense in depth: tighten if a previous version left it world-readable.
[ -f "$ECLIPVPN_CONFIG" ] && chmod 600 "$ECLIPVPN_CONFIG" 2>/dev/null

case "$1" in
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart "$2" ;;
    status)         cmd_status ;;
    set-server)     cmd_set_server "$2" ;;
    probe-server)   cmd_probe_server "$2" ;;
    update)         cmd_update ;;
    ping)           cmd_ping ;;
    auto-select)    cmd_auto_select ;;
    auto-eval)      cmd_auto_eval ;;
    set-mode)       cmd_set_mode "$2" ;;
    add-domain)     cmd_add_domain "$2" "$3" ;;
    remove-domain)  cmd_remove_domain "$2" "$3" ;;
    get-domains)    cmd_get_domains ;;
    preset)         cmd_preset "$2" "$3" ;;
    get-devices)    cmd_get_devices ;;
    get-log)        cmd_get_log "$2" "$3" ;;
    clear-log)
        # Truncate the two files we own and stamp a "cleared" marker so
        # cmd_get_log can hide everything older from syslog (the syslog
        # ringbuffer is router-wide and cannot be selectively cleared).
        > "$ECLIPVPN_TMP/singbox.log"
        > "$ECLIPVPN_TMP/xray.log"
        date +%s > "$ECLIPVPN_TMP/log_cleared_ts"
        echo '{"status":"cleared"}'
        ;;
    diagnose)       cmd_diagnose ;;
    healthcheck)    cmd_healthcheck ;;
    system-info)    cmd_system_info ;;
    watchdog)       cmd_watchdog "$2" ;;
    ensure-watchdog) cmd_ensure_watchdog ;;
    get-traffic)    cmd_get_traffic ;;
    traffic-poll)   cmd_traffic_poll ;;
    reset-traffic)  cmd_reset_traffic ;;
    real-ping)      cmd_real_ping ;;
    get-incidents)  cmd_get_incidents ;;
    clear-incidents) cmd_clear_incidents ;;
    schedule)       cmd_schedule "$2" "$3" "$4" ;;
    auto-update)    cmd_auto_update "$2" ;;
    backup)         cmd_backup ;;
    restore)        cmd_restore "$2" ;;
    set-device)     cmd_set_device_route "$2" "$3" ;;
    remove-device)  cmd_remove_device_route "$2" ;;
    get-dns)        cmd_get_dns ;;
    set-config)     cmd_set_config "$2" "$3" ;;
    set-wifi)       cmd_set_wifi "$2" "$3" ;;
    *)
        echo "EclipVPN v4 — VPN for OpenWrt"
        echo "Usage: eclipvpn {start|stop|restart|status|set-server N|update|ping}"
        echo "       eclipvpn {set-mode all_vpn|blocklist}"
        echo "       eclipvpn {add-domain DOMAIN direct|vpn}"
        echo "       eclipvpn {remove-domain DOMAIN direct|vpn}"
        echo "       eclipvpn {get-domains|get-devices|get-log|get-dns}"
        echo "       eclipvpn {set-config KEY VALUE|set-wifi SSID PASSWORD}"
        ;;
esac
