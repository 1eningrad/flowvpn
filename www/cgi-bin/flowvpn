#!/bin/ash
# FlowVPN v4 — CGI API

echo "Content-Type: application/json"
echo ""

[ "$REQUEST_METHOD" = "OPTIONS" ] && exit 0

_bad() { echo "{\"error\":\"invalid $1\"}"; exit 0; }

# Full percent-decode (busybox-safe): + -> space, %XX -> the byte.
# The old four-token sed only handled %2F/%3A/%20/+, so subscription URLs
# carrying ?, &, =, # (encodeURIComponent output) reached set-config
# corrupted and silently failed to fetch. Validators run AFTER this, so the
# whitelists still gate the final decoded bytes.
_urldec() {
    printf '%b' "$(printf '%s' "$1" | sed -e 's/+/ /g' -e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}

# Parse query string
action="" index="" mode="" domain="" list="" key="" value="" lines="" filter=""
on_time="" off_time="" ip_addr="" route="" op="" preset_name="" force=""
IFS='&'
for pair in $QUERY_STRING; do
    k="${pair%%=*}"; v="${pair#*=}"
    v=$(_urldec "$v")
    case "$k" in
        action) action="$v" ;; index) index="$v" ;; mode) mode="$v" ;;
        domain) domain="$v" ;; list) list="$v" ;; key) key="$v" ;; value) value="$v" ;;
        lines) lines="$v" ;; filter) filter="$v" ;;
        on) on_time="$v" ;; off) off_time="$v" ;;
        ip) ip_addr="$v" ;; route) route="$v" ;;
        op) op="$v" ;; name) preset_name="$v" ;;
        force) force="$v" ;;
    esac
done
unset IFS

# Validate parameters at the boundary (only those used in shell args / numeric tests)
[ -n "$action" ]   && case "$action"   in *[!a-z-]*)                  _bad action;; esac
[ -n "$index" ]    && case "$index"    in ''|*[!0-9]*)                 _bad index;;  esac
[ -n "$lines" ]    && case "$lines"    in *[!0-9]*)                    _bad lines;;  esac
[ -n "$mode" ]     && case "$mode"     in *[!a-zA-Z0-9_-]*)            _bad mode;;   esac
[ -n "$list" ]     && case "$list"     in direct|vpn) ;; *)            _bad list;;   esac
[ -n "$route" ]    && case "$route"    in vpn|direct) ;; *)            _bad route;;  esac
[ -n "$filter" ]   && case "$filter"   in *[!a-zA-Z]*)                 _bad filter;; esac
[ -n "$key" ]      && case "$key"      in *[!a-zA-Z0-9_]*)             _bad key;;    esac
[ -n "$domain" ]   && case "$domain"   in .*|*..*|*/*/*|*[!a-zA-Z0-9.*/_-]*) _bad domain;; esac
[ -n "$op" ]       && case "$op"       in list|enable|disable) ;; *)   _bad op;;     esac
[ -n "$preset_name" ] && case "$preset_name" in *[!a-z]*)              _bad name;;   esac
[ -n "$force" ]    && case "$force"    in 0|1) ;; *)                   _bad force;;  esac
[ -n "$on_time" ]  && case "$on_time"  in [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;; *) _bad on;;  esac
[ -n "$off_time" ] && case "$off_time" in [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;; *) _bad off;; esac
[ -n "$ip_addr" ]  && case "$ip_addr"  in
    # IPv4 dotted-quad (digits + dots only)
    [0-9]*.[0-9]*.[0-9]*.[0-9]*) case "$ip_addr" in *[!0-9.]*) _bad ip;; esac ;;
    # MAC address — six pairs of hex separated by colons
    [0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]) ;;
    *) _bad ip ;;
esac

# Read POST body, capped at 64KB to prevent OOM via huge requests
body=""
[ "$REQUEST_METHOD" = "POST" ] && body=$(head -c 65536)

case "$action" in
    status)         /usr/bin/flowvpn status ;;
    start)          /usr/bin/flowvpn start ;;
    stop)           /usr/bin/flowvpn stop ;;
    restart)        /usr/bin/flowvpn restart "$force" ;;
    update)         /usr/bin/flowvpn update ;;
    set-server)     /usr/bin/flowvpn set-server "$index" ;;
    probe-server)   /usr/bin/flowvpn probe-server "$index" ;;
    ping)           /usr/bin/flowvpn ping ;;
    auto-select)    /usr/bin/flowvpn auto-select ;;
    set-mode)       /usr/bin/flowvpn set-mode "$mode" ;;
    add-domain)     /usr/bin/flowvpn add-domain "$domain" "$list" ;;
    remove-domain)  /usr/bin/flowvpn remove-domain "$domain" "$list" ;;
    get-domains)    /usr/bin/flowvpn get-domains ;;
    preset)         /usr/bin/flowvpn preset "${op:-list}" "$preset_name" ;;
    get-devices)    /usr/bin/flowvpn get-devices ;;
    get-log)        /usr/bin/flowvpn get-log "${lines:-100}" "${filter:-all}" ;;
    clear-log)      /usr/bin/flowvpn clear-log ;;
    diagnose)       /usr/bin/flowvpn diagnose ;;
    healthcheck)    /usr/bin/flowvpn healthcheck ;;
    system-info)    /usr/bin/flowvpn system-info ;;
    get-traffic)    /usr/bin/flowvpn get-traffic ;;
    traffic-poll)   /usr/bin/flowvpn traffic-poll ;;
    reset-traffic)  /usr/bin/flowvpn reset-traffic ;;
    real-ping)      /usr/bin/flowvpn real-ping ;;
    get-incidents)  /usr/bin/flowvpn get-incidents ;;
    clear-incidents) /usr/bin/flowvpn clear-incidents ;;
    set-config)
        if [ -n "$key" ]; then
            /usr/bin/flowvpn set-config "$key" "$value"
        elif [ -n "$body" ]; then
            local_key=$(printf '%s' "$body" | jq -r '.key // empty' 2>/dev/null)
            local_val=$(printf '%s' "$body" | jq -r '.value // empty' 2>/dev/null)
            case "$local_key" in *[!a-zA-Z0-9_]*) _bad key;; esac
            /usr/bin/flowvpn set-config "$local_key" "$local_val"
        else
            echo '{"error":"missing key/value"}'
        fi
        ;;
    schedule)
        if [ -n "$on_time" ]; then
            /usr/bin/flowvpn schedule set "$on_time" "$off_time"
        elif [ "$mode" = "disable" ]; then
            /usr/bin/flowvpn schedule disable
        else
            /usr/bin/flowvpn schedule get
        fi
        ;;
    auto-update)    /usr/bin/flowvpn auto-update "$mode" ;;
    backup)         /usr/bin/flowvpn backup ;;
    restore)
        # Pipe body via stdin to avoid argv injection / argv length limits
        if [ -n "$body" ]; then
            printf '%s' "$body" | /usr/bin/flowvpn restore
        else
            echo '{"error":"no data"}'
        fi
        ;;
    set-device)     /usr/bin/flowvpn set-device "$ip_addr" "$route" ;;
    remove-device-route) /usr/bin/flowvpn remove-device "$ip_addr" ;;
    *)              echo '{"error":"unknown action"}' ;;
esac
