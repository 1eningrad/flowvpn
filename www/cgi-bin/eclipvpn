#!/bin/ash
# EclipVPN v4 — CGI API

echo "Content-Type: application/json"
echo ""

[ "$REQUEST_METHOD" = "OPTIONS" ] && exit 0

_bad() { echo "{\"error\":\"invalid $1\"}"; exit 0; }

# Full percent-decode (busybox-safe): + -> space, %XX -> the byte.
# The old four-token sed only handled %2F/%3A/%20/+, so subscription URLs
# carrying ?, &, =, # (encodeURIComponent output) reached set-config
# corrupted and silently failed to fetch. Validators run AFTER this, so the
# whitelists still gate the final decoded bytes.
_urldec() {
    printf '%b' "$(printf '%s' "$1" | sed -e 's/+/ /g' -e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}

# Parse query string
action="" index="" mode="" domain="" list="" key="" value="" lines="" filter=""
on_time="" off_time="" ip_addr="" route="" op="" preset_name="" force="" sub_id=""
IFS='&'
for pair in $QUERY_STRING; do
    k="${pair%%=*}"; v="${pair#*=}"
    v=$(_urldec "$v")
    case "$k" in
        action) action="$v" ;; index) index="$v" ;; mode) mode="$v" ;;
        domain) domain="$v" ;; list) list="$v" ;; key) key="$v" ;; value) value="$v" ;;
        lines) lines="$v" ;; filter) filter="$v" ;;
        on) on_time="$v" ;; off) off_time="$v" ;;
        ip) ip_addr="$v" ;; route) route="$v" ;;
        op) op="$v" ;; name) preset_name="$v" ;;
        force) force="$v" ;; id) sub_id="$v" ;;
    esac
done
unset IFS

# Validate parameters at the boundary (only those used in shell args / numeric tests)
[ -n "$action" ]   && case "$action"   in *[!a-z-]*)                  _bad action;; esac
[ -n "$index" ]    && case "$index"    in ''|*[!0-9]*)                 _bad index;;  esac
[ -n "$lines" ]    && case "$lines"    in *[!0-9]*)                    _bad lines;;  esac
[ -n "$mode" ]     && case "$mode"     in *[!a-zA-Z0-9_-]*)            _bad mode;;   esac
[ -n "$list" ]     && case "$list"     in direct|vpn) ;; *)            _bad list;;   esac
[ -n "$route" ]    && case "$route"    in vpn|direct) ;; *)            _bad route;;  esac
[ -n "$filter" ]   && case "$filter"   in *[!a-zA-Z]*)                 _bad filter;; esac
[ -n "$key" ]      && case "$key"      in *[!a-zA-Z0-9_]*)             _bad key;;    esac
[ -n "$domain" ]   && case "$domain"   in .*|*..*|*/*/*|*[!a-zA-Z0-9.*/_-]*) _bad domain;; esac
[ -n "$op" ]       && case "$op"       in list|enable|disable|add|remove|rename) ;; *) _bad op;; esac
[ -n "$preset_name" ] && case "$preset_name" in *[!a-z]*)              _bad name;;   esac
[ -n "$sub_id" ]   && case "$sub_id"   in *[!a-f0-9]*)                 _bad id;;     esac
[ -n "$force" ]    && case "$force"    in 0|1) ;; *)                   _bad force;;  esac
[ -n "$on_time" ]  && case "$on_time"  in [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;; *) _bad on;;  esac
[ -n "$off_time" ] && case "$off_time" in [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;; *) _bad off;; esac
[ -n "$ip_addr" ]  && case "$ip_addr"  in
    # IPv4 dotted-quad (digits + dots only)
    [0-9]*.[0-9]*.[0-9]*.[0-9]*) case "$ip_addr" in *[!0-9.]*) _bad ip;; esac ;;
    # MAC address — six pairs of hex separated by colons
    [0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]) ;;
    *) _bad ip ;;
esac

# --- Anti-CSRF / anti-DNS-rebinding -----------------------------------
# The threat model trusts the LAN, but NOT a malicious web page the user
# opens while on the LAN (drive-by CSRF) nor a DNS-rebound origin that maps
# its own hostname onto the router IP. Without this, a single cross-site GET
# like ?action=set-config&key=subscription_url&value=//evil silently repoints
# the subscription at attacker-controlled servers — full traffic MITM.
#
# 1. Host allow-list — a rebound attacker.com carries its own Host header.
#    Accept only IP literals / loopback / bare-hostname / *.lan; reject any
#    dotted name containing letters (i.e. a real public domain).
_host_np="$HTTP_HOST"
case "$_host_np" in
    \[*\]*) ;;                                  # IPv6 literal — leave as-is
    *:*) _host_np="${_host_np%:*}" ;;           # strip :port for IPv4/hostname
esac
case "$_host_np" in
    \[*\]) ;;                                    # IPv6 literal
    localhost|*.lan) ;;                          # loopback / mDNS LAN name
    *.*)                                         # dotted: IPv4 ok, domain reject
        case "$_host_np" in
            *[!0-9.]*) echo '{"error":"forbidden: host not allowed"}'; exit 0 ;;
        esac ;;
    *) ;;                                        # bare hostname (no dot) — ok
esac
# 2. State-changing actions must prove they came from our own page. uhttpd
#    only exposes a fixed header allow-list to CGI (Accept/Host/Origin/Referer/
#    User-Agent — custom headers like X-Requested-With are dropped), so the
#    check rides on Origin/Referer: a mutating request MUST carry one and its
#    host must equal our Host. Our UI's same-origin fetch always sends a
#    same-host Referer (no `no-referrer` policy is set); a cross-site fetch
#    sends a foreign Origin; a cross-site <img>/<form> sends a foreign Referer
#    or, under a no-referrer policy, none at all — all rejected. Read-only
#    actions are exempt so plain curl/monitoring still works (their responses
#    aren't readable cross-site, so reading them via CSRF gains nothing).
case "$action" in
    status|ping|real-ping|healthcheck|diagnose|system-info|backup|traffic-poll|net-check|get-*) ;;
    *)
        _src="${HTTP_ORIGIN:-$HTTP_REFERER}"
        [ -z "$_src" ] && { echo '{"error":"forbidden: missing Origin/Referer"}'; exit 0; }
        _src="${_src#*://}"; _src="${_src%%/*}"
        [ "$_src" = "$HTTP_HOST" ] || { echo '{"error":"forbidden: cross-site request blocked"}'; exit 0; }
        ;;
esac

# Read POST body, capped at 64KB to prevent OOM via huge requests
body=""
[ "$REQUEST_METHOD" = "POST" ] && body=$(head -c 65536)

case "$action" in
    status)         /usr/bin/eclipvpn status ;;
    start)          /usr/bin/eclipvpn start ;;
    stop)           /usr/bin/eclipvpn stop ;;
    restart)        /usr/bin/eclipvpn restart "$force" ;;
    update)         /usr/bin/eclipvpn update ;;
    set-server)     /usr/bin/eclipvpn set-server "$index" ;;
    probe-server)   /usr/bin/eclipvpn probe-server "$index" ;;
    # Mutating — deliberately NOT in the read-only exempt arm of the
    # Origin/Referer gate above.
    mute-server)    /usr/bin/eclipvpn mute-server "$index" ;;
    unmute-server)  /usr/bin/eclipvpn unmute-server "$index" ;;
    sub)
        # Multi-subscription manager. Free-text url/name come via the POST body
        # (JSON) — not argv/query — so a subscription token can't leak through a
        # process listing or be mangled by argv parsing. id is query (hex-gated).
        case "$op" in
            list)             /usr/bin/eclipvpn sub list ;;
            enable|disable)   /usr/bin/eclipvpn sub "$op" "$sub_id" ;;
            remove)           /usr/bin/eclipvpn sub remove "$sub_id" ;;
            add)
                if [ -n "$body" ]; then
                    b_url=$(printf '%s' "$body" | jq -r '.url // empty' 2>/dev/null)
                    b_name=$(printf '%s' "$body" | jq -r '.name // empty' 2>/dev/null)
                    /usr/bin/eclipvpn sub add "$b_url" "$b_name"
                else echo '{"error":"no data"}'; fi
                ;;
            rename)
                if [ -n "$body" ]; then
                    b_name=$(printf '%s' "$body" | jq -r '.name // empty' 2>/dev/null)
                    /usr/bin/eclipvpn sub rename "$sub_id" "$b_name"
                else echo '{"error":"no data"}'; fi
                ;;
            *) echo '{"error":"unknown sub op"}' ;;
        esac
        ;;
    ping)           /usr/bin/eclipvpn ping ;;
    auto-select)    /usr/bin/eclipvpn auto-select ;;
    set-mode)       /usr/bin/eclipvpn set-mode "$mode" ;;
    add-domain)     /usr/bin/eclipvpn add-domain "$domain" "$list" ;;
    remove-domain)  /usr/bin/eclipvpn remove-domain "$domain" "$list" ;;
    get-domains)    /usr/bin/eclipvpn get-domains ;;
    preset)         /usr/bin/eclipvpn preset "${op:-list}" "$preset_name" ;;
    get-devices)    /usr/bin/eclipvpn get-devices ;;
    get-log)        /usr/bin/eclipvpn get-log "${lines:-100}" "${filter:-all}" ;;
    clear-log)      /usr/bin/eclipvpn clear-log ;;
    diagnose)       /usr/bin/eclipvpn diagnose ;;
    healthcheck)    /usr/bin/eclipvpn healthcheck ;;
    net-check)      /usr/bin/eclipvpn net-check ;;
    system-info)    /usr/bin/eclipvpn system-info ;;
    get-traffic)    /usr/bin/eclipvpn get-traffic ;;
    traffic-poll)   /usr/bin/eclipvpn traffic-poll ;;
    reset-traffic)  /usr/bin/eclipvpn reset-traffic ;;
    real-ping)      /usr/bin/eclipvpn real-ping ;;
    get-incidents)  /usr/bin/eclipvpn get-incidents ;;
    clear-incidents) /usr/bin/eclipvpn clear-incidents ;;
    set-config)
        if [ -n "$key" ]; then
            /usr/bin/eclipvpn set-config "$key" "$value"
        elif [ -n "$body" ]; then
            local_key=$(printf '%s' "$body" | jq -r '.key // empty' 2>/dev/null)
            local_val=$(printf '%s' "$body" | jq -r '.value // empty' 2>/dev/null)
            case "$local_key" in *[!a-zA-Z0-9_]*) _bad key;; esac
            /usr/bin/eclipvpn set-config "$local_key" "$local_val"
        else
            echo '{"error":"missing key/value"}'
        fi
        ;;
    schedule)
        if [ -n "$on_time" ]; then
            /usr/bin/eclipvpn schedule set "$on_time" "$off_time"
        elif [ "$mode" = "disable" ]; then
            /usr/bin/eclipvpn schedule disable
        else
            /usr/bin/eclipvpn schedule get
        fi
        ;;
    auto-update)    /usr/bin/eclipvpn auto-update "$mode" ;;
    backup)         /usr/bin/eclipvpn backup ;;
    restore)
        # Pipe body via stdin to avoid argv injection / argv length limits
        if [ -n "$body" ]; then
            printf '%s' "$body" | /usr/bin/eclipvpn restore
        else
            echo '{"error":"no data"}'
        fi
        ;;
    set-device)     /usr/bin/eclipvpn set-device "$ip_addr" "$route" ;;
    remove-device-route) /usr/bin/eclipvpn remove-device "$ip_addr" ;;
    *)              echo '{"error":"unknown action"}' ;;
esac
