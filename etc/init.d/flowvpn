#!/bin/sh /etc/rc.common

START=99
STOP=10

start() {
    local auto_start
    auto_start=$(jq -r '.auto_start // true' /etc/flowvpn/config.json 2>/dev/null)
    [ "$auto_start" != "true" ] && return 0

    local tries=0
    while [ "$tries" -lt 30 ]; do
        if ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; then break; fi
        sleep 1; tries=$((tries + 1))
    done

    if ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
        /usr/bin/flowvpn start >/dev/null 2>&1 &
        # Spawn watchdog immediately and record its PID without a delay window —
        # otherwise stop() called within ~10s leaves an orphan watchdog that
        # restarts the VPN after stop() has finished.
        # Watchdog's own loop begins with `sleep $interval`, so xray/sing-box
        # have time to come up before the first probe.
        mkdir -p /tmp/flowvpn
        /usr/bin/flowvpn watchdog >/dev/null 2>&1 &
        echo $! > /tmp/flowvpn/watchdog.pid
    else
        logger -t flowvpn "Network not ready, skipping autostart"
    fi
}

stop() {
    # Stop watchdog (try both pidfiles — init.d's and the one watchdog owns)
    for f in /tmp/flowvpn/watchdog.pid /tmp/flowvpn/watchdog.lock; do
        [ -f "$f" ] && {
            kill $(cat "$f") 2>/dev/null
            rm -f "$f"
        }
    done
    /usr/bin/flowvpn stop >/dev/null 2>&1
}

restart() {
    stop; sleep 1; start
}
