#!/bin/sh /etc/rc.common

START=99
STOP=10

start() {
    local auto_start
    # `.auto_start // true` looks correct but jq's // operator treats `false`
    # as falsy and returns the alternative — so an explicit `false` from
    # the UI toggle was being silently overridden to `true`. The explicit
    # if-else handles all three cases (true / false / missing→default true).
    auto_start=$(jq -r '.auto_start | if . == false then "false" else "true" end' /etc/eclipvpn/config.json 2>/dev/null)
    [ "$auto_start" = "false" ] && return 0

    # Wait up to 60s for WAN. Bumped from 30s after observing slow CGNAT
    # providers (SevenSky and similar) where DHCP lease + initial CGN
    # NAT-table entry took 35-45s. At 30s init script was occasionally
    # giving up and leaving the LAN with no VPN until manual intervention.
    local tries=0
    while [ "$tries" -lt 60 ]; do
        if ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; then break; fi
        sleep 1; tries=$((tries + 1))
    done

    if ! ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
        logger -t eclipvpn "Network not ready after 60s, skipping autostart"
        return 0
    fi

    # Wait for NTP-driven clock sync before letting xray dial out. Reality
    # handshake performs TLS-style cert-time validation; if the router
    # still has its 1970-01-01 default clock, every initial connect fails
    # the cert window and watchdog burns its first failover budget for no
    # reason. Cap at 20s so a broken NTP doesn't block boot forever —
    # watchdog will recover anyway, this is just an optimization.
    local ntp_tries=0
    while [ "$ntp_tries" -lt 20 ]; do
        [ "$(date +%Y)" -ge 2025 ] 2>/dev/null && break
        sleep 1; ntp_tries=$((ntp_tries + 1))
    done
    if ! [ "$(date +%Y)" -ge 2025 ] 2>/dev/null; then
        logger -t eclipvpn "Clock not synced after 20s, starting anyway — watchdog will retry on Reality failure"
    fi

    # cmd_start now spawns the watchdog itself via _ensure_watchdog —
    # spawning it again here would race on watchdog.lock and leave the
    # locking semantics half-broken (lock owned by one process, pidfile
    # pointing at a different one).
    /usr/bin/eclipvpn start >/dev/null 2>&1 &
}

stop() {
    # Stop watchdog (try both pidfiles — init.d's and the one watchdog owns).
    # Verify the PID's cmdline before killing: the watchdog's exit trap only
    # removes its lockdir, so these files routinely go stale, and a recycled
    # PID would mean killing an unrelated process.
    # watchdog.lockdir/owner is the authoritative PID (the two flat files
    # are legacy mirrors) — include it so the real watchdog always gets the
    # signal even when the mirrors are stale.
    local f pid
    for f in /tmp/eclipvpn/watchdog.pid /tmp/eclipvpn/watchdog.lock \
             /tmp/eclipvpn/watchdog.lockdir/owner; do
        [ -f "$f" ] || continue
        pid=$(cat "$f" 2>/dev/null)
        if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ]; then
            case $(tr "\0" " " < "/proc/$pid/cmdline") in
                *"/usr/bin/eclipvpn watchdog"*) kill "$pid" 2>/dev/null ;;
            esac
        fi
        rm -f "$f"
    done
    /usr/bin/eclipvpn stop >/dev/null 2>&1
}

restart() {
    stop; sleep 1; start
}
